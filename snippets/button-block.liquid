{%- doc -%}
  Renders a standard button block.

  @param {object} link - The button link.
  @param {boolean} [allow_linkless] - Whether the button needs a link.
  @param {string} label - The button label.
  @param {string} [button_attributes] - Any attrributes to be added to the container.
  @param {string} button_style - The button style (ie. 'btn--primary', 'btn--secondary', or 'btn--callout').
  @param {string} button_size_class - The button size class (ie. 'btn--large').
  @param {string} [type] - The button type (ie. 'button', or 'submit').
  @param {boolean} [is_full] - Whether the button is full-width.
  @param {boolean} [is_small] - Whether the button size is 'small'.
  @param {boolean} [is_x_small] - Whether the button size is 'x-small'.
  @param {string} button_alignment - The horizontal alignment of the button.
  @param {string} [button_alignment_mobile] - The horizontal alignment of the button on mobile.
  @param {string} [break_to_mobile_at] - A number (represented as a string) that notes the screen width pixel value where we should break to mobile.
  @param {boolean} buttons_can_inline - Whether multiple buttons (blocks) can display inline.
  @param {object} forloop - The current block loop. Allows us to detect whether the previous or next blocks are button blocks.
  @param {string} [wrapper_class] - A class to be applied to the image container.
  @param {string} shopify_attributes - Block attributes from 'block.shopify_attributes'.
{%- enddoc -%}

{%- liquid
  assign allow_linkless = allow_linkless | default: false, allow_false: true
  assign button_style = button_style | default: 'btn--primary'
  assign type = type | default: 'button'
  assign is_full = is_full | default: false, allow_false: true
  assign is_small = is_small | default: false, allow_false: true
  assign is_x_small = is_x_small | default: false, allow_false: true
  assign button_alignment_mobile = button_alignment_mobile | default: button_alignment
  assign break_to_mobile_at = break_to_mobile_at | default: '720'

  assign prev_index = null
  assign next_index = null
-%}

{%- unless label == blank -%}
  {%- if buttons_can_inline -%}
    {%- liquid
      assign prev_index = forloop.index0 | minus: 1
      assign next_index = forloop.index0 | plus: 1
    -%}

    {%- if section.blocks[next_index].type == 'button' -%}
      <div
        class="
          button-block__inline-wrapper
          button-block__inline-wrapper--break-to-mobile-at-{{ break_to_mobile_at }}
          button-block__inline-wrapper--justify-{{ button_alignment }}
          button-block__inline-wrapper--justify-mobile-{{ button_alignment_mobile }}
          section-blocks__inline-buttons
        "
      >
    {%- endif -%}
  {%- endif -%}

  <div
    class="
      button-block__button
      button-block__button--break-to-mobile-at-{{ break_to_mobile_at }}
      button-block__button--justify-{{ button_alignment }}
      button-block__button--justify-mobile-{{ button_alignment_mobile }}
      {{ wrapper_class }}
    "
    {{ shopify_attributes }}
  >
    {%- liquid
      capture button_tag
        if link == blank
          echo 'button'
        else
          echo 'a'
        endif
      endcapture

      capture button_class
        echo 'btn'

        if button_style != 'btn--callout' and button_size_class != blank
          echo ' '
          echo button_size_class
        endif

        if button_style != 'btn--callout' and is_full
          echo ' btn--full'
        endif

        if is_x_small
          echo ' btn--x-small'
        endif

        if is_small
          echo ' btn--small'
        endif

        echo ' '
        echo button_style
      endcapture

      capture button_attributes
        echo button_attributes

        if link == blank
          echo ' type="[[type]]"' | replace: '[[type]]', type

          unless allow_linkless
            assign flash_message = 'general.flash_alert.no_link' | t
            echo ' data-flash-trigger'
            echo ' data-flash-message="[[fm]]"' | replace: '[[fm]]', flash_message
          endunless
        else
          echo ' href="[[link]]"' | replace: '[[link]]', link
        endif
      endcapture
    -%}

    <{{ button_tag }}
      class="{{ button_class }}"
      {{ button_attributes | strip }}
    >
      <span>{{ label }}</span>
    </{{ button_tag }}>
  </div>

  {%- if buttons_can_inline and prev_index > -1 and section.blocks[prev_index].type == 'button' -%}
    </div>
  {%- endif -%}
{%- endunless -%}
