{%- doc -%}
  Renders the featured products product block (ie. "Complementary products").

  @param {object} prod - The product object. We use 'prod' to avoid collision with the global 'product' object.
  @param {object} block - The block object.
  @param {string} custom_color_key_map - A list of custom color names for swatches.
  @param {string} custom_color_value_map - A list of custom color values for swatches.
{%- enddoc -%}

{%- liquid
  assign max_products = block.settings.max_products

  if block.settings.product_source == 'custom-product-list' and block.settings.product_list.count > 0
    assign should_render_content = true
  elsif block.settings.product_source == 'app-recommendations'
    assign should_render_content = true
  else
    assign should_render_content = false
  endif
-%}

{%- if should_render_content -%}
  {%- liquid
    capture product_grid_classes
      echo 'product__block-featured-products-grid'

      if block.settings.enable_swiper_mobile
        echo ' product__block-featured-products-grid--has-mobile-swipe'
      else
        echo ' product__block-featured-products-grid--has-mobile-grid'
      endif

      if block.settings.display_as_collapsible_row
        echo ' product__block-featured-products-grid--is-collapsible-row'
      endif

      echo ' carousel__wrapper swiper-wrapper'
    endcapture
  -%}

  {%- capture product_list_products -%}
    <div class="{{ product_grid_classes }}">
      {%- for product_item in block.settings.product_list limit: max_products -%}
        <div class="carousel__slide swiper-slide" data-slide>
          {%- render 'product-item'
            prod: product_item,
            aspect_ratio: settings.product_listing_aspect_ratio,
            quick_view_is_beneath: true,
            custom_color_key_map: custom_color_key_map,
            custom_color_value_map: custom_color_value_map
          -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endcapture -%}

  {%- capture app_recommended_products -%}
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div data-featured-products-content>
        <div class="{{ product_grid_classes }}">
          {%- if recommendations.products_count > 0 -%}
            {%- for product_item in recommendations.products -%}
              <div class="carousel__slide swiper-slide" data-slide>
                {%- render 'product-item'
                  prod: product_item,
                  aspect_ratio: settings.product_listing_aspect_ratio,
                  quick_view_is_beneath: true,
                  custom_color_key_map: custom_color_key_map,
                  custom_color_value_map: custom_color_value_map
                -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture content -%}
    <div
      class="carousel swiper"
      data-featured-products
      data-product-id="{{ prod.id }}"
      data-section-id="{{ section.id }}"
      data-recommendations-type="{{ block.settings.product_source }}"
      data-max-recommendations="{{ max_products }}"
      data-enable-mobile-swiper="{{ block.settings.enable_swiper_mobile }}"
    >
      {%- liquid
        if block.settings.product_source == 'custom-product-list'
          echo product_list_products
        else
          echo app_recommended_products
        endif
      -%}
    </div>
  {% endcapture %}

  {%- if block.settings.display_as_collapsible_row -%}
    {%- render 'product-block-accordion',
      block: block,
      heading: block.settings.heading,
      content: content,
      classes: 'product__block-featured-products',
      disable_rte: true,
      label_font: block.settings.heading_font_choice,
      label_size: block.settings.heading_font_class
    -%}
  {%- else -%}
    <div
      class="product__block product__block-featured-products{% if block.settings.product_source == 'app-recommendations' %} hidden{% endif %} product__block--medium"
      {{ block.shopify_attributes }}
    >
      {%- unless block.settings.heading == blank -%}
        <{{ block.settings.heading_tag }} class="product__block-featured-products__heading {{ block.settings.heading_font_choice }} {{ block.settings.heading_font_class }}">
          {{ block.settings.heading }}
        </{{ block.settings.heading_tag }}>
      {%- endunless -%}

      {{- content -}}
    </div>
  {%- endif -%}
{%- endif -%}
