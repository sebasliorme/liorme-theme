{%- doc -%}
  Renders a blog article item.

  @param {object} blog - The parent blog of the article.
  @param {object} article - The article object.
  @param {boolean} [show_featured_image] - Whether to show the article's featured image.
  @param {string} aspect_ratio - The aspect ratio of the featured image.
  @param {boolean} show_author - Whether to show the article's author
  @param {boolean} show_date - Whether to show the article's published date.
  @param {boolean} show_tags - Whether to show the article's tags.
  @param {boolean} show_excerpt - Whether to show the article's excerpt.
{%- enddoc -%}

{%- liquid
  echo 'template-article.css' | asset_url | stylesheet_tag

  assign show_featured_image = show_featured_image | default: false, allow_false: true
  assign show_author = show_author | default: false, allow_false: true
  assign show_date = show_date | default: false, allow_false: true
  assign show_tags = show_tags | default: false, allow_false: true
  assign show_excerpt = show_excerpt | default: false, allow_false: true

  if blog
    assign tag_el = 'a'
  else
    assign tag_el = 'span'
  endif

  assign article_categories = settings.article_categories | downcase
-%}

{%- capture tag_list_items -%}
  {%- if show_tags and article.tags.size > 0 -%}
    {%- for tag in article.tags -%}
      {%- assign downcased_tag = tag | downcase -%}

      {%- if article_categories contains downcased_tag or article_categories == blank -%}
        <li class="article-tags__item">
          <{{ tag_el }}
            {%- if blog -%}
              href="{{ blog.url }}/tagged/{{ tag | handleize }}"
            {%- endif -%}
            class="article-tags__tag fs-body-50"
          >
            {{ tag }}
          </{{ tag_el }}>
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div
  class="
    article-item
    {% if article != blank and article.image == blank or show_featured_image != true -%}article-item--has-no-image{%- endif %}
    animation--article-item
    hover
  "
  data-image="{{ show_featured_image }}"
>
  {%- if article != blank -%}
    {%- if show_featured_image and article.image -%}
      {%- liquid
        capture image_sizes
          echo '(min-width: 720px) calc(calc(50vw - calc(2 * clamp(18px, 3.3vw, 3.3vw)))), calc(100vw - calc(2 * 3.3vw))'
        endcapture
      -%}

      <a
        href="{{ article.url }}"
        class="article-item__image-wrapper"
        aria-label="{{ article.title }}"
      >
        {%- render 'image',
          wrapper_class: 'article-item__image',
          image: article.image,
          sizes: image_sizes,
          aspect_ratio: aspect_ratio,
          animate: true
        -%}
      </a>
    {%- endif -%}

    <div class="article-item__content">
      <div class="article-item__content-inner">
        {%- if tag_list_items != blank -%}
          <div class="article-item__tags">
            <ul class="article-tags">
              {{ tag_list_items }}
            </ul>
          </div>
        {%- endif -%}

        <h4 class="article-item__title ff-heading fs-heading-4-base">
          <a href="{{ article.url }}">{{ article.title }}</a>
        </h4>

        {%- if show_author or show_date -%}
          <p class="article-item__meta fs-body-75">
            {%- if show_author -%}
              <span>
                {{- 'blogs.article.by' | t }}
                {{ article.author -}}
              </span>
            {%- endif -%}

            {%- if show_date -%}
              {{- article.published_at | time_tag: format: 'abbreviated_date' -}}
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if show_excerpt and article.excerpt_or_content -%}
          {%- assign excerpt_truncate_amount = 30 -%}

          <div class="article-item__excerpt">
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: excerpt_truncate_amount }}</p>
          </div>
        {%- endif -%}

        {%- assign button_label = 'blogs.article.read' | t -%}

        {%- render 'button-block',
          wrapper_class: 'article-item__read-button',
          link: article.url,
          label: button_label,
          button_style: 'btn--callout'
        -%}
      </div>
    </div>
  {%- else -%}
    <div class="article-item__image-wrapper">
      {%- render 'image',
        wrapper_class: 'article-item__image',
        sizes: image_sizes,
        aspect_ratio: aspect_ratio,
        include_placeholder: true
      -%}
    </div>

    <div class="article-item__content">
      <div class="article-item__content-inner">
        <h4 class="article-item__title ff-heading fs-heading-5-base">{{ 'homepage.onboarding.blog_title' | t }}</h4>

        <p class="article-item__meta fs-body-75">
          <span>
            {{- 'blogs.article.by' | t }}
            {{ 'homepage.onboarding.article_author' | t -}}
          </span>

          {{- 'now' | time_tag: format: 'abbreviated_date' -}}
        </p>

        <div class="article-item__excerpt">{{ 'homepage.onboarding.article_excerpt' | t }}</div>
      </div>
    </div>
  {%- endif -%}
</div>
