{%- doc -%}
  The look of a mosaic slide (tile): photo, colour panel, tag, title, text and "Shop" link, as raw CSS (no <style>
  tags) to put inside the <style> of a section. The "Mosaico de slides" section and the "Grid editorial" section
  (its "Slide de mosaico" block, a tile that sits among the product cards) share it, so a slide looks the same in both.
  The layout of the tile in its grid (columns, rows, order) is up to each section.

  @param {string} scope - The section's selector prefix, e.g. "#shopify-section-template--123__mosaic".
{%- enddoc -%}
{{ scope }} .collection-mosaic__tile {
  position: relative;
  overflow: hidden;
  background: #e9e6df;
}

{{ scope }} .collection-mosaic__link {
  position: absolute;
  inset: 0;
  z-index: 3;
}

{{ scope }} .collection-mosaic__link:focus-visible {
  outline: 2px solid #111111;
  outline-offset: -2px;
}

/* the picture always fills its slide */
{{ scope }} .collection-mosaic__media,
{{ scope }} .collection-mosaic__media .image,
{{ scope }} .collection-mosaic__media .placeholder-svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

{{ scope }} .collection-mosaic__media .image > * {
  -o-object-fit: cover;
     object-fit: cover;
  -o-object-position: var(--mosaic-position, center);
     object-position: var(--mosaic-position, center);
  width: 100%;
  height: 100%;
}

{{ scope }} .collection-mosaic__media--mobile {
  display: none;
}

/* the small tag: same look as the product card label */
{{ scope }} .collection-mosaic__label {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 2;
  font-size: 10px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #111111;
  pointer-events: none;
}

{{ scope }} .collection-mosaic__label--light {
  color: #ffffff;
}

/* text block: title 20/24 bold + text 14 + underlined link 14/16 (the reference's sizes) */
{{ scope }} .collection-mosaic__text {
  position: absolute;
  right: 0;
  left: 0;
  z-index: 2;
  padding: 12px;
  color: var(--mosaic-text, #ffffff);
  pointer-events: none;
}

{{ scope }} .collection-mosaic__text--top_left {
  top: 0;
}

{{ scope }} .collection-mosaic__text--bottom_left {
  bottom: 0;
}

{{ scope }} .collection-mosaic__text--center_left,
{{ scope }} .collection-mosaic__text--center {
  top: 50%;
  transform: translateY(-50%);
}

{{ scope }} .collection-mosaic__text--center {
  text-align: center;
}

{{ scope }} .collection-mosaic__heading {
  margin: 0;
  font-size: 14px;
  font-weight: 700;
  line-height: 18px;
  letter-spacing: 0;
  text-transform: capitalize;
}

{{ scope }} .collection-mosaic__body {
  margin: 8px 0 0;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 0;
}

{{ scope }} .collection-mosaic__cta {
  position: relative;
  display: inline-block;
  margin-top: 12px;
  padding-bottom: 1px;
  font-size: 12px;
  font-weight: 700;
  line-height: 14px;
}

{{ scope }} .collection-mosaic__cta::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  background: currentColor;
}

/* a soft shade behind light text placed at the top of a photo, so it reads on light photos too */
{{ scope }} .collection-mosaic__tile--shade::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 1;
  height: 38%;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.22), rgba(0, 0, 0, 0));
  pointer-events: none;
}

@media (max-width: 719px) {
  {{ scope }} .collection-mosaic__media .image > * {
    -o-object-position: var(--mosaic-position-m, center);
       object-position: var(--mosaic-position-m, center);
  }

  {{ scope }} .collection-mosaic__tile--has-mobile-image .collection-mosaic__media--desktop {
    display: none;
  }

  {{ scope }} .collection-mosaic__tile--has-mobile-image .collection-mosaic__media--mobile {
    display: block;
  }
}

@media (min-width: 720px) {
  {{ scope }} .collection-mosaic__text {
    padding: 16px;
  }

  {{ scope }} .collection-mosaic__heading {
    font-size: 16px;
    line-height: 20px;
  }

  {{ scope }} .collection-mosaic__body {
    margin-top: 10px;
    font-size: 12px;
  }

  {{ scope }} .collection-mosaic__cta {
    margin-top: 16px;
  }

  {{ scope }} .collection-mosaic__text--center_left {
    padding-left: clamp(16px, 9.375vw, 120px);
  }
}

@media (min-width: 960px) {
  {{ scope }} .collection-mosaic__heading {
    font-size: 20px;
    line-height: 24px;
  }

  {{ scope }} .collection-mosaic__body {
    font-size: 14px;
  }

  {{ scope }} .collection-mosaic__cta {
    margin-top: 24px;
    font-size: 14px;
    line-height: 16px;
  }
}

/* title under the tag when a slide has both (the tag sits 10px from the top) */
{{ scope }} .collection-mosaic__text--below-label {
  padding-top: 32px;
  padding-left: 10px;
}
