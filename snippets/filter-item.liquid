{%- doc -%}
  Renders a filter item.

  @param {string} scope - Where the filter group is being rendered (ie. 'drawer', 'sidebar', or 'top-bar').
  @param {string} type - The filter type (ie. 'checkbox', 'chip, or 'swatch').
  @param {object} filter_value - The filter value.
  @param {string} custom_color_key_map - A list of custom color names for swatches.
  @param {string} custom_color_value_map - A list of custom color values for swatches.
{%- enddoc -%}

{%- liquid
  assign file_extension = 'png'

  capture filter_id
    assign param_name = filter_value.param_name | url_escape
    assign label = filter_value.label | url_escape

    echo 'filter--[[pn]]--[[l]]--[[s]]' | replace: '[[pn]]', param_name | replace: '[[l]]', label | replace: '[[s]]', scope
  endcapture
-%}

<li
  class="
    filter-item
    {% if type == 'chip' -%}
      filter-item--chip
    {%- endif -%}
  "
>
  <label
    data-filter-item
    class="
      filter-item__content
      {% if filter_value.count == 0 and filter_value.active == false -%}
        filter-item__content--disabled
      {%- endif -%}
    "
    for="{{ filter_id }}"
  >
    <input
      type="checkbox"
      name="{{ filter_value.param_name }}"
      value="{{ filter_value.value }}"
      class="filter-item__checkbox visually-hidden"
      data-filter-item-input
      data-filter="{{ filter_value.param_name }}={{ filter_value.value }}"
      data-name-escaped="{{ filter_value.param_name | url_encode }}"
      data-value-escaped="{{ filter_value.value | url_encode }}"
      id="{{ filter_id }}"
      {% if filter_value.active -%}
        checked
      {%- endif %}
      {% if filter_value.count == 0 and filter_value.active == false -%}
        disabled
      {%- endif -%}
    >

    {%- liquid
      if section.settings.color_scheme.settings.background == section.settings.color_scheme.settings.form_input_background
        assign background_matches_form_input_background = true
      else
        assign background_matches_form_input_background = false
      endif

      if section.settings.color_scheme.settings.form_input_background == 'rgba(0,0,0,0)'
        assign form_input_background_is_transparent = true
      else
        assign form_input_background_is_transparent = false
      endif
    -%}

    <div
      class="filter-item__content-inner"
      data-background-matches-form-input-background="{{ background_matches_form_input_background }}"
      data-form-input-background-is-transparent="{{ form_input_background_is_transparent }}"
    >
      {%- case type -%}
        {%- when 'swatch' -%}
          {%- liquid
            capture filter_swatch_style
              assign downcased_label = filter_value.label | downcase

              # Color
              if filter_value.swatch and filter_value.swatch.color
                echo 'background-color: [[bc]];' | replace: '[[bc]]', filter_value.swatch.color
              else
                if custom_color_key_map contains downcased_label
                  for color_name in custom_color_key_map
                    if color_name == downcased_label
                      echo 'background-color: [[bc]];' | replace: '[[bc]]', custom_color_value_map[forloop.index0]
                      break
                    endif
                  endfor
                else
                  assign color_value = filter_value.label | downcase | replace: ' ', ''

                  echo 'background-color: [[bc]];' | replace: '[[bc]]', color_value
                endif
              endif

              # Image
              #
              # Width of 72 to account for largest swatch display
              if filter_value.swatch and filter_value.swatch.image
                assign swatch_image_url = filter_value.swatch.image | image_url: width: 72
              elsif filter_value.image
                assign swatch_image_url = filter_value.image | image_url: width: 72
              else
                assign custom_swatch_image = filter_value.label | handle | append: '.' | append: file_extension

                if images[custom_swatch_image] != blank
                  assign swatch_image_url = custom_swatch_image | file_img_url: 'small'
                endif
              endif

              if swatch_image_url != blank
                echo ' background-image: url([[siu]]);' | replace: '[[siu]]', swatch_image_url
              endif
            endcapture
          -%}

          <div
            class="filter-item__swatch"
            data-shape="{{ settings.swatch_shape }}"
            style="{{ filter_swatch_style }}"
          ></div>

        {%- when 'checkbox' -%}
          {%- liquid
            if section.settings.color_scheme.settings.background == section.settings.color_scheme.settings.form_input_background
              assign background_matches_form_input_background = true
            else
              assign background_matches_form_input_background = false
            endif
          -%}

          <div
            class="filter-input__input"
            data-background-matches-form-input-background="{{ background_matches_form_input_background }}"
          >
            {%- render 'icon', icon: 'checkmark' -%}
          </div>

        {%- when 'swatch', 'checkbox' -%}
          <span class="filter-item__label">
            {{- filter_value.label -}}
          </span>

          <span class="filter-item__count fs-body-75">
            {{- 'filters.item_count_html' | t: value: filter_value.count -}}
          </span>

        {%- when 'chip' -%}
          <div class="filter-item__chip">
            {{- filter_value.label -}}
          </div>
      {%- endcase -%}
    </div>
  </label>
</li>
