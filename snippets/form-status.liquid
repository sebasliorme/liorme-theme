{%- doc -%}
  Renders the standard form status display (ie. success/error messaging).

  @param {object} form - The form object.
  @param {string} form_id - A unique ID for the form.
  @param {string} success_message - The message to display when the form is submitted successfully.
  @param {string} success_alignment - The horizontal alignment of the success message.
{%- enddoc -%}

{%- if form.posted_successfully? or form.errors -%}
  <div
    id="form-status--{{ form_id }}"
    class="form-status"
    style="--success-alignment: {{ success_alignment }}"
  >
    {%- if form.posted_successfully? and success_message -%}
      <span
        class="form-status__message form-status__message--success"
        tabindex="0"
        data-form-status
      >
        {{- success_message -}}
      </span>
    {%- endif -%}

    {%- # This is needed in order to output the errors in the right order -%}
    {%- assign error_order = 'author, email, body, password, form' | split: ', ' -%}

    {%- if form.errors -%}
      <div class="form-status__message form-status__message--error fs-body-75">
        <ul tabindex="0" data-form-status>
          {%- for error in error_order -%}
            {%- for field in form.errors -%}
              {%- if error == field -%}
                {%- liquid
                  capture field_label
                    case field
                      when 'author'
                        echo 'contact.form.name' | t
                      when 'body'
                        echo 'contact.form.message' | t
                      else
                        echo form.errors.translated_fields[field]
                    endcase
                  endcapture
                -%}

                <li>
                  {%- if field == 'form' -%}
                    {{- form.errors.messages[field] -}}
                  {%- else -%}
                    {%- # The href should match the associated input's ID to act like an anchor -%}
                    <a href="#{{ form_id }}-{{ field }}" class="form-status__link">
                      {{- field_label | strip | capitalize }}
                      {{ form.errors.messages[field] -}}
                    </a>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor %}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
