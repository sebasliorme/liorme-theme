{%- doc -%}
  Renders a gemstone color picker overlaid on a product card, for products
  tagged for gem personalization (see snippets/product-item.liquid). Mirrors
  snippets/product-item-letter-picker.liquid — same card-scoped, delegated-
  event approach, same reasons for not reusing the product page's
  `custom_data` block.

  Gem options come from product tags shaped like `gema:#1e3a8a` (a flat color
  swatch) or `gema:#1e3a8a:archivo.jpg` (a swatch image — upload the file
  under Contenido > Archivos in Admin first, then use its exact filename
  here; the color still shows as a fallback/border reference and is what
  gets sent to the cart). One tag per option the product offers. There's no
  product-level data source for the custom_data block's configured
  birthstones, so this is a separate, independent way to declare gem options
  per product.

  @param {object} prod - The product object.
{%- enddoc -%}

{%- liquid
  assign add_to_cart_label = 'products.product.add_to_cart' | t
-%}

<div
  class="product-item-gem-picker"
  data-product-id="{{ prod.id }}"
>
  <div class="product-item-gem-picker__grid">
    {%- for tag in prod.tags -%}
      {%- if tag contains 'gema:' -%}
        {%- liquid
          assign gem_data = tag | split: 'gema:' | last | strip
          assign gem_parts = gem_data | split: ':'
          assign gem_value = gem_parts[0] | strip
          assign gem_image_filename = gem_parts[1] | strip
        -%}
        <button
          type="button"
          class="product-item-gem-picker__gem"
          data-gem="{{ gem_value }}"
          {% if gem_image_filename == blank %}style="background-color: {{ gem_value }};"{% endif %}
          aria-label="{{ gem_value }}"
        >
          {%- if gem_image_filename != blank -%}
            <img src="{{ gem_image_filename | file_img_url: 'small' }}" alt="" loading="lazy">
          {%- endif -%}
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <button
    type="button"
    class="product-item-gem-picker__submit"
    data-gem-add-to-cart
    data-variant-id="{{ prod.selected_or_first_available_variant.id }}"
    data-label-add="{{ add_to_cart_label }}"
    disabled
  >
    <span>{{ 'products.product.choose_options' | t }}</span>
  </button>
</div>

<style>
  .product-item-gem-picker {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
  }

  @media (max-width: 719px) {
    .product-item-gem-picker {
      display: none;
    }
  }

  @media (min-width: 720px) {
    .product-item-gem-picker {
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .product-item__inner:hover .product-item-gem-picker,
    .product-item__inner:focus-within .product-item-gem-picker {
      opacity: 1;
      visibility: visible;
    }
  }

  .product-item-gem-picker__grid {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 10px 8px 15px;
  }

  .product-item-gem-picker__gem {
    width: 18px;
    height: 18px;
    border-radius: 0;
    border: none;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
  }

  .product-item-gem-picker__gem img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .product-item-gem-picker__submit {
    display: block;
    width: 100%;
    background: #111111;
    color: #fff;
    border: none;
    padding: 12px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .product-item-gem-picker__submit[disabled] {
    cursor: not-allowed;
  }
</style>

<script>
  (function () {
    if (window.__gemPickerBound) return;
    window.__gemPickerBound = true;

    document.addEventListener('click', function (e) {
      var gemBtn = e.target.closest('.product-item-gem-picker__gem');
      if (gemBtn) {
        e.preventDefault();
        var picker = gemBtn.closest('.product-item-gem-picker');
        picker.querySelectorAll('.product-item-gem-picker__gem').forEach(function (btn) {
          btn.classList.toggle('selected', btn === gemBtn);
        });
        picker.dataset.selectedGem = gemBtn.dataset.gem;

        var submitBtn = picker.querySelector('[data-gem-add-to-cart]');
        var textEl = submitBtn.querySelector('span');
        submitBtn.disabled = false;
        if (textEl) textEl.textContent = submitBtn.dataset.labelAdd;
        return;
      }

      var submitBtn = e.target.closest('[data-gem-add-to-cart]');
      if (!submitBtn) return;

      e.preventDefault();
      var picker = submitBtn.closest('.product-item-gem-picker');
      var gem = picker.dataset.selectedGem;
      var variantId = submitBtn.dataset.variantId;
      if (!gem || !variantId) return;

      var textEl = submitBtn.querySelector('span');
      var originalText = textEl ? textEl.textContent : '';
      submitBtn.disabled = true;
      if (textEl) textEl.textContent = {{ 'products.product.adding_to_cart' | t | json }};

      var formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', '1');
      formData.append('properties[{{ "products.product.personalization.slot_1" | t }}]', {{ 'products.product.personalization.gem_prefix' | t | json }} + ': ' + gem);

      fetch('/cart/add.js', {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' }
      })
        .then(function (response) {
          if (!response.ok) return response.json().then(function (err) { throw err; });
          return response.json();
        })
        .then(function (data) {
          if (textEl) textEl.textContent = {{ 'products.product.added_to_cart' | t | json }};

          document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { data: data } }));
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { data: data } }));
          document.dispatchEvent(new CustomEvent('theme:cart:reload', { bubbles: true }));

          var cartDrawer =
            document.querySelector('cart-drawer') ||
            document.querySelector('.cart-drawer') ||
            document.querySelector('#CartDrawer');
          if (cartDrawer) {
            if (typeof cartDrawer.renderContents === 'function') cartDrawer.renderContents(data);
            cartDrawer.classList.add('active', 'is-active');
          }
        })
        .catch(function (error) {
          console.error('Add to Cart Error:', error);
          alert((error && (error.description || error.message)) || {{ 'products.product.add_to_cart_error' | t | json }});
        })
        .finally(function () {
          setTimeout(function () {
            submitBtn.disabled = !picker.dataset.selectedGem;
            if (textEl) textEl.textContent = originalText;
          }, 1200);
        });
    });
  })();
</script>
