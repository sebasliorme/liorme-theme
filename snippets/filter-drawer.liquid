{%- doc -%}
  Renders the filter drawer content.

  @param {object} resource - The collection or search object.
  @param {boolean} show_sort - Whether to show the sort selector.
  @param {boolean} show_filters - Whether to show filters.
  @param {boolean} collapse_filter_groups - Whether the filter groups should be collapsed by default.
  @param {number} active_filter_count - The number of active filters.
  @param {boolean} show_swatch_filters - Whether to show matching filters as swatches.
  @param {string} swatch_options - The product options that should be used for swatches.
  @param {string} custom_color_key_map - A list of custom color names for swatches.
  @param {string} custom_color_value_map - A list of custom color values for swatches.
  @param {boolean} show_chip_filters - Whether to show matching filters as chips.
  @param {string} chip_options - The product options that should be used for chips.
  @param {string} chip_layout - How chip filters should be laid out (ie. "Grid 3 columns", "Grid 2 columns", or "Natural").
{%- enddoc -%}

{%- liquid
  assign results_count = 0

  if resource.products_count != blank
    assign results_count = resource.products_count
  elsif resource.results_count != blank
    assign results_count = resource.results_count
  endif
-%}

{%- if resource.filters != empty or show_sort -%}
  <form
    class="filter-drawer popover"
    data-filter-modal-wrapper
    data-filter-form
    data-filter-drawer
    data-filters-count="{{ resource.filters | size }}"
  >
    {%- if search.terms -%}
      <input
        type="hidden"
        name="q"
        id="SearchFilters--FilterDrawer"
        value="{{ search.terms | escape }}"
      >
    {%- endif -%}

    <div class="filter-drawer__wash" data-drawer-wash></div>

    {%- comment -%} Keep search term within form {%- endcomment -%}
    {%- if resource.terms -%}
      <input type="hidden" name="q" value="{{ resource.terms | escape }}">
      <input name="options[prefix]" type="hidden" value="last">
    {%- endif -%}

    {%- comment -%} Keep product type within form {%- endcomment -%}
    {%- if resource.current_type -%}
      <input type="hidden" name="q" value="{{ resource.current_type | escape }}">
    {%- endif -%}

    {%- comment -%} Keep product vendor within form {%- endcomment -%}
    {%- if resource.current_vendor -%}
      <input type="hidden" name="q" value="{{ resource.current_vendor | escape }}">
    {%- endif -%}

    {%- if resource.filters != empty -%}
      {%- liquid
        if active_filter_count > 0
          assign filters_active = true
        else
          assign filters_active = false
        endif
      -%}

      <div
        class="
          filter-drawer__panel
          {% if filters_active %}filters-active{% endif %}
          animation
          animation--filter-drawer
        "
        data-filter-modal="__tags"
        data-filter-drawer-panel
        aria-labelledby="modal-{{ 'filters.title' | t }}"
        aria-modal="true"
        aria-hidden="true"
      >
        <div class="filter-drawer__content" data-scroll-lock-ignore>
          <div class="filter-drawer__heading">
            <h2
              id="modal-{{ 'filters.title' | t }}"
              class="filter-drawer__title ff-heading fs-heading-4-base"
              data-filter-drawer-title
            >
              {{ 'filters.title' | t }}

              {%- if filters_active -%}
                <span class="filter-drawer__title-count ff-body fs-body-100">{{ active_filter_count }}</span>
              {%- endif -%}
            </h2>

            <button
              type="button"
              class="filter-drawer__close"
              aria-label="{{ 'general.accessibility.close_modal' | t }}"
              data-close-icon
            >
              {% render 'icon-button', small: true, icon: 'close' %}
            </button>
          </div>

          {%- for filter in resource.filters -%}
            {%- render 'filter-drawer-group',
              scope: 'drawer',
              filter: filter,
              collapse_filter_groups: collapse_filter_groups,
              show_swatch_filters: show_swatch_filters,
              swatch_options: swatch_options,
              show_chip_filters: show_chip_filters,
              chip_options: chip_options,
              chip_layout: chip_layout,
              custom_color_key_map: custom_color_key_map,
              custom_color_value_map: custom_color_value_map
            -%}
          {%- endfor -%}
        </div>

        <div
          class="filter-drawer__footer animation--filter-drawer-item"
          data-has-background-gradient="
            {%- if settings.drawer_color_scheme.settings.background_gradient != blank -%}
              true
            {%- else -%}
              false
            {%- endif -%}
          "
        >
          <div class="filter-drawer__footer-active-filters" data-scroll-lock-ignore>
            {%- render 'active-filters',
              resource: resource,
              show_swatch_filters: show_swatch_filters,
              swatch_options: swatch_options,
              custom_color_key_map: custom_color_key_map,
              custom_color_value_map: custom_color_value_map
            -%}
          </div>

          <div class="filter-drawer__footer-buttons">
            <button
              type="button"
              class="filter-drawer__button-clear fs-body-75"
              data-button="clear-all"
            >
              {{ 'filters.clear_all' | t }}
            </button>

            <p class="filter-drawer__results-count fs-body-50 fc" data-results-count>
              {% render 'results-count', results_count: results_count %}
            </p>

            <button type="button" class="filter-drawer__button-apply btn btn--primary" data-button="close">
              {{ 'filters.done' | t }}
            </button>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if show_sort -%}
      <div
        class="
          filter-drawer__panel
          filter-drawer__panel--sort
          animation
          animation--filter-drawer
        "
        data-filter-modal="__sort"
        aria-labelledby="modal-{{ 'filters.sort_title' | t }}"
        aria-modal="true"
        aria-hidden="true"
      >
        <div class="filter-drawer__content" data-scroll-lock-ignore>
          <div class="filter-drawer__heading">
            <h2 id="modal-{{ 'filters.sort_title' | t }}" class="ff-heading fs-heading-4-base">
              {{ 'filters.sort_title' | t }}
            </h2>

            <button
              type="button"
              class="filter-drawer__close"
              aria-label="{{ 'general.accessibility.close_modal' | t }}"
              data-close-icon
            >
              {% render 'icon-button', small: true, icon: 'close' %}
            </button>
          </div>

          <div class="filter-drawer__group animation--filter-drawer-item">
            <ul class="filter-drawer__list">
              {%- for option in resource.sort_options -%}
                {%- liquid
                  if option.value == resource.sort_by
                    assign is_active = true
                  else
                    assign is_active = false
                  endif
                -%}

                <li class="filter-item">
                  <label data-sort for="filter-{{ option.name | handleize }}--mobile" class="filter-item__content">
                    <input
                      type="radio"
                      name="sort_by"
                      {% if is_active %}
                        checked="checked"
                      {% endif %}
                      value="{{ option.value }}"
                      data-value-escaped="{{ option.value | url_escape }}"
                      id="filter-{{ option.name | escape | handleize }}--mobile"
                      class="filter-item__radio visually-hidden"
                      data-sort-item-input
                    >

                    <div class="filter-item__content-inner">
                      <div class="filter-input__input">
                        <div class="indicator"></div>
                      </div>

                      <span class="filter-item__label">{{ option.name }}</span>
                    </div>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>

        <div class="filter-drawer__footer animation--filter-drawer-item">
          <div class="filter-drawer__footer-buttons">
            <button type="button" class="filter-drawer__button-apply btn btn--primary" data-button="close">
              {{ 'filters.done' | t }}
            </button>
          </div>
        </div>
      </div>
    {%- endif -%}
  </form>
{%- endif -%}
