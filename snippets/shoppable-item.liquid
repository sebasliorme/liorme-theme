{%- doc -%}
  Renders a shoppable item for the "Shoppable image" and "Shoppable image - Editorial" sections.

  @param {object} block - The block object.
  @param {number} index - The index of the current block in block loop.
  @param {object} product_item - The product.
  @param {number} horizontal_position - The horizontal position (from 0%-100%) of the item's hotspot.
  @param {number} vertical_position - The vertical position (from 0%-100%) of the item's hotspot.
  @param {string} aspect_ratio - The aspect ratio to use for the item's product card.
  @param {boolean} [show_hotspot_cards] - Whether to show a "tooltip"-like product card when the hotspot is clicked.
  @param {object} hotspot_color_scheme - The color scheme to use for the hotspots.
{%- enddoc -%}

{%- liquid
  assign vertical_position = 100 | minus: vertical_position
  assign delay_value = 0.3 | times: index
  assign animation_delay = 1 | plus: delay_value
  assign show_hotspot_cards = show_hotspot_cards | default: true, allow_false: true
-%}

<div
  class="
    shoppable-item
    shoppable-item--index-{{ index }}
    shoppable-item--animating
    shoppable-item--position-unset
    shoppable-item--{{ settings.product_listing_aspect_ratio }}
    {% unless product_item == blank or show_hotspot_cards == false %}
      animation--shoppable-item
    {% endunless %}
  "
  style="
    --horizontal-position: {{ horizontal_position }}%;
    --vertical-position: {{ vertical_position }}%;
    --animation-delay: {{ animation_delay }}s;
  "
  data-index="{{ index }}"
>
  {%- liquid
    capture hotspot_tag
      if product_item != blank
        echo 'button'
      else
        echo 'div'
      endif
    endcapture

    capture hotspot_tag_attributes
      assign hotspot_description = 'sections.shoppable_image.hotspot_description' | t

      if product_item != blank
        assign more_details = 'general.accessibility.access_more_details_about_product' | t: product_title: product_item.title

        echo 'aria-label="[[md]]" type="button"' | replace: '[[md]]', more_details
      endif

      echo 'aria-roledescription="[[hd]]"' | replace: '[[hd]]', hotspot_description
    endcapture
  -%}

  <div class="shoppable-item__hotspot-wrapper animation--hotspot">
    <{{ hotspot_tag }}
      class="shoppable-item__hotspot"
      style="{%- render 'color-scheme-to-vars', color_scheme: hotspot_color_scheme -%}"
      {{ hotspot_tag_attributes }}
      data-index="{{index}}"
      {{ block.shopify_attributes }}
    >
    </{{ hotspot_tag }}>
  </div>

  {%- unless product_item == blank or show_hotspot_cards == false -%}
    <div
      class="
        shoppable-item__product-card
        {% if horizontal_position >= 50 -%}
          shoppable-item__product-card--align-right
        {%- endif %}
        hidden
      "
      aria-hidden="true"
      aria-live="polite"
      role="region"
    >
      <a href="{{ product_item.url }}" class="shoppable-item__product-card-inner">
        <div class="shoppable-item__meta">
          <div class="shoppable-item__text">
            <h4 class="shoppable-item__product-title ff-product-listing-title">
              <span>{{ product_item.title }}</span>
            </h4>

            {%- if product_item.compare_at_price > product_item.price -%}
              <p class="shoppable-item__price">
                <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
                <s class="t-subdued">{{ product_item.compare_at_price | money_without_trailing_zeros | replace: '.00', '' }}</s>

                {%- if product_item.price_varies -%}
                  {%- assign sale_price = product_item.price | money_without_trailing_zeros | replace: '.00', '' -%}

                  <span class="sale">
                    {{- 'products.product.on_sale_from_html' | t: price: sale_price -}}
                  </span>
                {%- else -%}
                  <span class="sale">{{ product_item.price | money_without_trailing_zeros | replace: '.00', '' }}</span>
                {%- endif -%}
              </p>
            {%- else -%}
              {%- if product_item.price_varies -%}
                {%- assign price = product_item.price | money_without_trailing_zeros | replace: '.00', '' -%}

                <p class="shoppable-item__price">
                  {{- 'products.product.from_lowest_price_html' | t: lowest_price: price -}}
                </p>
              {%- else -%}
                <span class="shoppable-item__price">{{ product_item.price | money_without_trailing_zeros | replace: '.00', '' }}</span>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </a>
    </div>
  {%- endunless -%}
</div>
