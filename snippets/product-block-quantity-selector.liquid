{%- doc -%}
  Renders the product quantity selector block.

  @param {object} prod - The product object. We use 'prod' to avoid collision with the global 'product' object.
  @param {object} block - The block object.
{%- enddoc -%}

{%- liquid
  capture label_classes
    echo 'fs-body-100'

    unless block.settings.show_labels
      echo ' visually-hidden'
    endunless
  endcapture
-%}

<div
  class="
    product__controls-group
    product__controls-group-quantity
    product__block
    product__block--medium
  "
  {{ block.shopify_attributes }}
>
  <div class="product__label-wrapper {%- unless block.settings.show_labels %} product__label-wrapper--collapse{%- endunless -%}">
    <label class="product__label {{ label_classes }}" for="Quantity-Input-{{ prod.id }}">
      {{- 'products.product.quantity' | t -}}
    </label>
  </div>

  <div class="product__item">
    {%- render 'quantity-input', prod: prod, id: prod.id -%}
  </div>
</div>
