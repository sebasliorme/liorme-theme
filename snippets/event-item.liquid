{%- doc -%}
  Renders an event item for the 'Events' section.

  @param {object} block - The block object.
  @param {number} columns - The number of columns on desktop.
  @param {number} mobile_columns - The number of columns on mobile.
  @param {string} aspect_ratio - The aspect ratio to be used for the image (if there is one).
  @param {object} date_badge_color_scheme - The color scheme to use for the date badge.
  @param {string} date_badge_style - The style of the date badge (ie. 'outline', or 'dropshadow').
{%- enddoc -%}

{%- liquid
  if block.settings.link != blank
    assign link_element = 'a'
  else
    assign link_element = 'div'
  endif
-%}

<li
  class="
    event-item
    {% if block.settings.image -%}event-item--has-image{%- endif %}
  "
  {{ block.shopify_attributes }}
>
  <{{ link_element }}
    {% unless block.settings.link == blank -%}
      href="{{ block.settings.link }}"
    {%- endunless %}
    class="event-item__link"
  >
    <div class="event-item__image-wrapper">
      {%- unless block.settings.image == blank -%}
        {%- liquid
          capture image_sizes
            echo '(min-width: 720px) calc(calc(100vw - calc(2 * clamp(18px, 3.3vw, 3.3vw))) / [[c]]), calc(100vw - calc(2 * 3.3vw) / [[mc]])' | replace: '[[c]]', columns | replace: '[[mc]]', mobile_columns
          endcapture
        -%}

        {%- render 'image',
          wrapper_class: 'event-item__image',
          image: block.settings.image,
          sizes: image_sizes,
          focal_point: 'image_presentation',
          aspect_ratio: aspect_ratio,
          animate: true
        -%}
      {%- endunless -%}

      {%- if block.settings.enable_date_badge -%}
        {%- liquid
          # The setting values for this setting used to be capitalized, so we do this to match
          # the translation keys
          assign month_name = block.settings.date_badge_month | capitalize
          assign date_badge_month = 'general.month_abbreviations.' | append: month_name
        -%}

        <span
          class="
            event-item__date-badge
            event-item__date-badge--style-{{ date_badge_style }}
          "
          style="{%- render 'color-scheme-to-vars', color_scheme: date_badge_color_scheme -%}"
        >
          <span class="event-item__date-badge-day fs-body-bold fs-body-200">
            {{- block.settings.date_badge_day -}}
          </span>

          <span class="event-item__date-badge-month fs-accent">
            {{- date_badge_month | t -}}
          </span>
        </span>
      {%- endif -%}
    </div>

    <div class="event-item__details">
      {%- unless block.settings.name == blank -%}
        <{{ block.settings.name_tag }} class="event-item__name ff-heading fs-heading-5-base">
          {{- block.settings.name -}}
        </{{ block.settings.name_tag }}>
      {%- endunless -%}

      {%- unless block.settings.date == blank -%}
        <p class="event-item__date fs-body-75">{{ block.settings.date }}</p>
      {%- endunless -%}

      {%- unless block.settings.venue == blank -%}
        <p class="event-item__venue fs-body-75">{{ block.settings.venue }}</p>
      {%- endunless -%}

      {%- unless block.settings.summary == blank -%}
        <div class="event-item__summary rte">{{ block.settings.summary }}</div>
      {%- endunless -%}

      {% unless block.settings.link == blank %}
        <span class="btn btn--callout event-item__callout">
          <span>{{ 'sections.events.learn_more' | t }}</span>
        </span>
      {%- endunless -%}
    </div>
  </{{ link_element }}>
</li>
