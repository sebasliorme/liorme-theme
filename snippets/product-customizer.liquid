{%- doc -%}
  LIORME customization studio. Real Shopify variants, availability and prices.
  anillo-24 offers the four products selected by the merchant. Other products use
  custom.customization_products. Finalizar adds a grouped selection to the cart.
{%- enddoc -%}
{%- liquid
 assign lc_refs = prod.metafields.custom.customization_products.value
 assign lc_fixed = false
 if prod.handle == 'anillo-24'
  assign lc_refs = 'aretes-12,anillo-star,argollas-13,aretes-16' | split: ','
  assign lc_fixed = true
 endif
 assign lc_id = 'lc-' | append: section_id | append: '-' | append: prod.id
-%}
<dialog id="{{ lc_id }}" class="lc-studio" data-lc-studio data-product-id="{{ prod.id }}" aria-label="Personaliza tu selección">
 <div class="lc-layout">
  <section class="lc-preview" aria-label="Vista previa de tu selección">
   <button type="button" class="lc-total" data-lc-summary-toggle aria-expanded="false"><span>Total <strong data-lc-total></strong>⌄</span><small data-lc-count></small></button>
   <div class="lc-summary" data-lc-summary hidden><h2>Tu selección</h2><div data-lc-breakdown></div></div>
   <img class="lc-base-image" data-lc-base-image src="{{ prod.featured_image | image_url: width: 1400 }}" alt="{{ prod.title | escape }}" width="1400" height="1400">
   <div class="lc-slots" data-lc-slots></div>
   <div class="lc-preview-tools"><button type="button" data-lc-zoom aria-label="Ampliar vista previa" aria-pressed="false">⛶</button><div class="lc-photo-controls"><button type="button" data-lc-photo="-1" aria-label="Foto anterior">←</button><span data-lc-photo-count></span><button type="button" data-lc-photo="1" aria-label="Foto siguiente">→</button></div></div>
   <span class="lc-preview-caption">Vista previa de la selección</span>
  </section>
  <section class="lc-panel" aria-label="Opciones de personalización">
   <div class="lc-tabs" role="tablist" aria-label="Categorías" data-lc-tabs></div>
   <div class="lc-grid" data-lc-grid></div>
   <p class="lc-error" data-lc-error role="alert" hidden></p>
   <div class="lc-footer"><span data-lc-footer-label>Complementos</span><button type="button" class="lc-finish" data-lc-finish disabled>Finalizar</button></div>
  </section>
  <button type="button" class="lc-close" data-lc-close aria-label="Cerrar personalizador">×</button>
  <section class="lc-info" data-lc-info hidden aria-label="Información del complemento"><button type="button" data-lc-info-close aria-label="Cerrar información">×</button><div data-lc-info-content></div></section>
 </div>
 <script type="application/json" data-lc-data>
 {"id":{{ prod.id | json }},"handle":{{ prod.handle | json }},"title":{{ prod.title | json | replace: '</', '<\/' }},"currency":{{ cart.currency.iso_code | default: shop.currency | json }},"locale":{{ request.locale.iso_code | json }},"cart":{{ routes.cart_url | json }},"add":{{ routes.cart_add_url | append: '.js' | json }},"images":[{% for photo in prod.images %}{{ photo | image_url: width: 1400 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],"variants":{{ prod.variants | json | replace: '</', '<\/' }},"options":[
 {% for ref in lc_refs %}
  {% liquid
   if lc_fixed
    assign charm = all_products[ref]
   else
    assign charm = ref
   endif
   assign category = charm.type | default: 'Complementos'
   if lc_fixed
    assign category = 'Carteras'
    if charm.handle == 'anillo-star'
     assign category = 'Perfumes'
    endif
   endif
  %}
  {"id":{{ charm.id | json }},"title":{{ charm.title | json | replace: '</', '<\/' }},"category":{{ category | json | replace: '</', '<\/' }},"description":{{ charm.description | strip_html | json | replace: '</', '<\/' }},"url":{{ charm.url | json }},"image":{{ charm.featured_image | image_url: width: 700 | json }},"variants":{{ charm.variants | json | replace: '</', '<\/' }}}
  {% unless forloop.last %},{% endunless %}
 {% endfor %}]}
 </script>
</dialog>
