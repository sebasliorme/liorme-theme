 function build(r,s){const cats=['Todo',...new Set(s.data.options.map(p=>p.category))];const tabs=q(r,'[data-lc-tabs]');cats.forEach((cat,i)=>{const b=el('button','',cat);b.type='button';b.dataset.lcTab=cat;b.setAttribute('role','tab');b.setAttribute('aria-selected',String(i===0));b.tabIndex=i===0?0:-1;tabs.append(b)});const grid=q(r,'[data-lc-grid]');s.data.options.forEach(p=>{const card=el('article','lc-card');card.dataset.product=String(p.id);card.dataset.category=p.category;const pick=el('button','lc-pick');pick.type='button';pick.dataset.lcPick=String(p.id);pick.setAttribute('aria-pressed','false');pick.setAttribute('aria-label','Añadir '+p.title);const media=el('span','lc-card-media');const img=el('img');img.src=p.image;img.alt=p.title;img.loading='lazy';media.append(img,el('span','lc-picked','✓'));pick.append(media,el('span','lc-card-title',p.title),el('span','lc-card-price',money(s,s.variants.get(p.id).price)));card.append(pick);const info=el('button','lc-card-info','ⓘ');info.type='button';info.dataset.lcInfo=String(p.id);info.setAttribute('aria-label','Información de '+p.title);card.append(info);if(p.variants.length>1){const select=el('select');select.dataset.lcVariant=String(p.id);select.setAttribute('aria-label','Variante de '+p.title);p.variants.forEach(v=>{const opt=el('option','',v.title+' — '+money(s,v.price)+(v.available?'':' · Agotado'));opt.value=String(v.id);opt.disabled=!v.available;opt.selected=v.id===s.variants.get(p.id).id;select.append(opt)});card.append(select)}if(!p.variants.some(v=>v.available)){pick.disabled=true;card.append(el('span','lc-unavailable','Agotado'))}grid.append(card)});if(!s.data.options.length)grid.append(el('p','lc-empty','No hay complementos disponibles en este momento.'));const status=el('span','lc-live-status');status.setAttribute('aria-live','polite');status.dataset.lcStatus='';r.append(status)}
 function current(s){const form=s.form;if(!form||!form.isConnected)return null;const fields=new FormData(form);const id=Number(fields.get('id'));const variant=s.data.variants.find(v=>v.id===id);const quantity=Math.max(1,parseInt(fields.get('quantity')||'1',10)||1);return variant?{variant,quantity,fields}:null}
 function render(r){const s=state(r);const base=current(s);const quantity=base?base.quantity:1;const basePrice=base?base.variant.price:0;let total=basePrice;s.selected.forEach(entry=>total+=entry.variant.price);q(r,'[data-lc-total]').textContent=money(s,total*quantity);q(r,'[data-lc-count]').textContent=((s.selected.size+1)*quantity)+' artículos';q(r,'[data-lc-footer-label]').textContent=s.selected.size?s.selected.size+' complementos':'Complementos';q(r,'[data-lc-finish]').disabled=s.busy||!s.selected.size||!base||!base.variant.available;q(r,'[data-lc-finish]').textContent=s.busy?'Añadiendo…':'Finalizar';qa(r,'[data-lc-pick]').forEach(b=>{const p=s.data.options.find(x=>x.id===Number(b.dataset.lcPick));const v=s.variants.get(p.id);b.setAttribute('aria-pressed',String(s.selected.has(p.id)));b.setAttribute('aria-label',(s.selected.has(p.id)?'Quitar ':'Añadir ')+p.title);q(b,'.lc-card-price').textContent=money(s,v.price)});const slots=q(r,'[data-lc-slots]');slots.replaceChildren();const positions=[[17,54],[83,54],[22,76],[78,76]];for(let i=0;i<4;i++){const item=Array.from(s.selected.values()).find(x=>x.slot===i);const slot=el('div','lc-slot'+(s.slot===i?' is-active':''));slot.style.setProperty('--x',positions[i][0]+'%');slot.style.setProperty('--y',positions[i][1]+'%');if(item){const img=el('img');img.src=item.image;img.alt=item.title;slot.append(img);const b=el('button','','−');b.type='button';b.dataset.lcRemove=String(item.id);b.setAttribute('aria-label','Quitar '+item.title);slot.append(b)}else{slot.append(el('small','','Añadir'));const b=el('button','','+');b.type='button';b.dataset.lcSlot=String(i);b.setAttribute('aria-label','Añadir complemento en posición '+(i+1));b.setAttribute('aria-pressed',String(s.slot===i));slot.append(b)}slots.append(slot)}const list=q(r,'[data-lc-breakdown]');list.replaceChildren();const entries=[{id:null,title:s.data.title,image:s.data.images[0],variant:base?base.variant:{price:0,title:''}},...s.selected.values()];entries.forEach(item=>{const row=el('div','lc-summary-row');const img=el('img');img.src=item.image;img.alt='';const text=el('div','',item.title);text.append(el('small','',(item.variant.title==='Default Title'?'':item.variant.title+' · ')+quantity+' × '+money(s,item.variant.price)));row.append(img,text);if(item.id){const b=el('button','','×');b.type='button';b.dataset.lcRemove=String(item.id);b.setAttribute('aria-label','Quitar '+item.title);row.append(b)}list.append(row)});q(r,'[data-lc-status]').textContent='Total '+money(s,total*quantity)+'. '+s.selected.size+' complementos seleccionados.'}
 function photo(r){const s=state(r);const images=s.data.images;const base=current(s);let src=images[s.photo]||images[0];if(s.photo===0&&base&&base.variant.featured_image)src=base.variant.featured_image.src||src;if(src)q(r,'[data-lc-base-image]').src=src;q(r,'[data-lc-photo-count]').textContent=images.length?(s.photo+1)+' / '+images.length:'';qa(r,'[data-lc-photo]').forEach(b=>b.hidden=images.length<2)}
 function open(trigger){const r=document.getElementById(trigger.dataset.lcTarget)||Array.from(document.querySelectorAll('[data-lc-studio]')).find(d=>d.dataset.productId===trigger.dataset.customizerProduct);if(!r)return;const s=state(r);s.form=trigger.closest('form');s.trigger=trigger;s.overflow=document.body.style.overflow;document.body.append(r);render(r);photo(r);r.showModal();document.body.style.overflow='hidden';q(r,'[data-lc-close]').focus()}
 function close(r){const s=state(r);if(s.busy)return;r.close();document.body.style.overflow=s.overflow||'';r.dataset.zoom='false';q(r,'[data-lc-info]').hidden=true;if(s.trigger&&s.trigger.isConnected)s.trigger.focus()}
 function error(r,message){const box=q(r,'[data-lc-error]');box.textContent=message;box.hidden=!message}
 function remove(r,id){const s=state(r);if(s.busy)return;const entry=s.selected.get(id);if(entry)s.slot=entry.slot;s.selected.delete(id);error(r,'');render(r)}
 function pick(r,id){const s=state(r);if(s.busy)return;if(s.selected.has(id)){remove(r,id);return}const p=s.data.options.find(p=>p.id===id);const variant=s.variants.get(id);if(!p||!variant.available)return;let slot=s.slot;if(Array.from(s.selected.values()).some(x=>x.slot===slot))slot=[0,1,2,3].find(i=>!Array.from(s.selected.values()).some(x=>x.slot===i));if(slot===undefined){error(r,'Puedes seleccionar hasta cuatro complementos. Quita uno para cambiarlo.');return}s.selected.set(id,{...p,variant,slot});s.slot=[0,1,2,3].find(i=>!Array.from(s.selected.values()).some(x=>x.slot===i))??0;error(r,'');render(r)}
 function category(r,name){const s=state(r);s.category=name;qa(r,'[data-lc-tab]').forEach(b=>{const active=b.dataset.lcTab===name;b.setAttribute('aria-selected',String(active));b.tabIndex=active?0:-1});qa(r,'.lc-card').forEach(c=>c.hidden=name!=='Todo'&&c.dataset.category!==name)}
 function info(r,id){const s=state(r),p=s.data.options.find(p=>p.id===id),content=q(r,'[data-lc-info-content]');content.replaceChildren();const img=el('img');img.src=p.image;img.alt=p.title;content.append(img,el('h2','',p.title),el('p','',money(s,s.variants.get(id).price)),el('p','',p.description||'Selecciona una variante disponible para añadir este complemento.'));const link=el('a','','Ver producto');link.href=p.url;link.target='_blank';link.rel='noopener';content.append(link);q(r,'[data-lc-info]').hidden=false;q(r,'[data-lc-info-close]').focus()}
 async function finish(r){const s=state(r);if(s.busy)return;const base=current(s);if(!base||!base.variant.available){error(r,'Selecciona una variante disponible del producto principal.');return}if(!s.selected.size){error(r,'Selecciona al menos un complemento.');return}if(s.form.reportValidity&&!s.form.reportValidity())return;const group='LC-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,8);const properties={_liorme_customization:group};for(const [key,value]of base.fields){const m=key.match(/^properties[(.+)]$/);if(m&&typeof value==='string'&&value)properties[m[1]]=value}properties['Complementos']=Array.from(s.selected.values()).map(x=>x.title+' ('+x.variant.title+')').join(', ');const main={id:base.variant.id,quantity:base.quantity,properties};const plan=base.fields.get('selling_plan');if(plan)main.selling_plan=plan;const items=[main,...Array.from(s.selected.values()).map(x=>({id:x.variant.id,quantity:base.quantity,properties:{_liorme_customization:group,'Personalización de':s.data.title,'Posición':String(x.slot+1)}}))];s.busy=true;error(r,'');render(r);let sent=false;try{sent=true;const res=await fetch(s.data.add,{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({items})});if(!res.ok){const problem=await res.json();s.busy=false;error(r,typeof problem.description==='string'?problem.description:'No se pudo añadir la selección. Revisa la disponibilidad e inténtalo otra vez.');render(r);return}window.location.assign(s.data.cart)}catch(e){s.busy=false;error(r,'No pudimos confirmar la respuesta. Revisa el carrito antes de intentarlo de nuevo para evitar duplicados.');render(r);const link=el('a','',' Ver carrito');link.href=s.data.cart;q(r,'[data-lc-error]').append(link)}}
 document.addEventListener('click',event=>{const trigger=event.target.closest('[data-customizer-trigger]');if(trigger){event.preventDefault();open(trigger);return}const r=event.target.closest('[data-lc-studio]');if(!r)return;const s=state(r);const b=event.target.closest('button');if(!b)return;if(b.hasAttribute('data-lc-close'))return close(r);if(b.hasAttribute('data-lc-summary-toggle')){const box=q(r,'[data-lc-summary]');box.hidden=!box.hidden;b.setAttribute('aria-expanded',String(!box.hidden));return}if(b.hasAttribute('data-lc-info-close')){q(r,'[data-lc-info]').hidden=true;return}if(s.busy)return;if(b.hasAttribute('data-lc-tab'))return category(r,b.dataset.lcTab);if(b.hasAttribute('data-lc-pick'))return pick(r,Number(b.dataset.lcPick));if(b.hasAttribute('data-lc-remove'))return remove(r,Number(b.dataset.lcRemove));if(b.hasAttribute('data-lc-slot')){s.slot=Number(b.dataset.lcSlot);render(r);const first=qa(r,'[data-lc-pick]').find(x=>!x.disabled&&!x.closest('.lc-card').hidden);if(first)first.focus();return}if(b.hasAttribute('data-lc-info'))return info(r,Number(b.dataset.lcInfo));if(b.hasAttribute('data-lc-photo')){s.photo=(s.photo+Number(b.dataset.lcPhoto)+s.data.images.length)%s.data.images.length;return photo(r)}if(b.hasAttribute('data-lc-zoom')){const zoom=r.dataset.zoom!=='true';r.dataset.zoom=String(zoom);b.setAttribute('aria-pressed',String(zoom));b.setAttribute('aria-label',zoom?'Reducir vista previa':'Ampliar vista previa');return}if(b.hasAttribute('data-lc-finish'))finish(r)});
 document.addEventListener('change',event=>{const select=event.target.closest('[data-lc-variant]');if(select){const r=select.closest('[data-lc-studio]'),s=state(r),id=Number(select.dataset.lcVariant),p=s.data.options.find(x=>x.id===id),v=p.variants.find(x=>x.id===Number(select.value));if(!s.busy&&v&&v.available){s.variants.set(id,v);if(s.selected.has(id))s.selected.get(id).variant=v;render(r)}}});
 document.addEventListener('keydown',event=>{const tab=event.target.closest('[data-lc-tab]');if(!tab||!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;event.preventDefault();const r=tab.closest('[data-lc-studio]'),tabs=qa(r,'[data-lc-tab]');let i=tabs.indexOf(tab);i=event.key==='Home'?0:event.key==='End'?tabs.length-1:(i+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;category(r,tabs[i].dataset.lcTab);tabs[i].focus()});
})();
</script>