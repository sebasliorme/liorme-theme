{%- doc -%}
  Renders a newsletter signup form.

  @param {string} form_id - A unique ID that's used for the form and input IDs.\
  @param {string} base_class - A "prefix" to scope classes for the form and various elements.
  @param {string} success_msg - The success message for the form.
  @param {string} [additional_form_classes] - Classes to apply to the form.
  @param {string} [button_label] - The label for the submit button.
  @param {boolean} [custom_button] - Whether to use a custom "floating" button or the dedicated "button-block" snippet.
  @param {string} [custom_button_class] - A class for the custom button.
  @param {string} [custom_button_id] - An ID for custom button.
  @param {string} [custom_button_label] - The label for the custom button.
  @param {string} [enable_collect_customer_name] - Whether to include first and last name fields.
  @param {string} [form_tags] - Tags to submit with the form. Default is 'newsletter'.
  @param {string} [email_placeholder] - Overrides the email field's label/placeholder text. Defaults to the shared general.newsletter_form.email_placeholder translation (used by every other caller of this snippet) when not given.
{%- enddoc -%}

{%- liquid
  assign form_class = base_class | append: '-form'
  assign additional_form_classes = additional_form_classes | default: ''

  if additional_form_classes != ''
    assign form_class = form_class | append: ' ' | append: additional_form_classes
  endif

  assign button_wrapper_class = base_class | append: '-button'
  assign form_tags = form_tags | default: 'newsletter'
  assign default_success_msg = 'general.newsletter_form.confirmation' | t
  assign success_msg = success_msg | default: default_success_msg

  if email_placeholder
    assign email_placeholder_text = email_placeholder
  else
    assign email_placeholder_text = 'general.newsletter_form.email_placeholder' | t
  endif
-%}

{%- form 'customer', class: form_class, id: form_id -%}
  {%- render 'form-status', form: form, form_id: form_id, success_message: success_msg -%}

  {%- unless form.posted_successfully? -%}
    <div class="{{ base_class }}-inner">
      <input type="hidden" name="contact[tags]" value="{{ form_tags }}">

      {%- if enable_collect_customer_name -%}
        <div class="{{ base_class }}-name">
          <label for="{{ form_id }}-first-name" class="visually-hidden">
            {{- 'general.newsletter_form.first_name_placeholder' | t -}}
          </label>

          <input
            type="text"
            id="{{ form_id }}-first-name"
            class="input {{ base_class }}-input"
            name="contact[first_name]"
            value="{% if customer.first_name != blank %}{{ customer.first_name }}{% endif %}"
            placeholder="{{ 'general.newsletter_form.first_name_placeholder' | t }}"
            autocorrect="off"
            autocapitalize="off"
            required
          >

          <label for="{{ form_id }}-last-name" class="visually-hidden">
            {{- 'general.newsletter_form.last_name_placeholder' | t -}}
          </label>

          <input
            type="text"
            id="{{ form_id }}-last-name"
            class="input {{ base_class }}-input"
            name="contact[last_name]"
            value="{% if customer.last_name != blank %}{{ customer.last_name }}{% endif %}"
            placeholder="{{ 'general.newsletter_form.last_name_placeholder' | t }}"
            autocorrect="off"
            autocapitalize="off"
            required
          >
        </div>
      {%- endif -%}

      <div class="{{ base_class }}-email">
        <label for="{{ form_id }}-email" class="visually-hidden">
          {{- email_placeholder_text -}}
        </label>

        <input
          type="email"
          id="{{ form_id }}-email"
          class="input {{ base_class }}-input"
          name="contact[email]"
          value="{% if customer.email != blank %}{{ customer.email }}{% endif %}"
          placeholder="{{ email_placeholder_text }}"
          autocorrect="off"
          autocapitalize="off"
          required
        >

        {%- if custom_button -%}
          {%- # Floating button used for password and footer signup forms. -%}
          <button type="submit" name="commit" id="{{ custom_button_id }}" class="{{ custom_button_class }}">
            {{- custom_button_label -}}
          </button>
        {%- else -%}
          {%- render 'button-block',
            label: button_label,
            allow_linkless: true,
            type: 'submit',
            is_full: true,
            wrapper_class: button_wrapper_class
          -%}
        {%- endif -%}
      </div>
    </div>
  {%- endunless -%}
{%- endform -%}
