{%- doc -%}
  Renders the mobile filter display.

  @param {object} resource - The collection or search object.
  @param {boolean} show_sort - Whether to show the sort selector.
  @param {boolean} show_filters - Whether to show filters.
  @param {boolean} enable_sticky_filter_bar - Whether the filter bar should be sticky.
  @param {number} active_filter_count - The number of active filters.
{%- enddoc -%}

{%- liquid
  if resource.filters != empty and show_filters
    assign filters_valid = true
  else
    assign filters_valid = false
  endif

  if active_filter_count > 0
    assign filters_active = true
  else
    assign filters_active = false
  endif

  capture mobile_filters_class
    echo 'mobile-filters active'

    if enable_sticky_filter_bar
      echo ' mobile-filters--sticky'
    endif

    if filters_valid and show_sort
      echo ' mobile-filters--has-grid'
    endif

    if filters_valid or show_sort
      echo ' show'
    endif

    echo ' animation--mobile-filters'
  endcapture
-%}

<div
  class="{{ mobile_filters_class }}"
  data-mobile-filters
>
  {%- if filters_valid -%}
    <div class="mobile-filters__group" data-group="{{ 'filters.title' | t }}">
      <button
        type="button"
        class="mobile-filters__button"
        data-mobile-filters-toggle
        data-filter-drawer-target="__tags"
        data-tags-dropdown
      >
        {%- render 'icon', icon: 'filter' -%}

        {{- 'filters.title' | t -}}

        {%- if filters_active -%}
          <span class="mobile-filters__button-count">{{ active_filter_count }}</span>
        {%- endif -%}
      </button>
    </div>
  {%- endif -%}

  {%- if show_sort -%}
    <div class="mobile-filters__group" data-group="{{ 'filters.sort_title' | t }}">
      <button type="button" class="mobile-filters__button" data-filter-drawer-target="__sort" data-sort-dropdown>
        {%- render 'icon', icon: 'sort' -%}

        {{- 'filters.sort_title' | t -}}
      </button>
    </div>
  {%- endif -%}
</div>
