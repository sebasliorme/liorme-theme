{%- liquid
  assign mobile_items = ''
  assign tab_buttons = ''
  assign tab_content = ''
-%}

{%- for block in section.blocks -%}
  {%- liquid
    if forloop.first
      assign open = true
    else
      assign open = false
    endif

    capture block_content
      render 'product-tabs-item', block: block
    endcapture
  -%}

  {%- capture mobile_items -%}
    {{- mobile_items -}}

    {%- render 'product-block-accordion',
      block: block,
      heading: block.settings.tab_heading,
      content: block_content,
      expand_by_default: open,
      disable_rte: true,
      label_font: section.settings.tab_font_choice,
      label_size: section.settings.tab_font_class
    -%}
  {%- endcapture -%}

  {%- capture tab_buttons -%}
    {{- tab_buttons -}}

    {%- if block_content != blank -%}
      <li>
        <button
          type="button"
          class="product-tabs__tab-button"
          aria-expanded="{%- if open -%}true{%- else -%}false{%- endif -%}"
          aria-controls="product-tab--{{ block.id }}"
          data-tab-label
          {{ block.shopify_attributes }}
        >
          <span class="{{ section.settings.tab_font_choice }} {{ section.settings.tab_font_class }}">
            {{- block.settings.tab_heading -}}
          </span>

          <span class="indicator"></span>
        </button>
      </li>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture tab_content -%}
    {{- tab_content -}}

    {%- if block_content != blank -%}
      <li
        id="product-tab--{{ block.id }}"
        class="product-tabs__tab-item {%- if open %} active{%- endif -%}"
        aria-hidden="{%- if open -%}false{%- else -%}true{%- endif -%}"
        data-tab-item
      >
        {{- block_content -}}
      </li>
    {%- endif -%}
  {%- endcapture -%}
{%- endfor -%}

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    product-tabs
    product-tabs--{{ section.settings.tab_alignment }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--product-tabs
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="product-tabs"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
    --tab-spacing: {{ section.settings.tab_spacing }}px;
  "
>
  <div class="product-tabs__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    <div class="product-tabs__tab-buttons">
      {{- tab_buttons -}}
    </div>

    <div class="product-tabs__tab-list-wrapper">
      <ul class="product-tabs__tab-list" data-tab-list>
        {{- tab_content -}}
      </ul>
    </div>

    <div class="product-tabs__mobile-accordions" data-auto-collapse="{{ section.settings.auto_collapse_rows }}">
      {%- if section.settings.auto_collapse_rows == true -%}
        <div class="product-tabs-accordion-group">{{ mobile_items }}</div>
      {%- else -%}
        {{- mobile_items -}}
      {%- endif -%}
    </div>
  </div>
</div>

