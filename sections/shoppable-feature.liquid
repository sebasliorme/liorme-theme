    },
    {
      "type": "header",
      "content": "t:sections.shoppable_feature.settings.content.header.content"
    },
    {
      "type": "select",
      "id": "content_position_desktop",
      "label": "t:sections.shoppable_feature.settings.content.content_position_desktop.label",
      "options": [
        {
          "value": "inside",
          "label": "t:sections.shoppable_feature.settings.content.content_position_desktop.options.inside"
        },
        {
          "value": "outside",
