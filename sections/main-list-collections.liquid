          "label": "t:sections.main_list_collections.settings.display_type.options.selected"
        }
      ]
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:sections.shared.collections.settings.collection_list.collection_list.label"
    },
    {
      "type": "select",
