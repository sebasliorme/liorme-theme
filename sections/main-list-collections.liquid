{%- liquid
  assign per_page = section.settings.rows | times: section.settings.columns

  if section.settings.display_type == 'all'
    assign paginated = true
  else
    assign paginated = false
  endif

  capture image_sizes
    echo '(min-width: 720px) calc(calc(100vw - calc(2 * clamp(18px, 3.3vw, 3.3vw))) / [[ssc]]),' | replace: '[[ssc]]', section.settings.columns
    echo ' calc(calc(100vw - calc(2 * clamp(18px, 3.3vw, 3.3vw))) / [[ssmc]])' | replace: '[[ssmc]]', section.settings.mobile_columns
  endcapture
-%}

{%- paginate collections by per_page -%}
  <div
    class="
      section
      section--divider-{{ section.settings.divider_style }}
      section--divider-full-width-{{ section.settings.enable_full_width_divider }}
      list-collections
      list-collections--mobile-per-view-{{ section.settings.mobile_columns }}
      list-collections--per-view-{{ section.settings.columns }}
      list-collections--item-label-style-{{ section.settings.label_style }}
      page
      {% if settings.enable_section_animations and section.settings.enable_animation -%}
        animation
        animation--list-collections
      {%- endif -%}
    "
    style="
      {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
      {%- render 'section-padding-vars' -%}
    "
    data-section-id="{{ section.id }}"
    data-section-type="list-collections"
    data-collection-columns="{{ section.settings.columns }}"
    data-mobile-collection-columns="{{ section.settings.mobile_columns }}"
  >
    <div
      class="
        list-collections__inner
        page__inner
        section-inner
        section-inner--width-{{ section.settings.section_width }}
      "
    >
      <header
        class="
          list-collections__header
          list-collections__header--alignment-{{ section.settings.header_alignment }}
          page__header
        "
      >
        <h1 class="list-collections__heading ff-heading {{ section.settings.heading_font_class }} ta-c">
          {{- page_title -}}
        </h1>
      </header>

      <div class="list-collections__grid">
        {%- if section.settings.display_type == 'all' -%}
          {%- for collection in collections -%}
            {%- render 'collection-item',
              collection: collection,
              aspect_ratio: section.settings.collection_listing_aspect_ratio,
              label_font: section.settings.label_font,
              label_size: section.settings.label_size,
              label_style: section.settings.label_style,
              overlay_title_background_style: section.settings.overlay_title_background_style,
              overlay_color_scheme: section.settings.overlay_color_scheme,
              image_sizes: image_sizes
            -%}
          {%- endfor -%}
        {%- else -%}
          {%- for collection_item in section.settings.collection_list -%}
            {%- render 'collection-item',
              collection: collection_item,
              aspect_ratio: section.settings.collection_listing_aspect_ratio,
              label_font: section.settings.label_font,
              label_size: section.settings.label_size,
              label_style: section.settings.label_style,
              overlay_title_background_style: section.settings.overlay_title_background_style,
              overlay_color_scheme: section.settings.overlay_color_scheme,
              image_sizes: image_sizes
            -%}
          {%- else -%}
            {%- for i in (1..per_page) -%}
              {%- render 'collection-item',
                collection: collection,
                placeholder: true,
                aspect_ratio: section.settings.collection_listing_aspect_ratio,
                label_font: section.settings.label_font,
                label_size: section.settings.label_size,
                label_style: section.settings.label_style,
                overlay_title_background_style: section.settings.overlay_title_background_style,
                overlay_color_scheme: section.settings.overlay_color_scheme,
                image_sizes: image_sizes
              -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if paginated -%}
        <div>
          {%- liquid
            if paginate.pages > 1
              render 'pagination', paginate: paginate, type: 'general.pagination.collections', show_item_count: true
            else
              render 'pagination', paginate: paginate, type: 'general.pagination.collections', display_paginate_item_count_only: true
            endif
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

