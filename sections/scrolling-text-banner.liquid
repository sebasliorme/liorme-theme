      "content": "t:sections.scrolling_text_banner.settings.layout.header.content"
    },
    {
      "type": "select",
      "id": "layout_scrolling_content_position_desktop",
      "label": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.label",
      "info": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.info",
      "options": [
        {
          "value": "top",
          "label": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.options.pin_to_top"
        },
        {
          "value": "middle",
          "label": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.options.middle"
        },
        {
          "value": "bottom",
          "label": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.options.pin_to_bottom"
        }
      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "layout_content_alignment_desktop",
      "label": "t:sections.scrolling_text_banner.settings.layout.content_alignment.label",
      "options": [
        {
          "value": "flex-start",
          "label": "t:sections.scrolling_text_banner.settings.layout.content_alignment.options.top"
        },
        {
          "value": "center",
          "label": "t:sections.scrolling_text_banner.settings.layout.content_alignment.options.middle"
        },
        {
          "value": "flex-end",
          "label": "t:sections.scrolling_text_banner.settings.layout.content_alignment.options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.scrolling_text_banner.settings.layout.header.content_mobile"
    },
    {
      "type": "select",
      "id": "layout_scrolling_content_position_mobile",
      "label": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.label_mobile",
      "info": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.info",
      "options": [
        {
          "value": "top",
          "label": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.options.pin_to_top"
        },
        {
          "value": "middle",
          "label": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.options.middle"
        },
        {
          "value": "bottom",
          "label": "t:sections.scrolling_text_banner.settings.layout.scrolling_content_position.options.pin_to_bottom"
        }
      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "layout_content_alignment_mobile",
      "label": "t:sections.scrolling_text_banner.settings.layout.content_alignment.label_mobile",
      "options": [
        {
          "value": "flex-start",
          "label": "t:sections.scrolling_text_banner.settings.layout.content_alignment.options.top"
        },
        {
          "value": "center",
          "label": "t:sections.scrolling_text_banner.settings.layout.content_alignment.options.middle"
        },
        {
          "value": "flex-end",
          "label": "t:sections.scrolling_text_banner.settings.layout.content_alignment.options.bottom"
        }
      ],
