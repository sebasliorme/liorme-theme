<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    contact-form
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--contact-form
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="contact-form"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
    {% if section.settings.content_width == 'custom' %}
      --custom-content-width: {{ section.settings.custom_content_width }}px;
    {% endif %}
  "
>
  <div class="section-inner section-inner--width-{{ section.settings.section_width }}">
    <div class="contact-form__inner">
      {%- liquid
        render 'section-header', local_settings: section.settings, custom_class_prefix: 'contact-form', has_button: false

        assign form_id = 'ContactForm-' | append: section.id
      -%}

      {%- form 'contact', class: 'contact-form__form', id: form_id -%}
        {%- assign success_msg = 'contact.form.post_success' | t -%}

        {%- render 'form-status',
          form: form,
          form_id: form_id,
          success_message: success_msg,
          success_alignment: section.settings.header_alignment
        -%}

        {%- unless form.posted_successfully? -%}
          <div class="contact-form__wrapper animation--item">
            {%- assign existing_keys = 'email' -%}

            {%- for block in section.blocks -%}
              {%- liquid
                assign input_id = 'contact-ContactForm-' | append: block.id

                if block.type == 'email'
                  assign input_id = form_id | append: '-email'
                endif

                assign existing_keys_array = existing_keys | split: '|'
                assign key = block.settings.title | escape | default: block.type

                if existing_keys_array contains key
                  for i in (1..50)
                    assign unique_key = key | append: '-' | append: i

                    unless existing_keys_array contains unique_key
                      break
                    endunless
                  endfor

                  assign key = unique_key
                endif

                assign existing_keys = existing_keys | append: '|' | append: key
                assign input_name = 'contact[' | append: key | append: ']'
                assign block_is_required = false

                if block.settings.required or block.type == 'email'
                  assign block_is_required = true
                endif
              %}

              {%- capture label -%}
                {%- unless block.settings.title == blank -%}
                  <label for="{{ input_id }}">
                    {{- block.settings.title -}}

                    {%- if block_is_required -%}
                      <span aria-hidden="true">*</span>
                    {%- endif -%}
                  </label>
                {%- endunless -%}
              {%- endcapture -%}

              {%- liquid
                capture required
                  if block_is_required
                    echo 'required aria-required="true"'
                  endif
                endcapture

                capture width_class
                  if block.settings.width == 'full'
                    echo 'contact-form__item--full-width'
                  endif
                endcapture
              -%}

              {%- case block.type -%}
                {%- when 'email' -%}
                  {%- assign has_email_block = true -%}

                  <div
                    class="
                      contact-form__input-wrapper
                      animation--item
                      {{ width_class }}
                    "
                    {{ block.shopify_attributes }}
                  >
                    {{- label -}}

                    <input
                      type="email"
                      id="{{ input_id }}"
                      class="input{% if form.errors contains 'email' %} has-errors{% endif %}"
                      name="contact[email]"
                      autocomplete="email"
                      spellcheck="false"
                      autocapitalize="off"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      {{ required }}
                      {% if form.errors contains 'email' -%}
                        aria-invalid="true"
                        aria-describedby="ContactForm-email-error"
                      {%- endif -%}
                    >
                  </div>
                {%- when 'text' -%}
                  <div
                    class="
                      contact-form__input-wrapper
                      animation--item
                      {{ width_class }}
                    "
                    {{ block.shopify_attributes }}
                  >
                    {{- label -}}

                    <input
                      type="text"
                      id="{{ input_id }}"
                      class="input"
                      name="{{ input_name }}"
                      value=""
                      {{ required }}
                    >
                  </div>
                {%- when 'text_area' -%}
                  <div
                    class="
                      contact-form__input-wrapper
                      animation--item
                      {{ width_class }}
                    "
                    {{ block.shopify_attributes }}
                  >
                    {{- label -}}

                    <textarea
                      id="{{ input_id }}"
                      class="input"
                      name="{{ input_name }}"
                      rows="5"
                      placeholder="{{ block.settings.placeholder | escape }}"
                      {{ required }}
                      style="height: {{ block.settings.height }}px"
                    ></textarea>
                  </div>
                {%- when 'telephone' -%}
                  <div
                    class="
                      contact-form__input-wrapper
                      animation--item
                      {{ width_class }}
                    "
                    {{ block.shopify_attributes }}
                  >
                    {{- label -}}

                    <input
                      type="tel"
                      id="{{ input_id }}"
                      class="input"
                      name="{{ input_name }}"
                      value=""
                      pattern="[0-9\-]*"
                      {{ required }}
                    >
                  </div>
                {%- when 'heading' -%}
                  <{{ block.settings.heading_tag }}
                    class="
                      contact-form__item--full-width
                      contact-form__heading-block
                      {{ block.settings.title_font_choice }}
                      {{ block.settings.title_font_class }}
                      animation--item
                    "
                    style="--heading-alignment: {{ block.settings.alignment }}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.title -}}
                  </{{ block.settings.heading_tag }}>
                {%- when 'paragraph' -%}
                  <div
                    class="
                      contact-form__item--full-width
                      contact-form__paragraph
                      rte
                      animation--item
                    "
                    style="--text-alignment: {{ block.settings.alignment }}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.text -}}
                  </div>
                {%- when 'spacer' -%}
                  <div
                    class="
                      contact-form__item--full-width
                      contact-form__spacer
                      contact-form__spacer--{{ block.settings.size }}
                      {% if block.settings.show_divider -%}
                        contact-form__spacer--show-divider
                        animation--item
                      {%- endif -%}
                    "
                    {{ block.shopify_attributes }}
                  ></div>
                {%- when 'checkbox' -%}
                  <div
                    class="
                      contact-form__input-wrapper
                      animation--item
                      {{ width_class }}
                    "
                    {{ block.shopify_attributes }}
                  >
                    <label
                      class="contact-form__checkbox-label"
                      for="{{ input_id }}"
                    >
                      <div class="contact-form-checkbox">
                        <input
                          type="checkbox"
                          id="{{ input_id }}"
                          class="contact-form-checkbox__checkbox visually-hidden"
                          name="{{ input_name }}"
                          {{ required }}
                        >
                        <div class="contact-form-checkbox__content-inner">
                          <div class="contact-form-checkbox__input">
                            {%- render 'icon', icon: 'checkmark' -%}
                          </div>
                        </div>
                      </div>

                      {%- unless block.settings.title == blank -%}
                        <div
                          class="contact-form__checkbox-label-text"
                          for="{{ input_id }}"
                        >
                          {{- block.settings.title -}}

                          {%- if block.settings.required -%}
                            <span aria-hidden="true">*</span>
                          {%- endif -%}
                        </div>
                      {%- endunless -%}
                    </label>
                  </div>
                {%- when 'select' -%}
                  <div
                    class="
                      contact-form__input-wrapper
                      animation--item
                      {{ width_class }}
                    "
                    {{ block.shopify_attributes }}
                  >
                    {{- label -}}

                    <div class="select-wrapper">
                      <select
                        type="checkbox"
                        id="{{ input_id }}"
                        class="input"
                        name="{{ input_name }}"
                        {{ required }}
                      >
                        {%- for i in (1..10) -%}
                          {%- liquid
                            assign key = 'option_' | append: i

                            if block.settings[key] == blank
                              continue
                            endif
                          -%}

                          <option value="{{ block.settings[key] | escape }}">
                            {{- block.settings[key] -}}
                          </option>
                        {%- endfor -%}
                      </select>

                      {%- render 'icon', icon: 'chevron-small' -%}
                    </div>
                  </div>
                {%- when 'radio' -%}
                  <div
                    class="
                      contact-form__input-wrapper
                      animation--item
                      {{ width_class }}
                    "
                    {{ block.shopify_attributes }}
                  >
                    {%- unless block.settings.title == blank -%}
                      <div class="contact-form__radio-label">
                        {{- block.settings.title -}}

                        {%- if block.settings.required -%}
                          <span aria-hidden="true">*</span>
                        {%- endif -%}
                      </div>
                    {%- endunless -%}

                    {%- for i in (1..10) -%}
                      {%- liquid
                        assign key = 'option_' | append: i

                        if block.settings[key] == blank
                          continue
                        endif

                        assign radio_input_id = input_id | append: key
                      -%}

                      <label for="{{ radio_input_id }}">
                        <input
                          type="radio"
                          id="{{ radio_input_id }}"
                          class="contact-form__radio-input visually-hidden"
                          name="{{ input_name }}"
                          value="{{ block.settings[key] | escape }}"
                          {{ required }}
                        >

                        <div class="contact-form__radio-input-content">
                          <div class="contact-form__radio-input-button">
                            <div class="contact-form__radio-input-indicator"></div>
                          </div>
                          <span class="contact-form__radio-input-label">{{ block.settings[key] }}</span>
                        </div>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- when 'submit' -%}
                  {%- assign has_submit_block = true -%}

                  <div
                    class="
                      contact-form__input-wrapper
                      animation--item
                      {% if block.settings.full_width -%}contact-form__item--full-width{%- endif -%}
                    "
                    {{ block.shopify_attributes }}
                  >
                    <button
                      type="submit"
                      class="
                        contact-form__button
                        btn
                        btn--primary
                        btn--{{ block.settings.size }}
                        {% if block.settings.full_width %}contact-form__button--full-width{% endif %}
                      "
                    >
                      {{- block.settings.title -}}
                    </button>
                  </div>
              {%- endcase -%}

              {%- if forloop.last -%}
                {%- unless has_email_block -%}
                  <div
                    class="
                      contact-form__input-wrapper
                      animation--item
                      contact-form__item--full-width
                    "
                  >
                    {%- assign input_id = form_id | append: '-email' -%}

                    <label for="input_id">
                      {{ 'contact.form.email' | t }}
                      <span aria-hidden="true">*</span>
                    </label>

                    <input
                      type="email"
                      id="{{ input_id }}"
                      class="input{% if form.errors contains 'email' %} has-errors{% endif %}"
                      name="contact[email]"
                      autocomplete="email"
                      spellcheck="false"
                      autocapitalize="off"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      required
                      {% if form.errors contains 'email' -%}
                        aria-invalid="true"
                        aria-describedby="ContactForm-email-error"
                      {%- endif -%}
                    >
                  </div>
                {%- endunless -%}

                {%- unless has_submit_block -%}
                  <div class="animation--item">
                    <button type="submit" class="contact-form__button btn btn--primary">
                      {{- 'contact.form.submit' | t -}}
                    </button>
                  </div>
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if section.settings.show_recaptcha_terms -%}
            <div class="contact-form__recaptcha-terms rte ff-body fs-body-50 animation--item">
              {{- 'contact.form.recaptcha_terms_html' | t -}}
            </div>
          {%- endif -%}
        {%- endunless -%}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "radio",
      "id": "content_width",
      "label": "t:shared.settings.content_width.label",
      "options": [
        {
          "value": "full",
          "label": "t:shared.settings.content_width.options.full"
        },
        {
          "value": "custom",
          "label": "t:shared.settings.content_width.options.custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_content_width",
      "label": "t:shared.settings.custom_content_width.label",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 700,
      "info": "t:shared.settings.custom_content_width.info",
      "visible_if": "{{ section.settings.content_width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:shared.section_header.header.content"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:shared.settings.alignment_horizontal.header.label",
      "options": [
        {
          "value": "left",
          "label": "t:shared.options.alignment.horizontal.left"
        },
        {
          "value": "center",
          "label": "t:shared.options.alignment.horizontal.center"
        },
        {
          "value": "right",
          "label": "t:shared.options.alignment.horizontal.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.contact_form.settings.title.label",
      "default": "t:sections.contact_form.settings.title.default"
    },
    {
      "type": "select",
      "id": "heading_font_class",
      "label": "t:shared.settings.heading_font_class.label",
      "options": [
        {
          "value": "fs-heading-6-base",
          "label": "t:shared.settings.heading_font_class.options.xx_small"
        },
        {
          "value": "fs-heading-5-base",
          "label": "t:shared.settings.heading_font_class.options.x_small"
        },
        {
          "value": "fs-heading-4-base",
          "label": "t:shared.settings.heading_font_class.options.small"
        },
        {
          "value": "fs-heading-3-base",
          "label": "t:shared.settings.heading_font_class.options.medium"
        },
        {
          "value": "fs-heading-2-base",
          "label": "t:shared.settings.heading_font_class.options.large"
        },
        {
          "value": "fs-heading-1-base",
          "label": "t:shared.settings.heading_font_class.options.x_large"
        },
        {
          "value": "fs-heading-display-3",
          "label": "t:shared.settings.heading_font_class.options.display_regular"
        },
        {
          "value": "fs-heading-display-2",
          "label": "t:shared.settings.heading_font_class.options.display_large"
        },
        {
          "value": "fs-heading-display-1",
          "label": "t:shared.settings.heading_font_class.options.display_x_large"
        }
      ],
      "default": "fs-heading-3-base"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:shared.settings.heading_tag.heading.label",
      "options": [
        {
          "value": "h2",
          "label": "t:shared.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:shared.settings.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:shared.settings.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:shared.settings.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:shared.settings.heading_tag.options.h6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "paragraph",
      "content": "t:shared.settings.heading_tag.heading.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.contact_form.settings.text.label"
    },
    {
      "type": "select",
      "id": "text_font_class",
      "label": "t:shared.settings.text_font_class.label",
      "options": [
        {
          "value": "fs-body-25",
          "label": "t:shared.settings.text_font_class.options.xx_small"
        },
        {
          "value": "fs-body-50",
          "label": "t:shared.settings.text_font_class.options.x_small"
        },
        {
          "value": "fs-body-75",
          "label": "t:shared.settings.text_font_class.options.small"
        },
        {
          "value": "fs-body-100",
          "label": "t:shared.settings.text_font_class.options.regular"
        },
        {
          "value": "fs-body-150",
          "label": "t:shared.settings.text_font_class.options.large"
        },
        {
          "value": "fs-body-200",
          "label": "t:shared.settings.text_font_class.options.x_large"
        },
        {
          "value": "fs-body-250",
          "label": "t:shared.settings.text_font_class.options.2x_large"
        },
        {
          "value": "fs-body-300",
          "label": "t:shared.settings.text_font_class.options.3x_large"
        },
        {
          "value": "fs-body-350",
          "label": "t:shared.settings.text_font_class.options.4x_large"
        },
        {
          "value": "fs-body-400",
          "label": "t:shared.settings.text_font_class.options.5x_large"
        }
      ],
      "default": "fs-body-100"
    },
    {
      "type": "checkbox",
      "id": "show_recaptcha_terms",
      "label": "t:sections.contact_form.settings.show_recaptcha_terms.label",
      "default": true,
      "info": "t:sections.contact_form.settings.show_recaptcha_terms.info"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:shared.settings.section_style.section_width.label",
      "options": [
        {
          "value": "page-width",
          "label": "t:shared.settings.section_style.section_width.options.page_width"
        },
        {
          "value": "full-width-padded",
          "label": "t:shared.settings.section_style.section_width.options.full_width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:shared.settings.section_style.section_padding.top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:shared.settings.section_style.section_padding.bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.settings.section_style.divider_style.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.settings.section_style.divider_style.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_divider",
      "label": "t:shared.settings.section_style.enable_full_width_divider.label",
      "visible_if": "{{ section.settings.divider_style == 'solid' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "default": true,
      "info": "t:shared.settings.section_style.enable_animation.info"
    }
  ],
  "blocks": [
    {
      "type": "email",
      "name": "t:sections.contact_form.blocks.email.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.contact_form.blocks.shared.settings.label.label",
          "default": "t:sections.contact_form.blocks.email.settings.title.default"
        },
        {
          "type": "radio",
          "id": "width",
          "label": "t:sections.contact_form.blocks.shared.settings.width.label",
          "options": [
            {
              "value": "full",
              "label": "t:sections.contact_form.blocks.shared.settings.width.options.full"
            },
            {
              "value": "half",
              "label": "t:sections.contact_form.blocks.shared.settings.width.options.half"
            }
          ],
          "default": "full",
          "info": "t:sections.contact_form.blocks.shared.settings.width.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.contact_form.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.contact_form.blocks.shared.settings.label.label",
          "default": "t:sections.contact_form.blocks.text.settings.title.default"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:sections.contact_form.blocks.shared.settings.required.label"
        },
        {
          "type": "radio",
          "id": "width",
          "label": "t:sections.contact_form.blocks.shared.settings.width.label",
          "options": [
            {
              "value": "full",
              "label": "t:sections.contact_form.blocks.shared.settings.width.options.full"
            },
            {
              "value": "half",
              "label": "t:sections.contact_form.blocks.shared.settings.width.options.half"
            }
          ],
          "default": "full",
          "info": "t:sections.contact_form.blocks.shared.settings.width.info"
        }
      ]
    },
    {
      "type": "text_area",
      "name": "t:sections.contact_form.blocks.text_area.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.contact_form.blocks.shared.settings.label.label",
          "default": "t:sections.contact_form.blocks.text_area.settings.title.default"
        },
        {
          "type": "textarea",
          "id": "placeholder",
          "label": "t:sections.contact_form.blocks.text_area.settings.placeholder.label",
          "default": "t:sections.contact_form.blocks.text_area.settings.placeholder.default"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:sections.contact_form.blocks.shared.settings.required.label"
        },
        {
          "type": "range",
          "id": "height",
          "label": "t:sections.contact_form.blocks.text_area.settings.height.label",
          "min": 120,
          "max": 250,
          "step": 5,
          "unit": "px",
          "default": 180
        },
        {
          "type": "radio",
          "id": "width",
          "label": "t:sections.contact_form.blocks.shared.settings.width.label",
          "options": [
            {
              "value": "full",
              "label": "t:sections.contact_form.blocks.shared.settings.width.options.full"
            },
            {
              "value": "half",
              "label": "t:sections.contact_form.blocks.shared.settings.width.options.half"
            }
          ],
          "default": "full",
          "info": "t:sections.contact_form.blocks.shared.settings.width.info"
        }
      ]
    },
    {
      "type": "telephone",
      "name": "t:sections.contact_form.blocks.telephone.name",
      "settings": [
        {
