{% comment %}Collection product cards: reference spacing, type and swatches, 2026-09-22.{% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500&display=swap">
<style>
  #shopify-section-{{ section.id }} .collection__products {
    --collection-card-gap-desktop: 1px;
    --collection-card-gap-mobile: 1px;
    gap: 1px !important;
  }
  #shopify-section-{{ section.id }} .collection__products .product-item {
    background: #fff;
    border-radius: 0;
  }
  #shopify-section-{{ section.id }} .product-item__meta {
    padding: 0 !important;
    margin: 0 !important;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .product-item__text {
    padding: 16px 16px 32px !important;
    text-align: left !important;
    color: #000;
  }
  #shopify-section-{{ section.id }} .product-item__product-title,
  #shopify-section-{{ section.id }} .product-item__product-title a {
    font-family: "Work Sans", sans-serif !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    line-height: 16px !important;
    letter-spacing: normal !important;
    text-transform: none !important;
    color: #000 !important;
    padding: 0 !important;
    white-space: normal !important;
    -webkit-line-clamp: unset !important;
    overflow: visible !important;
  }
  #shopify-section-{{ section.id }} .product-item__product-title {
    margin: 0 0 8px !important;
  }
  #shopify-section-{{ section.id }} .product-item__price {
    font-family: "Work Sans", sans-serif !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    line-height: 16px !important;
    letter-spacing: normal !important;
    color: #000 !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  #shopify-section-{{ section.id }} .product-item__variant-info {
    margin: 8px 0 0 !important;
  }
  #shopify-section-{{ section.id }} .product-swatches-options__list {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 4px !important;
    height: 12px !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  #shopify-section-{{ section.id }} .product-swatches-options__item--swatch {
    width: 8px !important;
    height: 8px !important;
    min-width: 8px !important;
    border-radius: 50% !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  #shopify-section-{{ section.id }} .product-badges {
    top: 8px !important;
    left: 8px !important;
  }
  #shopify-section-{{ section.id }} .product-badges * {
    font-family: "Work Sans", sans-serif !important;
    font-size: 11px !important;
    line-height: 14px !important;
    font-weight: 400 !important;
  }
</style>

<style>
  #shopify-section-{{ section.id }} .collection__products .product-item::after { border: 0 !important; }
  #shopify-section-{{ section.id }} .product-item-size-picker,
  #shopify-section-{{ section.id }} .product-item__quick-view--hoverless { display: none !important; }
</style>
