<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    section--enable-mobile-padding-{{ section.settings.enable_padding_on_mobile }}
    grid
    {% if section.settings.spacing == 0 -%}
      grid--no-spacing
    {%- endif %}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--grid
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
    --grid-spacing: {{ section.settings.spacing }}px;
  "
  data-section-id="{{ section.id }}"
  data-section-type="grid"
>
  <div class="section-inner section-inner--width-{{ section.settings.section_width }} section-inner--mobile-full-width-{{ section.settings.enable_full_width_on_mobile }}">
    <div class="grid__header">
      {%- render 'section-header', local_settings: section.settings, custom_class_prefix: 'grid', has_button: false -%}
    </div>

    <div class="grid__inner grid__inner--outer-spacing-{{ section.settings.enable_outer_spacing }}">
      {%- liquid
        comment
          For the case that corner rounding is applied, but the section is full-width, we need to
          be able to round only the inner corners of grid items. Breaking out the rows allows us to
          directly target the first and last children of the row, rather than trying to cover an
          impossible amount of grid item combinations.
        endcomment
      -%}
      <div class="grid__row">
        {%- liquid
          comment
            Each row is a 24-column grid (see grid.css). Widths map to even spans so that a
            row which doesn't fill the full width can be centered: we look ahead to total the
            row's columns and offset the first item by half of the remaining columns.
          endcomment

          assign row_width = 0

          for block in section.blocks
            case block.settings.width
              when '25'
                assign block_columns = 6
              when '33'
                assign block_columns = 8
              when '50'
                assign block_columns = 12
              when '66'
                assign block_columns = 16
              when '75'
                assign block_columns = 18
              else
                assign block_columns = 24
            endcase

            assign new_width = row_width | plus: block_columns

            unless forloop.first
              if new_width > 24
                echo '</div><div class="grid__row">'
                assign row_width = 0
                assign new_width = block_columns
              endif
            endunless

            if row_width == 0
              assign row_columns = 0

              for sibling in section.blocks offset: forloop.index0
                case sibling.settings.width
                  when '25'
                    assign sibling_columns = 6
                  when '33'
                    assign sibling_columns = 8
                  when '50'
                    assign sibling_columns = 12
                  when '66'
                    assign sibling_columns = 16
                  when '75'
                    assign sibling_columns = 18
                  else
                    assign sibling_columns = 24
                endcase

                assign sibling_total = row_columns | plus: sibling_columns
                if sibling_total > 24
                  break
                endif
                assign row_columns = sibling_total
              endfor

              assign column_start = 24 | minus: row_columns | divided_by: 2 | plus: 1
              assign row_is_full_width = false
              if row_columns == 24
                assign row_is_full_width = true
              endif

              render 'grid-item', block: block, column_start: column_start, row_is_full_width: row_is_full_width
            else
              render 'grid-item', block: block, row_is_full_width: row_is_full_width
            endif

            assign row_width = new_width
          endfor
        -%}
      </div>
    </div>
  </div>
</div>

