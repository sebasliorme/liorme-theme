{%- liquid
  capture image_max_width
    case section.settings.image_width
      when 'custom'
        echo '[[ciw]]px' | replace: '[[ciw]]', section.settings.custom_image_width
      when 'full'
        echo '100%'
    endcase
  endcapture

  # If there's a card/image radius, we want to ensure that the before/after labels get a radius as well
  assign reduced_card_and_image_radius = settings.corner_radius_cards_and_images | divided_by: 2

  if settings.corner_radius_type_badges == 'square'
    assign badge_radius = 0
  else
    assign badge_radius = settings.corner_radius_badges
  endif
-%}

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    image-compare
    image-compare--{{ section.settings.aspect_ratio }}
    image-compare--{{ section.settings.reveal_direction }}
    image-compare--image-{{ section.settings.image_position }}
    image-compare--justify-{{ section.settings.content_alignment }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--image-compare
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
    --slider-color: {{ section.settings.slider_color }};
    --slider-arrows-color: {{ section.settings.slider_arrows_color }};
    --image-max-width: {{ image_max_width }};
    {% if badge_radius < reduced_card_and_image_radius -%}
      --corner-radius-badges: {{ reduced_card_and_image_radius }}px;
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="image-compare"
>
  <div class="image-compare__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    <div class="image-compare__text-container">
      <div class="image-compare__text-container-inner">
        {%- render 'section-header',
          local_settings: section.settings,
          alignment_type: 'content',
          custom_class_prefix: 'image-compare'
        -%}
      </div>
    </div>

    <div class="image-compare__image-container">
      <div class="image-compare__image-container-inner">
        {%- for block in section.blocks -%}
          {%- liquid
            assign text_position = block.settings.text_position | split: '_'
            assign horizontal_position = text_position | first
            assign vertical_position = text_position | last

            case block.settings.filter_effect
              when 'blur'
                assign filter_amount = block.settings.filter_amount | divided_by: 25.0 | append: 'px'
              when 'brightness', 'contrast', 'saturate'
                assign filter_amount = block.settings.filter_amount | divided_by: 50.0
              when 'grayscale', 'invert', 'sepia'
                assign filter_amount = block.settings.filter_amount | divided_by: 100.0
            endcase

            if forloop.first
              assign placeholder_name = 'collection-1'
              assign class_modifier = 'before'
            else
              assign placeholder_name = 'collection-4'
              assign class_modifier = 'after'
            endif

            assign image_sizes = '(min-width: 960px) calc(100vw - calc(2 * 3.3vw)), calc(100vw - calc(2 * clamp(18px, 3.3vw, 3.3vw)))'
          -%}

          <div
            class="
              image-compare__image-wrapper
              {% if block.settings.filter_effect != 'none' -%}
                image-compare__image--{{ block.settings.filter_effect }}
              {%- endif -%}
            "
            style="
              {%- render 'color-scheme-to-vars',
                color_scheme: block.settings.overlay_color_scheme,
                output_placeholder_colors: false,
                css_vars: 'background,background-gradient'
              -%}
              --color-label-text: {{ block.settings.text_color }};
              --color-label-background: {{ block.settings.text_container_color }};
              --overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
              --filter-amount: {{ filter_amount }};
              --text-horizontal-position: {{ horizontal_position }};
              --text-vertical-position: {{ vertical_position }};
            "
          >
            <div class="image-compare__image-{{ class_modifier }}" {{ block.shopify_attributes }}>
              {%- render 'image',
                image: block.settings.image,
                wrapper_class: 'image-compare__image',
                aspect_ratio: section.settings.aspect_ratio,
                focal_point: block.settings.focal_point,
                placeholder_name: placeholder_name,
                include_placeholder: true,
                placeholder_natural_fallback_ratio: 'landscape',
                sizes: image_sizes,
                animate: true
              -%}

              <div class="image-compare__overlay"></div>

              {%- if block.settings.show_label -%}
                <div class="image-compare__label-container-wrapper animation--label">
                  <div class="image-compare__label-container">
                    <div class="image-compare__label-container-inner section-blocks animation--section-blocks">
                      {%- unless block.settings.text == blank -%}
                        <div
                          class="
                            image-compare__label-container-text
                            ff-body
                            fs-body-75
                            fs-body-100-ns
                            {{ block.settings.text_font_class }}
                            section-blocks__text
                          "
                        >
                          {{- block.settings.text -}}
                        </div>
                      {%- endunless -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <input
          type="range"
          class="image-compare__slider"
          value="50"
          step="any"
          aria-label="Percentage of after photo shown"
          orient="{{ section.settings.reveal_direction }}"
          {%- # for Firefox -%}
        >

        <div class="image-compare__slider-line" aria-hidden="true"></div>

        <div class="image-compare__slider-button" aria-hidden="true">
          <div class="image-compare__slider-button-arrows">
            <div class="image-compare__slider-button-arrow image-compare__slider-button-arrow-before">
              {%- render 'icon', icon: 'chevron-small' -%}
            </div>

            <div class="image-compare__slider-button-arrow image-compare__slider-button-arrow-after">
              {%- render 'icon', icon: 'chevron-small' -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

