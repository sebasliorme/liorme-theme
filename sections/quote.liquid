<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    quote
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--quotes
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
    {% if section.settings.content_width == 'custom' -%}
      --custom-content-width: {{ section.settings.custom_content_width }}px;
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="quote"
>
  <div class="section-inner section-inner--width-{{ section.settings.section_width }}">
    <div
      class="quotes swiper {%- if section.blocks.size > 1 %} has-multiple{%- endif -%}"
      data-slider
      data-autoplay-enabled="{{ section.settings.autoplay_enabled }}"
      data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
      data-count="{{ section.blocks.size }}"
      data-pagination-style="{{ section.settings.pagination_style }}"
    >
      {% if section.blocks.size > 1 %}
        <button class="slider-nav-button slider-nav-button-prev" title="{{ 'general.accessibility.previous' | t }}">
          {%- render 'icon', icon: 'chevron' -%}
        </button>
      {% endif %}

      <div class="slider-inner swiper-wrapper">
        {%- liquid
          if section.blocks.size > 1
            assign has_multiple_blocks = true
          else
            assign has_multiple_blocks = false
          endif
        -%}

        {%- for block in section.blocks -%}
          {%- render 'quote-item',
            block: block,
            has_multiple_blocks: has_multiple_blocks,
            forloop: forloop,
            pagination_style: section.settings.pagination_style
          -%}

          {%- if section.settings.pagination_style == 'logos' -%}
            {%- capture logo_pagination_list_item -%}
              {{- logo_pagination_list_item -}}

              <li>
                <a
                  tabindex="1"
                  role="button"
                  logo-nav-button
                  data-index="{{ forloop.index0 }}"
                  aria-label="{{ 'general.accessibility.quote_nav' | t: name: block.settings.title }}"
                >
                  {%- if block.settings.logo -%}
                    {%- render 'quote-item-logo', logo: block.settings.logo, class: "quote__navigation-logo" -%}
                  {%- else -%}
                    <span class="fs-accent">Add Logo</span>
                  {%- endif -%}
                </a>
              </li>
            {%- endcapture -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <button class="slider-nav-button slider-nav-button-next" title="{{ 'general.accessibility.next' | t }}">
          {%- render 'icon', icon: 'chevron' -%}
        </button>
      {%- endif -%}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="quote__navigation">
        {%- if section.settings.pagination_style == 'dots' -%}
          {%- render 'navigation-dots', dot_count: section.blocks.size -%}
        {%- else -%}
          <ul class="logo-navigation">
            {{- logo_pagination_list_item -}}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.quotes.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.quotes.settings.content.header.content"
    },
    {
      "type": "radio",
      "id": "content_width",
      "label": "t:shared.settings.content_width.label",
      "options": [
        {
          "value": "full",
          "label": "t:shared.settings.content_width.options.full"
        },
        {
          "value": "custom",
          "label": "t:shared.settings.content_width.options.custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_content_width",
      "label": "t:shared.settings.custom_content_width.label",
      "min": 400,
      "max": 1350,
      "step": 50,
      "unit": "px",
      "default": 1150,
      "info": "t:shared.settings.custom_content_width.info",
      "visible_if": "{{ section.settings.content_width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:sections.quotes.settings.slider.header.content"
    },
    {
      "type": "checkbox",
      "id": "autoplay_enabled",
      "label": "t:sections.quotes.settings.slider.autoplay_enabled.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "t:sections.quotes.settings.slider.autoplay_delay.label",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:sections.quotes.settings.slider.pagination_style.label",
      "options": [
        {
          "value": "dots",
          "label": "t:sections.quotes.settings.slider.pagination_style.options.dots"
        },
        {
          "value": "logos",
          "label": "t:sections.quotes.settings.slider.pagination_style.options.logos"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:shared.settings.section_style.section_width.label",
      "options": [
        {
          "value": "page-width",
          "label": "t:shared.settings.section_style.section_width.options.page_width"
        },
        {
          "value": "full-width-padded",
          "label": "t:shared.settings.section_style.section_width.options.full_width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:shared.settings.section_style.section_padding.top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:shared.settings.section_style.section_padding.bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.settings.section_style.divider_style.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.settings.section_style.divider_style.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_divider",
      "label": "t:shared.settings.section_style.enable_full_width_divider.label",
      "visible_if": "{{ section.settings.divider_style == 'solid' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "default": true,
      "info": "t:shared.settings.section_style.enable_animation.info"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.quotes.blocks.quote.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.quotes.blocks.quote.settings.logo.label"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:sections.quotes.blocks.quote.settings.quote.label",
          "default": "t:sections.quotes.blocks.quote.settings.quote.default"
        },
        {
          "type": "select",
          "id": "quote_font",
          "label": "t:sections.quotes.blocks.quote.settings.quote_font.label",
          "options": [
            {
              "value": "ff-heading",
              "label": "t:shared.settings.font_choice.options.heading"
            },
            {
              "value": "ff-body",
              "label": "t:shared.settings.font_choice.options.body"
            }
          ]
        },
        {
          "type": "select",
          "id": "heading_quote_font_class",
          "label": "t:sections.quotes.blocks.quote.settings.quote_font_class.label",
          "options": [
            {
              "value": "fs-heading-6-base",
              "label": "t:shared.settings.heading_font_class.options.xx_small"
            },
            {
              "value": "fs-heading-5-base",
              "label": "t:shared.settings.heading_font_class.options.x_small"
            },
            {
              "value": "fs-heading-4-base",
              "label": "t:shared.settings.heading_font_class.options.small"
            },
            {
              "value": "fs-heading-3-base",
              "label": "t:shared.settings.heading_font_class.options.medium"
            },
            {
              "value": "fs-heading-2-base",
              "label": "t:shared.settings.heading_font_class.options.large"
            },
            {
              "value": "fs-heading-1-base",
              "label": "t:shared.settings.heading_font_class.options.x_large"
            },
            {
              "value": "fs-heading-display-3",
              "label": "t:shared.settings.heading_font_class.options.display_regular"
            },
            {
              "value": "fs-heading-display-2",
              "label": "t:shared.settings.heading_font_class.options.display_large"
            },
            {
              "value": "fs-heading-display-1",
              "label": "t:shared.settings.heading_font_class.options.display_x_large"
            }
          ],
          "default": "fs-heading-5-base",
          "visible_if": "{{ block.settings.quote_font == 'ff-heading' }}"
        },
        {
          "type": "select",
          "id": "text_quote_font_class",
          "label": "t:sections.quotes.blocks.quote.settings.quote_font_class.label",
          "options": [
            {
              "value": "fs-body-25",
              "label": "t:shared.settings.text_font_class.options.xx_small"
            },
            {
              "value": "fs-body-50",
              "label": "t:shared.settings.text_font_class.options.x_small"
            },
            {
              "value": "fs-body-75",
              "label": "t:shared.settings.text_font_class.options.small"
            },
            {
              "value": "fs-body-100",
              "label": "t:shared.settings.text_font_class.options.regular"
            },
            {
              "value": "fs-body-150",
              "label": "t:shared.settings.text_font_class.options.large"
            },
            {
              "value": "fs-body-200",
              "label": "t:shared.settings.text_font_class.options.x_large"
            },
            {
              "value": "fs-body-250",
              "label": "t:shared.settings.text_font_class.options.2x_large"
            },
            {
              "value": "fs-body-300",
              "label": "t:shared.settings.text_font_class.options.3x_large"
            },
            {
              "value": "fs-body-350",
              "label": "t:shared.settings.text_font_class.options.4x_large"
            },
            {
              "value": "fs-body-400",
              "label": "t:shared.settings.text_font_class.options.5x_large"
            }
          ],
          "default": "fs-body-250",
          "visible_if": "{{ block.settings.quote_font == 'ff-body' }}"
        },
        {
          "type": "select",
          "id": "quote_tag",
          "label": "t:shared.settings.heading_tag.quote.label",
          "options": [
            {
              "value": "h2",
              "label": "t:shared.settings.heading_tag.options.h2"
            },
            {
              "value": "h3",
              "label": "t:shared.settings.heading_tag.options.h3"
            },
            {
              "value": "h4",
              "label": "t:shared.settings.heading_tag.options.h4"
            },
            {
              "value": "h5",
              "label": "t:shared.settings.heading_tag.options.h5"
            },
            {
              "value": "h6",
              "label": "t:shared.settings.heading_tag.options.h6"
            }
          ],
          "default": "h2"
        },
        {
          "type": "paragraph",
          "content": "t:shared.settings.heading_tag.quote.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.quotes.blocks.quote.settings.author.label",
          "default": "t:sections.quotes.blocks.quote.settings.author.default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.quotes.presets.name",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
