{%- liquid
  assign max_products = section.settings.maximum_products

  # Explicit request (Miu Miu-style product slider): the arrows sit in the header row on both
  # sides of the centred title, whatever the global slider navigation setting is.
  assign navigation_placement = 'header'

  capture custom_swatch_color_maps
    render 'get-custom-swatch-color-maps'
  endcapture

  assign custom_color_key_map = custom_swatch_color_maps | split: ' | ' | first | split: ','
  assign custom_color_value_map = custom_swatch_color_maps | split: ' | ' | last | split: ','
-%}

<div
  class="
    section
    section--includes-product-items
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    recommended-products
    carousel--mobile-per-view-{{ section.settings.mobile_columns }}
    carousel--per-view-{{ section.settings.mobile_columns }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--list-slider
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="recommended-products"
  data-product-id="{{ product.id }}"
  data-limit="{{ max_products }}"
  data-products-per-view="{{ section.settings.columns }}"
  data-mobile-products-per-view="{{ section.settings.mobile_columns }}"
>
  <div
    class="section__inner section-inner section-inner--width-{{ section.settings.section_width }}"
    data-recommendations
  >
    <div
      class="
        recommended-products__meta
        {% if navigation_placement == 'header' -%}
          carousel__navigation-wrapper
          carousel__navigation-wrapper--alignment-{{ section.settings.header_alignment }}
        {%- endif -%}
      "
    >
      {%- liquid
        capture section_header
          render 'section-header', local_settings: section.settings, heading_id: 'title', custom_class_prefix: 'recommended-products'
        endcapture

        if navigation_placement == 'header'
          case section.settings.header_alignment
            when 'left'
              echo section_header
              render 'carousel-navigation', wrapper_class: 'animation--controls'
            when 'center'
              render 'carousel-navigation-button', type: 'previous'
              echo section_header
              render 'carousel-navigation-button', type: 'next'
            when 'right'
              render 'carousel-navigation', wrapper_class: 'animation--controls'
              echo section_header
          endcase
        else
          echo section_header
        endif
      -%}
    </div>

    <div class="recommended-products__content carousel swiper">
      <div class="recommended-products__slider-wrapper carousel__wrapper swiper-wrapper">
        {%- if recommendations.products_count > 0 -%}
          {%- for product in recommendations.products limit: max_products -%}
            <div class="recommended-products__slide carousel__slide swiper-slide" data-slide>
              {%- render 'product-item',
                prod: product,
                product_columns_desktop: section.settings.columns,
                product_columns_mobile: section.settings.mobile_columns,
                aspect_ratio: settings.product_listing_aspect_ratio,
                custom_color_key_map: custom_color_key_map,
                custom_color_value_map: custom_color_value_map
              -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- liquid
        if navigation_placement == 'slider'
          render 'carousel-navigation', placement: 'slider'
        endif
      -%}

      <div class="recommended-products__progress" aria-hidden="true">
        <div class="recommended-products__progress-thumb"></div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'recommended-slider-progress.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.recommended_products.name",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.recommended_products.settings.paragraph_1.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.recommended_products.settings.paragraph_2.content"
    },
    {
      "type": "header",
      "content": "t:shared.section_header.header.content"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:shared.settings.alignment_horizontal.header.label",
      "options": [
        {
          "value": "left",
          "label": "t:shared.options.alignment.horizontal.left"
        },
        {
          "value": "center",
          "label": "t:shared.options.alignment.horizontal.center"
        },
        {
          "value": "right",
          "label": "t:shared.options.alignment.horizontal.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.recommended_products.settings.title.label",
      "default": "t:sections.recommended_products.settings.title.default"
    },
    {
      "type": "select",
      "id": "heading_font_class",
      "label": "t:shared.settings.heading_font_class.label",
      "options": [
        {
          "value": "fs-heading-6-base",
          "label": "t:shared.settings.heading_font_class.options.xx_small"
        },
        {
          "value": "fs-heading-5-base",
          "label": "t:shared.settings.heading_font_class.options.x_small"
        },
        {
          "value": "fs-heading-4-base",
          "label": "t:shared.settings.heading_font_class.options.small"
        },
        {
          "value": "fs-heading-3-base",
          "label": "t:shared.settings.heading_font_class.options.medium"
        },
        {
          "value": "fs-heading-2-base",
          "label": "t:shared.settings.heading_font_class.options.large"
        },
        {
          "value": "fs-heading-1-base",
          "label": "t:shared.settings.heading_font_class.options.x_large"
        },
        {
          "value": "fs-heading-display-3",
          "label": "t:shared.settings.heading_font_class.options.display_regular"
        },
        {
          "value": "fs-heading-display-2",
          "label": "t:shared.settings.heading_font_class.options.display_large"
        },
        {
          "value": "fs-heading-display-1",
          "label": "t:shared.settings.heading_font_class.options.display_x_large"
        }
      ],
      "default": "fs-heading-3-base"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:shared.settings.heading_tag.heading.label",
      "options": [
        {
          "value": "h2",
          "label": "t:shared.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:shared.settings.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:shared.settings.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:shared.settings.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:shared.settings.heading_tag.options.h6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "paragraph",
      "content": "t:shared.settings.heading_tag.heading.info"
    },
    {
      "type": "richtext",
