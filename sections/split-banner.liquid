{%- comment -%}
  Banner dividido — a full-width row of equal tiles (photo or colour panel with text), like Miu Miu's "Eyewear"
  split banner (a photo next to a dark panel with a title, text and "Shop" link). It is its OWN section, added and
  dragged like any other (Agregar sección), not a block tied to being between rows of products — unlike the
  "Slide de mosaico" block of the Grid editorial, which sits inside the product grid.

  Looks exactly like a tile of the "Mosaico de slides" section / the Grid editorial's "Slide de mosaico" (same
  snippet, same CSS): a photo (with focal point) or a colour panel, an optional small tag, a title, text and an
  underlined link. All tiles share the same shape, chosen once for the section, and by default sit with no gap
  between them (like the two squares of the Eyewear banner); "Separación" adds one if wanted.

  WHERE IT SHOWS: on every collection that uses the template, unless "Colecciones donde se muestra" lists some
  (only relevant when this section is on a collection template shared by several collections). In the theme editor
  a banner that belongs to another collection than the one being previewed is replaced by a short note (visitors
  never see it).
{%- endcomment -%}

{%- liquid
  assign shown_handles = ''
  assign shown_names = ''

  for shown_collection in section.settings.show_in_collections
    assign shown_handles = shown_handles | append: '|' | append: shown_collection.handle | append: '|'

    unless forloop.first
      assign shown_names = shown_names | append: ', '
    endunless

    assign shown_names = shown_names | append: shown_collection.title
  endfor

  assign show_here = true

  if section.settings.show_in_collections.size > 0
    assign show_here = false

    if collection != blank
      assign current_handle_key = '|' | append: collection.handle | append: '|'

      if shown_handles contains current_handle_key
        assign show_here = true
      endif
    endif
  endif

  assign cols = section.blocks.size | at_least: 1
  assign gap = section.settings.gap | default: '0' | plus: 0

  # box_ratio = width / height (the usual "16:9" kind of number, and the CSS aspect-ratio property's own convention)
  case section.settings.aspect_ratio
    when 'portrait'
      assign box_ratio = 0.6667
    when 'portrait_alt'
      assign box_ratio = 0.8
    when 'landscape'
      assign box_ratio = 1.5
    when 'landscape_alt'
      assign box_ratio = 1.25
    when 'landscape_wide_alt'
      assign box_ratio = 1.7778
    else
      assign box_ratio = 1.0
  endcase

  # the snippet that draws a tile expects the other convention (height / width), for its own `sizes` maths
  assign tile_ratio = 1.0 | divided_by: box_ratio
-%}

{%- if show_here == false and request.design_mode -%}
  <div style="margin: 12px; padding: 14px 16px; border: 1px dashed #9a9a9a; background: #f6f6f4; color: #444444; font-size: 12px; line-height: 1.5;">
    <strong>Banner dividido</strong> — solo se muestra en: {{ shown_names | escape }}. Estás viendo otra colección en la vista previa; cámbiala a una de esas para ver y editar este banner. Los visitantes no ven este aviso.
  </div>
{%- endif -%}

{%- if show_here and section.blocks.size > 0 -%}
  <style>
    #shopify-section-{{ section.id }} .split-banner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .split-banner__grid {
      display: grid;
      grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
      gap: {{ gap }}px;
    }

    #shopify-section-{{ section.id }} .collection-mosaic__tile {
      aspect-ratio: {{ box_ratio }};
    }

    @media (max-width: 719px) {
      #shopify-section-{{ section.id }} .split-banner__grid {
        grid-template-columns: 1fr;
      }
    }

    {%- liquid
      assign tile_scope = '#shopify-section-' | append: section.id
    -%}
    {%- render 'collection-mosaic-tile-css', scope: tile_scope %}
  </style>

  <div class="split-banner" data-section-id="{{ section.id }}">
    <div class="split-banner__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign eager = false
          if forloop.index <= 2
            assign eager = true
          endif
        -%}

        {%- render 'collection-mosaic-slide',
          column_span: 1,
          row_span: 1,
          image: block.settings.image,
          image_mobile: block.settings.image_mobile,
          focal_point: block.settings.focal_point,
          focal_x: block.settings.focal_x,
          focal_y: block.settings.focal_y,
          mobile_focal_point: block.settings.mobile_focal_point,
          mobile_focal_x: block.settings.mobile_focal_x,
          mobile_focal_y: block.settings.mobile_focal_y,
          background_color: block.settings.background_color,
          label: block.settings.label,
          label_color: block.settings.label_color,
          heading: block.settings.heading,
          text: block.settings.text,
          button_label: block.settings.button_label,
          link: block.settings.link,
          text_position: block.settings.text_position,
          text_color: block.settings.text_color,
          cols: cols,
          cols_m: 1,
          ratio: tile_ratio,
          eager: eager,
          attributes: block.shopify_attributes
        -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Banner dividido",
  "tag": "section",
  "class": "shopify-section--full-width",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Cuadrícula"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Forma de cada mitad",
      "info": "Todas las mitades tienen la misma forma. Cuadrado, como el banner «Eyewear» de Miu Miu.",
      "options": [
        { "value": "square", "label": "t:shared.options.aspect_ratio.square" },
        { "value": "portrait_alt", "label": "t:shared.options.aspect_ratio.portrait_alt" },
        { "value": "portrait", "label": "t:shared.options.aspect_ratio.portrait" },
        { "value": "landscape_alt", "label": "t:shared.options.aspect_ratio.landscape_alt" },
        { "value": "landscape", "label": "t:shared.options.aspect_ratio.landscape" },
        { "value": "landscape_wide_alt", "label": "t:shared.options.aspect_ratio.landscape_wide_alt" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Separación",
      "info": "Ninguna deja las mitades pegadas, sin línea entre ellas, como el banner «Eyewear».",
      "options": [
        { "value": "0", "label": "Ninguna" },
        { "value": "1", "label": "1 px" },
        { "value": "2", "label": "2 px" }
      ],
      "default": "0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Dónde se muestra"
    },
    {
      "type": "collection_list",
      "id": "show_in_collections",
      "label": "Colecciones donde se muestra",
      "info": "Solo cuenta si este banner está en una plantilla de colección compartida por varias. Vacío = sale en todas las que usan esa plantilla.",
      "limit": 12
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Mitad",
      "settings": [
        {
          "type": "header",
          "content": "Imagen"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen en móvil (opcional)"
        },
        {
          "type": "select",
          "id": "focal_point",
          "label": "t:shared.settings.focal_point.image.default.label",
          "info": "Qué parte de la foto se queda a la vista cuando se recorta. «De la imagen» usa el punto focal guardado en la propia imagen (centro si no tiene).",
          "options": [
            { "value": "image_presentation", "label": "t:shared.options.focal_point.image_presentation" },
            { "value": "center", "label": "t:shared.options.focal_point.center" },
            { "value": "top", "label": "t:shared.options.focal_point.top" },
            { "value": "bottom", "label": "t:shared.options.focal_point.bottom" },
            { "value": "left", "label": "t:shared.options.focal_point.left" },
            { "value": "right", "label": "t:shared.options.focal_point.right" },
            { "value": "custom", "label": "Personalizado (usa los deslizadores)" }
          ],
          "default": "image_presentation"
        },
        {
          "type": "range",
          "id": "focal_x",
          "label": "Punto focal: posición horizontal",
          "info": "Solo con «Personalizado». 0 % es el borde izquierdo de la foto y 100 % el derecho.",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "focal_y",
          "label": "Punto focal: posición vertical",
          "info": "Solo con «Personalizado». 0 % es el borde superior de la foto y 100 % el inferior.",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "select",
          "id": "mobile_focal_point",
          "label": "t:shared.settings.focal_point.image.mobile.label",
          "info": "Qué parte de la foto se queda a la vista cuando se recorta. «De la imagen» usa el punto focal guardado en la propia imagen (centro si no tiene).",
          "options": [
            { "value": "image_presentation", "label": "t:shared.options.focal_point.image_presentation" },
            { "value": "center", "label": "t:shared.options.focal_point.center" },
            { "value": "top", "label": "t:shared.options.focal_point.top" },
            { "value": "bottom", "label": "t:shared.options.focal_point.bottom" },
            { "value": "left", "label": "t:shared.options.focal_point.left" },
            { "value": "right", "label": "t:shared.options.focal_point.right" },
            { "value": "custom", "label": "Personalizado (usa los deslizadores)" }
          ],
          "default": "image_presentation"
        },
        {
          "type": "range",
          "id": "mobile_focal_x",
          "label": "Punto focal móvil: posición horizontal",
          "info": "Solo con «Personalizado». 0 % es el borde izquierdo de la foto y 100 % el derecho.",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_focal_y",
          "label": "Punto focal móvil: posición vertical",
          "info": "Solo con «Personalizado». 0 % es el borde superior de la foto y 100 % el inferior.",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "header",
          "content": "Color"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Color de fondo",
          "info": "Sin imagen, la mitad es un panel de este color (como el del banner «Eyewear»)."
        },
        {
          "type": "header",
          "content": "Etiqueta"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "info": "Texto pequeño arriba a la izquierda, por ejemplo «From the runway»."
        },
        {
          "type": "select",
          "id": "label_color",
          "label": "Color de la etiqueta",
          "options": [
            { "value": "dark", "label": "Oscuro" },
            { "value": "light", "label": "Claro" }
          ],
          "default": "dark"
        },
        {
          "type": "header",
          "content": "Texto"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del enlace",
          "info": "Por ejemplo «Shop». Se muestra subrayado y solo si esta mitad tiene enlace."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace",
          "info": "Toda esta mitad es un enlace a esta dirección."
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Dónde va el texto",
          "options": [
            { "value": "top_left", "label": "Arriba a la izquierda" },
            { "value": "center_left", "label": "Centro, a la izquierda" },
            { "value": "bottom_left", "label": "Abajo a la izquierda" },
            { "value": "center", "label": "Centrado" }
          ],
          "default": "top_left"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Color del texto",
          "options": [
            { "value": "white", "label": "Blanco" },
            { "value": "black", "label": "Negro" }
          ],
          "default": "white"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner dividido",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "label": "New in"
          }
        },
        {
          "type": "tile",
          "settings": {
            "background_color": "#1d0805",
            "heading": "Shop now",
            "button_label": "Shop",
            "text_position": "center_left"
          }
        }
      ]
    }
  ]
}
{% endschema %}
