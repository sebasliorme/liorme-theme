<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    complete-the-look
    complete-the-look--image-{{ section.settings.image_position }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--complete-the-look
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="complete-the-look"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
>
  <div class="complete-the-look__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    {%- render 'section-header', local_settings: section.settings, custom_class_prefix: 'complete-the-look' -%}

    <div class="complete-the-look__inner-items">
      <div class="complete-the-look__image-container">
        <div class="complete-the-look__image-container-inner">
          <div class="complete-the-look__image-wrapper">
            {%- if section.settings.video != blank -%}
              {%- render 'video',
                video: section.settings.video,
                aspect_ratio: section.settings.aspect_ratio,
                controls: section.settings.video_controls,
                loop: section.settings.video_loop,
                animate: true
              -%}
            {%- elsif section.settings.image -%}
              {%- render 'image',
                image: section.settings.image,
                wrapper_class: 'complete-the-look__image',
                focal_point: 'image_presentation',
                aspect_ratio: section.settings.aspect_ratio,
                sizes: '(min-width: 960px) calc(calc(100vw - calc(2 * 120)) * 0.55), (min-width: 720px) calc(100vw - calc(2 * 80px)), calc(100vw - calc(2 * 20px))',
                animate: true
              -%}
            {%- else -%}
              {%- render 'placeholder-image',
                placeholder_name: 'collection-4',
                wrapper_class: 'complete-the-look__image',
                aspect_ratio: section.settings.aspect_ratio,
                natural_fallback_ratio: 'square'
              -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="complete-the-look__secondary-content">
        <div class="complete-the-look__products" data-count="{{ section.blocks.size }}">
          {%- liquid
            # We divide by 4 because half the container is the image grid, and that grid is 2x2 so each column is 1/4th
            case section.settings.product_image_size
              when 'small'
                assign image_sizes_fraction = 0.5 | divided_by: 4
              when 'medium'
                assign image_sizes_fraction = 0.67 | divided_by: 4
              when 'large'
                assign image_sizes_fraction = 0.84 | divided_by: 4
            endcase

            capture image_sizes
              echo 'calc((100vw - (2 * clamp(18px, 3.3vw, 3.3vw))) * [[isf]])' | replace: '[[isf]]', image_sizes_fraction
            endcapture
          -%}

          {%- for block in section.blocks -%}
            <div
              class="complete-the-look__product"
              data-index="{{ forloop.index0 }}"
              data-image-size="{{ section.settings.product_image_size }}"
            >
              {%- render 'product-card-mini',
                prod: block.settings.product_item,
                class: 'alt-layout-below-960',
                custom_product_image: block.settings.custom_product_image,
                image_sizes: image_sizes,
                shopify_attributes: block.shopify_attributes
              -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
