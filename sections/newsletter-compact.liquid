{%- liquid
  if section.settings.background_type == 'image'
    assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  endif
-%}

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    section--enable-mobile-padding-{{ section.settings.enable_padding_on_mobile }}
    newsletter-compact
    newsletter-compact--spacing-mode-{{ section.settings.spacing_mode }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--newsletter-compact
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="newsletter-compact"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: color_scheme -%}
    {%- render 'section-padding-vars' -%}
    --text-alignment: {{ section.settings.alignment }};
    {% if section.settings.background_type == 'image' -%}
      --overlay-opacity: {{ overlay_opacity }};
    {%- endif -%}
  "
>
  {%- liquid
    if section.settings.background_type == 'image'
      assign content_color_scheme = section.settings.overlay_color_scheme
      assign content_background_matches_section = false
    else
      assign content_color_scheme = section.settings.background_color_scheme
      assign section_background_gradient = section.settings.color_scheme.settings.background_gradient
      assign section_background = section.settings.color_scheme.settings.background
      assign content_background_gradient = content_color_scheme.settings.background_gradient
      assign content_background = content_color_scheme.settings.background

      if section_background == content_background or section_background_gradient != blank and section_background_gradient == content_background_gradient
        assign content_background_matches_section = true
      else
        assign content_background_matches_section = false
      endif
    endif
  -%}

  <div
    class="
      newsletter-compact__inner
      section-inner
      section-inner--width-{{ section.settings.section_width }}
      section-inner--mobile-full-width-{{ section.settings.enable_full_width_on_mobile }}
    "
    data-content-background-matches-section="{{ content_background_matches_section }}"
    style="{%- render 'color-scheme-to-vars', color_scheme: content_color_scheme, output_placeholder_colors: false -%}"
  >
    {%- if section.settings.background_type == 'image' -%}
      <div class="newsletter-compact__background-image-wrapper">
        {%- if section.settings.mobile_image != blank -%}
          {%- render 'image',
            wrapper_class: 'newsletter-compact__background-image newsletter-compact__background-image--mobile',
            image: section.settings.mobile_image,
            sizes: '100vw',
            focal_point: section.settings.mobile_focal_point
          -%}
        {%- endif -%}

        {%- render 'image',
          wrapper_class: 'newsletter-compact__background-image',
          image: section.settings.image,
          sizes: '100vw',
          focal_point: section.settings.focal_point,
          include_placeholder: true,
          placeholder_name: 'lifestyle-2'
        -%}
      </div>

      <div class="newsletter-compact__overlay"></div>
    {%- endif -%}

    <div class="newsletter-compact__block-content section-blocks animation--section-blocks">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'newsletter_signup' -%}
            <div class="newsletter-compact__signup newsletter-compact__block-item section-blocks__newsletter-signup">
              {%- render 'newsletter-form',
                form_id: 'newsletter-compact-subscribe',
                base_class: 'newsletter-compact__signup',
                button_label: block.settings.signup_link_text,
                enable_collect_customer_name: block.settings.enable_collect_customer_name
              -%}

              {%- unless block.settings.footer_text == blank -%}
                <div class="newsletter-compact__signup-footer ff-body fs-body-50 rte">
                  {{- block.settings.footer_text -}}
                </div>
              {%- endunless -%}
            </div>

            {%- render 'section-block-text',
              text: block.settings.text,
              text_font_class: block.settings.text_font_class,
              class_prefix: 'newsletter-compact__block-content',
              custom_class: 'newsletter-compact__block-item'
            -%}

          {%- when 'text_content' -%}
            {%- if block.settings.title != blank
              or block.settings.text != blank
              or block.settings.subheading != blank
            -%}
              <div
                class="newsletter-compact__block-text-content section-blocks newsletter-compact__block-item"
                style="--max-width: {{ block.settings.width }}px;"
              >
                {%- render 'section-block-heading',
                  heading_tag: block.settings.heading_tag,
                  heading: block.settings.title,
                  heading_font_class: block.settings.heading_font_class,
                  class_prefix: 'newsletter-compact__block-text-content'
                -%}

                {%- render 'section-block-subheading',
                  subheading_tag: block.settings.subheading_tag,
                  subheading: block.settings.subheading,
                  subheading_font_class: block.settings.subheading_font_class,
                  class_prefix: 'newsletter-compact__block-text-content'
                -%}

                {%- render 'section-block-text',
                  text: block.settings.text,
                  text_font_class: block.settings.text_font_class,
                  class_prefix: 'newsletter-compact__block-text-content'
                -%}
              </div>
            {%- endif -%}

          {%- when 'image' -%}
            {%- render 'image-block',
              image: block.settings.image,
              width: block.settings.image_size,
              mobile_width: block.settings.image_size_mobile,
              break_to_mobile_at: '720',
              wrapper_class: 'newsletter-compact__block-content-image newsletter-compact__block-item section-blocks__image  section-blocks__image',
              align: section.settings.alignment,
              enable_corner_rounding: block.settings.enable_corner_rounding,
              shopify_attributes: block.shopify_attributes
            -%}

          {%- when 'social_icons' -%}
            {%- render 'social-icons-block',
              position: section.settings.alignment,
              classes: 'newsletter-compact__block-content-social-icons newsletter-compact__block-item'
            -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

