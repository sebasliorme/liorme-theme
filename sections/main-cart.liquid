<div
  class="section cart page"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="cart"
>
  <div class="cart__container page__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    {%- if cart.item_count >= 1 -%}
      <form action="{{ routes.cart_url }}" method="post" data-form novalidate class="cart__form">
        <div class="cart__form-items" js-cart-items>
          <div class="cart__form-header">
            <h1 class="cart__form-title ff-heading fs-heading-1-base">{{ 'cart.general.title' | t }}</h1>

            <span class="cart__form-item-count fs-body-100">
              {{- 'cart.general.items_with_count' | t: count: cart.item_count -}}
            </span>
          </div>

          {%- for item in cart.items -%}
            {% # don't use item.image as this doesn't have the focal point data. %}
            {% assign item_image = item.variant.featured_media | default: item.product.featured_media %}

            <div class="cart__form-item" data-input-item data-id="{{ item.id }}" data-key="{{ item.key }}">
              <div class="cart__form-item-image">
                <a href="{{ item.url }}" class="cart__form-item-link">
                  {%- render 'image',
                    image: item_image,
                    sizes: '120px',
                    prioritize_loading: true,
                    aspect_ratio: settings.cart_item_aspect_ratio,
                    focal_point: 'image_presentation',
                    include_placeholder: true
                  -%}
                </a>
              </div>

              <div class="cart__form-item-details">
                <div class="cart__form-item-info-wrapper">
                  <div class="cart__form-item-info">
                    <h4 class="cart__form-item-title ff-product-listing-title">
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                    </h4>

                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart__form-item-variant fs-body-50 t-opacity-60">{{ item.variant.title }}</p>
                    {%- endunless -%}

                    {%- if item.selling_plan_allocation -%}
                      <p class="cart__form-item-subscriptions fs-body-50 t-opacity-60">
                        {{ item.selling_plan_allocation.selling_plan.name }}
                      </p>
                    {%- endif -%}

                    {%-
                      # Note: The '.size' filter doesn't work on line item properties - currently, the docs don't show
                      # a value type, but it seems like it's an 'object' instead of an 'array' now.
                    -%}
                    {%- unless item.properties == empty -%}
                      <div class="cart__form-item-properties fs-body-60 t-opacity-70">
                        {%- for property in item.properties -%}
                          {%- # Don't show property if property name begins with an underscore, or if property is blank. -%}
                          {%- assign first_char = property.first | slice: 0 -%}

                          {%- unless property.last == blank or first_char == '_' -%}
                            <p>
                              {{- property.first }}:&nbsp;

                              {%- if property.last contains '/uploads/' -%}
                                <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                              {%- else -%}
                                {{- property.last -}}
                              {%- endif -%}
                            </p>
                          {%- endunless -%}
                        {%- endfor -%}
                      </div>
                    {%- endunless -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="cart__form-item-discounts">
                        {%- for discount_allocation in item.line_level_discount_allocations -%}
                          <li class="cart__form-item-discount fs-body-75">
                            {%- liquid
                              assign discount_amount = discount_allocation.amount | money_without_trailing_zeros | replace: '.00', ''

                              render 'icon', icon: 'discount-badge'
                              echo '[[title]] (-[[amount]])' | replace: '[[title]]', discount_allocation.discount_application.title | replace: '[[amount]]', discount_amount
                            -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {% endif %}
                  </div>

                  {%- liquid
                    if item.original_price == 0 and settings.zero_dollar_cart_price_display == 'replace'
                      assign price_content_type = 'custom'
                    else
                      assign price_content_type = 'price'
                    endif

                    assign item_price = item.original_price
                    assign item_sale_price = blank
                    assign price_tag_type = 'span'

                    if item.original_line_price > item.final_line_price or item.variant.compare_at_price > item.variant.price
                      assign price_tag_type = 's'

                      if item.original_line_price > item.final_line_price
                        assign item_sale_price = item.final_price
                      else
                        assign item_price = item.variant.compare_at_price
                        assign item_sale_price = item.original_price
                      endif
                    endif

                    if section.settings.show_product_currency
                      capture iso_code
                        echo cart.currency.iso_code
                      endcapture
                    endif
                  -%}

                  {%- # Compare check allows for sale items to properly show instead of being replaced by text -%}
                  {%- if price_content_type == 'price' or item.variant.compare_at_price > item.original_price -%}
                    <div class="cart__form-item-price-wrapper fs-body-75">
                      <{{ price_tag_type }} class="cart__form-item-price">
                        {{- item_price | money_without_trailing_zeros | replace: '.00', '' }}
                        {{ iso_code -}}
                      </{{ price_tag_type }}>

                      {%- if item_sale_price != blank -%}
                        <span class="cart__form-item-price sale-price">
                          {{- item_sale_price | money_without_trailing_zeros | replace: '.00', '' }}
                          {{ iso_code -}}
                        </span>
                      {%- endif -%}

                      {%- render 'unit-price', item: item -%}
                    </div>
                  {%- elsif price_content_type == 'custom' -%}
                    <div class="cart__form-item-price-wrapper fs-body-75">
                      <span class="cart__form-item-price">
                        {{- 'products.inventory.zero_price_custom_label' | t -}}
                      </span>
                    </div>
                  {%- endif -%}
                </div>

                <div class="cart__form-item-quantity-wrapper">
                  <p class="cart__form-item-error fs-body-50 hidden">{{ 'cart.general.error' | t }}</p>

                  {%- # Low inventory warning -%}
                  {%- if settings.enable_low_inventory_warning -%}
                    {%- liquid
                      assign item_variants = item.product.variants
                      assign item_variant = item_variants | where: 'id', item.id | first
                    -%}

                    {%- if item_variant.inventory_management != blank
                      and item_variant.inventory_policy == 'deny'
                      and item_variant.inventory_quantity < settings.low_inventory_warning_threshold
                    -%}
                      <p class="cart__inventory-warning fs-body-50">
                        {{- 'cart.general.inventory_warning' | t: amount: item_variant.inventory_quantity -}}
                      </p>
                    {%- endif -%}
                  {%- endif -%}

                  {%- render 'quantity-input',
                    prod: item.product,
                    variant: item.variant,
                    id: item.id,
                    initial_value: item.quantity
                  -%}

                  <div class="cart__form-item-remove-wrapper">
                    <button
                      type="button"
                      data-remove-item
                      class="cart__form-item-remove fs-body-75"
                    >
                      {{- 'cart.general.remove' | t -}}
                    </button>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}

          {%- if settings.enable_cross_sells and section.settings.cross_sells_position == 'below-line-items' -%}
            {%- render 'cross-sells',
              cart: cart,
              display: settings.cart_page_cross_sells_display,
              show_product_currency: section.settings.show_product_currency
            -%}
          {%- endif -%}
        </div>

        <div class="cart__footer-wrapper">
          <div class="cart__footer">
            {%- render 'free-shipping-bar' %}

            <div class="cart__footer-inner">
              {%- if settings.show_cart_notes -%}
                <div class="cart__footer-order-note-wrapper" aria-expanded="false" aria-hidden="true">
                  <button
                    type="button"
                    class="cart__footer-order-note-trigger fs-body-75"
                    data-order-note-trigger
                  >
                    <div class="cart__footer-order-note-trigger-icons">
                      {%- render 'icon', icon: 'plus-small' -%}
                      {%- render 'icon', icon: 'minus-small', class: 'hidden' -%}
                    </div>

                    <span class="cart__footer-order-note-trigger-text" data-cart-note-trigger-text>
                      {{ 'cart.general.order_note_button_add' | t }}
                    </span>
                  </button>

                  <div class="cart__footer-order-note-input" cart-note-input>
                    <label for="CartSpecialInstructions" class="fs-body-100">
                      {{- 'cart.general.order_note_label' | t -}}
                    </label>

                    <textarea
                      id="CartSpecialInstructions"
                      class="input"
                      name="note"
                      placeholder="{{ 'cart.general.order_note_placeholder' | t }}"
                    >
                      {{- cart.note -}}
                    </textarea>
                  </div>
                </div>
              {%- endif -%}

              <div
                class="
                  cart__footer-subtotal-wrapper
                  {% if  cart.cart_level_discount_applications.size > 0 -%}
                    cart__footer-subtotal-wrapper--has-discount
                  {%- endif -%}
                "
                js-cart-footer-subtotal-wrapper
              >
                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="cart__item-discounts">
                    {%- for discount_application in cart.cart_level_discount_applications -%}
                      <li class="cart__item-discount fs-body-75">
                        {%- liquid
                          assign discount_amount = discount_application.total_allocated_amount | money_without_trailing_zeros | replace: '.00', ''

                          render 'icon', icon: 'discount-badge'
                          echo '[[title]] (-[[amount]])' | replace: '[[title]]', discount_application.title | replace: '[[amount]]', discount_amount
                        -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <div class="cart__footer-subtotal">
                  <h3 class="ff-body fs-body-200">{{ 'cart.general.subtotal' | t }}</h3>

                  <span class="ff-body fs-body-200">
                    {%- liquid
                      echo cart.total_price | money_without_trailing_zeros | replace: '.00', ''

                      if section.settings.show_product_currency
                        echo ' [[iso]]' | replace: '[[iso]]', cart.currency.iso_code
                      endif
                    -%}
                  </span>
                </div>
              </div>

              <p class="cart__footer-tax-note ff-body fs-body-75 t-subdued rte">
                {%- liquid
                  if cart.taxes_included and shop.shipping_policy.body != blank
                    echo 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url
                  elsif cart.taxes_included
                    echo 'cart.general.taxes_included_but_shipping_at_checkout' | t
                  elsif shop.shipping_policy.body != blank
                    echo 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url
                  else
                    echo 'cart.general.taxes_and_shipping_at_checkout' | t
                  endif
                -%}
              </p>

              <div class="cart__input-buttons">
                <button
                  type="submit"
                  name="update"
                  class="cart__update btn btn--secondary btn--full"
                  aria-label="{{ 'cart.general.update' | t }}"
                >
                  {{- 'cart.general.update' | t -}}
                </button>

                <button
                  type="submit"
                  name="checkout"
                  class="cart__submit btn btn--full btn--primary"
                  aria-label="{{ 'cart.general.checkout' | t }}"
                >
                  {{- 'cart.general.checkout' | t -}}
                </button>
              </div>

              {%- if additional_checkout_buttons -%}
                <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
                  {{- content_for_additional_checkout_buttons -}}
                </div>
              {%- endif -%}
            </div>

            {%- if settings.enable_cross_sells and section.settings.cross_sells_position == 'below-subtotal' -%}
              {%- render 'cross-sells',
                cart: cart,
                display: settings.cart_page_cross_sells_display,
                position: section.settings.cross_sells_position,
                show_product_currency: section.settings.show_product_currency
              -%}
            {%- endif -%}
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart__empty">
        {% comment %}
          Cart empty state
        {% endcomment %}
        <div class="cart__empty-message supports-cookies">
          <h1 class="cart__empty-message-heading ff-heading fs-heading-2-base">{{ 'cart.general.empty' | t }}</h1>
          <p class="cart__empty-message-text fs-body-100">{{ 'cart.general.empty_message' | t }}</p>

          {%- if section.settings.collection_list != blank -%}
            {%- if section.settings.promotion_text != blank -%}
              <div class="cart__empty-state-promot-text rte ff-body fs-body-100">
                {{- section.settings.promotion_text -}}
              </div>
            {%- endif -%}

            <div class="cart__collection-buttons">
              {%- for collection in section.settings.collection_list -%}
                {%- render 'button-block',
                  wrapper_class: 'cart__empty-button cart__collection-list-button',
                  link: collection.url,
                  label: collection.title,
                  button_style: section.settings.collection_list_button_style,
                  button_alignment: 'center'
                -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            {%- assign empty_label = 'cart.general.continue_shopping' | t -%}

            {%- render 'button-block',
              wrapper_class: 'cart__empty-button cart__continue-shopping-button',
              link: section.settings.continue_shopping_link,
              label: empty_label,
              button_style: section.settings.collection_list_button_style,
              button_alignment: 'center'
            -%}
          {%- endif -%}
        </div>

        {% comment %}
          Cart no cookies state
          ---------------------
          Browser cookies are required to use the cart. If cookies aren't enabled in the
          browser a message is displayed prompting the user to enable them.
        {% endcomment %}
        <div class="supports-no-cookies">
          <p>{{ 'cart.general.cookies_required' | t }}</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "tag": "section",
  "class": "cart-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.shared.cart.settings.product_items.header.content"
    },
    {
      "type": "checkbox",
      "id": "show_product_currency",
      "label": "t:sections.shared.cart.settings.product_items.show_product_currency.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.cart.settings.empty_cart_promotion.header.content"
    },
    {
      "type": "url",
      "id": "continue_shopping_link",
      "label": "t:sections.shared.cart.settings.empty_cart_promotion.continue_shopping_link.label",
      "default": "/collections"
    },
    {
      "type": "text",
      "id": "promotion_text",
      "label": "t:sections.shared.cart.settings.empty_cart_promotion.promotion_text.label",
      "default": "/collections",
      "info": "t:sections.shared.cart.settings.empty_cart_promotion.promotion_text.info"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:sections.shared.cart.settings.empty_cart_promotion.collection_list.label"
    },
    {
      "type": "select",
      "id": "collection_list_button_style",
      "label": "t:sections.shared.cart.settings.empty_cart_promotion.collection_list_button_style.label",
      "options": [
        {
          "value": "btn--primary",
          "label": "t:sections.shared.cart.settings.empty_cart_promotion.collection_list_button_style.options.solid"
        },
        {
          "value": "btn--secondary",
          "label": "t:sections.shared.cart.settings.empty_cart_promotion.collection_list_button_style.options.outline"
        }
      ],
      "default": "btn--secondary",
      "info": "t:sections.shared.cart.settings.empty_cart_promotion.collection_list_button_style.info"
    },
    {
      "type": "header",
      "content": "t:sections.main_cart.settings.cross_sells.header.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_cart.settings.cross_sells.paragraph.content"
    },
    {
      "type": "select",
      "id": "cross_sells_position",
      "label": "t:sections.main_cart.settings.cross_sells.cross_sells_position.label",
      "options": [
        {
          "value": "below-subtotal",
          "label": "t:sections.main_cart.settings.cross_sells.cross_sells_position.options.below_subtotal"
        },
        {
          "value": "below-line-items",
          "label": "t:sections.main_cart.settings.cross_sells.cross_sells_position.options.below_line_items"
        }
      ],
      "default": "below-line-items"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:shared.settings.section_style.section_width.label",
      "options": [
        {
          "value": "page-width",
          "label": "t:shared.settings.section_style.section_width.options.page_width"
        },
        {
          "value": "full-width-padded",
          "label": "t:shared.settings.section_style.section_width.options.full_width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:shared.settings.section_style.section_padding.top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:shared.settings.section_style.section_padding.bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
