<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    section--enable-mobile-padding-{{ section.settings.enable_padding_on_mobile }}
     promo-banner
    {% if section.settings.show_frame -%}promo-banner--frame{%- endif %}
    {% if section.settings.background_type == 'image' -%}promo-banner--has-image{%- endif %}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--promo-banner
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars',
      color_scheme: section.settings.color_scheme,
      css_vars:  'background,background-gradient,lines-and-borders'
    -%}
    {%- render 'section-padding-vars' -%}
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --min-height: {{ section.settings.min_height }}px;
    --min-height-mobile: {{ section.settings.min_height_mobile }}px;
    --left-column-width: {{ section.settings.left_column_width }}%;
    --right-column-width: {{ 100 | minus: section.settings.left_column_width }}%;
  "
  data-section-id="{{ section.id }}"
  data-section-type="promo-banner"
>
  {%- liquid
    if section.settings.background_type == 'image'
      assign background_color_scheme = section.settings.overlay_color_scheme
    else
      assign background_color_scheme = section.settings.background_color_scheme
    endif
  -%}

  <div
    class="
      promo-banner__inner
      section-inner
      section-inner--width-{{ section.settings.section_width }}
      section-inner--mobile-full-width-{{ section.settings.enable_full_width_on_mobile }}
    "
    style="{%- render 'color-scheme-to-vars', color_scheme: background_color_scheme, output_placeholder_colors: false -%}"
  >
    {%- if section.settings.background_type == 'image' -%}
      {%- liquid
        if section.settings.full_width
          assign image_sizes = '100vw'
        else
          assign image_sizes = '(min-width: 1400px) 1400px, calc(100vw - calc(2 * 3.3vw))'
        endif
      -%}

      {%- if section.settings.mobile_image != blank -%}
        {%- render 'image',
          wrapper_class: 'promo-banner__image promo-banner__image--mobile',
          image: section.settings.mobile_image,
          focal_point: section.settings.mobile_focal_point,
          sizes: image_sizes
        -%}
      {%- endif -%}

      {%- render 'image',
        wrapper_class: 'promo-banner__image',
        image: section.settings.image,
        focal_point: section.settings.focal_point,
        sizes: image_sizes,
        include_placeholder: true,
        placeholder_name: 'lifestyle-1'
      -%}
    {%- endif -%}

    <div class="promo-banner__overlay"></div>

    <div class="promo-banner__content">
      <div class="promo-banner__columns">
        <div class="promo-banner__columns-inner">
          {%- unless section.settings.giant_heading == blank -%}
            <div
              class="
                promo-banner__column
                promo-banner__column--alignment-{{ section.settings.left_column_alignment }}
                promo-banner__column--alignment-mobile-{{ section.settings.left_column_alignment_mobile }}
              "
            >
              <div class="promo-banner__column-inner">
                <div
                  class="promo-banner__giant-heading animation--giant-heading ff-heading"
                  style="
                    --giant-heading-font-size: {{ section.settings.giant_heading_font_size }}px;
                    --giant-heading-font-size-mobile: {{ section.settings.giant_heading_font_size_mobile }}px;
                  "
                >
                  {{- section.settings.giant_heading -}}
                </div>
              </div>
            </div>
          {%- endunless -%}

          <div
            class="
              promo-banner__column
              promo-banner__column--alignment-{{ section.settings.right_column_alignment }}
              promo-banner__column--alignment-mobile-{{ section.settings.right_column_alignment_mobile }}
            "
          >
            <div class="promo-banner__column-inner section-blocks animation--section-blocks">
              {%- render 'section-block-heading',
                heading_tag: section.settings.heading_tag,
                heading: section.settings.heading,
                heading_font_class: section.settings.heading_font_class
              -%}

              {%- render 'section-block-text',
                text: section.settings.text,
                text_font_class: section.settings.text_font_class
              -%}

              {%- if section.settings.link_text != blank or section.settings.link_text_2 != blank -%}
                <div class="promo-banner__button-group section-blocks__button">
                  {%- if section.settings.link_text -%}
                    {%- render 'button-block',
                      link: section.settings.link,
                      label: section.settings.link_text,
                      is_small: true,
                      button_style: section.settings.button_style,
                      wrapper_class: 'promo-banner__button animation'
                    -%}
                  {%- endif -%}

                  {%- if section.settings.link_text_2 -%}
                    {%- render 'button-block',
                      link: section.settings.link_2,
                      label: section.settings.link_text_2,
                      is_small: true,
                      button_style: section.settings.button_style_2,
                      wrapper_class: 'promo-banner__button animation'
                    -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

