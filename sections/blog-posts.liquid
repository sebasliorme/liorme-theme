{%- liquid
  echo 'template-blog.css' | asset_url | stylesheet_tag

  if section.settings.display_type == 'all' and section.settings.blog != blank
    assign blog_url = section.settings.blog.url
  else
    assign blog_url = blank
  endif
-%}

<div
  class="
    blog-posts
    {% if section.settings.color_scheme.settings.background_gradient != blank -%}
      blog-posts--has-background-gradient
    {%- endif %}
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
      animation--blog-posts
    {% endif %}
  "
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="blog-posts"
>
  <div class="section-inner section-inner--width-{{ section.settings.section_width }}">
    {%- render 'section-header',
      local_settings: section.settings,
      custom_class_prefix: 'blog-posts',
      custom_button_link: blog_url
    -%}

    <div class="blog-posts__grid">
      {%- assign show_placeholders = false -%}

      {%- case section.settings.display_type -%}
        {%- when 'all' -%}
          {%- assign blog = section.settings.blog -%}

          {%- if blog != blank and blog.articles.size > 0 -%}
            {%- for article in blog.articles limit: section.settings.max_articles -%}
              {% render 'article-item',
                blog: blog,
                article: article,
                aspect_ratio: section.settings.aspect_ratio,
                show_author: section.settings.show_author,
                show_date: section.settings.show_date,
                show_tags: section.settings.show_tags,
                show_excerpt: section.settings.show_excerpt,
                show_featured_image: section.settings.show_featured_image
              %}
            {%- endfor -%}
          {%- else -%}
            {%- assign show_placeholders = true -%}
          {%- endif -%}

        {%- when 'selected' -%}
          {%- if section.settings.articles != blank -%}
            {%- for article in section.settings.articles -%}
              {%- render 'article-item',
                article: article,
                show_featured_image: section.settings.show_featured_image,
                aspect_ratio: section.settings.aspect_ratio,
                show_author: section.settings.show_author,
                show_date: section.settings.show_date,
                show_tags: section.settings.show_tags,
                show_excerpt: section.settings.show_excerpt
              -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign show_placeholders = true -%}
          {%- endif -%}
      {%- endcase -%}

      {%- liquid
        if show_placeholders
          for i in (1..section.settings.max_articles)
            render 'article-item', aspect_ratio: section.settings.aspect_ratio
          endfor
        endif
      -%}
    </div>
  </div>
</div>

