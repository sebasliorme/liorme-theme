{%- liquid
  if section.settings.pagination == 'paginated'
    assign paginated = true
  else
    assign paginated = false
  endif

  assign per_page = section.settings.rows | times: section.settings.columns_desktop

  if section.settings.show_item_count or section.settings.show_sort or section.settings.show_filters
    assign filter_bar_enabled = true
  else
    assign filter_bar_enabled = false
  endif

  assign swatch_options = settings.swatch_options | downcase | split: ', '
  assign chip_options = settings.chip_options | downcase | split: ', '

  capture custom_swatch_color_maps
    render 'get-custom-swatch-color-maps'
  endcapture

  assign custom_color_key_map = custom_swatch_color_maps | split: ' | ' | first | split: ','
  assign custom_color_value_map = custom_swatch_color_maps | split: ' | ' | last | split: ','

  assign active_filter_count = 0

  for filter in search.filters
    if filter.active_values.size > 0
      for active_value in filter.active_values
        assign active_filter_count = active_filter_count | plus: 1
      endfor
    elsif filter.type == 'price_range'
      if filter.min_value.value > 0
        assign active_filter_count = active_filter_count | plus: 1
      endif

      if filter.max_value.value < filter.range_max
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
-%}

<div
  class="search-wrapper"
  data-section-id="{{ section.id }}"
  data-section-type="search"
  data-layout-type="grid"
  data-collection-columns-desktop="{{ section.settings.columns_desktop }}"
  data-search-term="{{ search.term }}"
  data-pagination-type="{{ section.settings.pagination }}"
  data-search-item-count="{{ search.results_count }}"
  data-active-filter-count="{{ active_filter_count }}"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
  data-search-wrapper
>
  <header
    class="
      search-header
      {% if settings.enable_section_animations and section.settings.enable_animation -%}
        animation
        animation--search-banner
      {%- endif %}
    "
  >
    <div class="search-header__inner section-blocks animation--section-blocks">
      <h1 class="search-header__title ff-heading fs-heading-2-base fs-heading-1-base-ns section-blocks__heading">
        {%- liquid
          if search.performed
            echo 'search.results_with_count' | t: terms: search.terms, count: search.results_count
          else
            echo 'search.title' | t
          endif
        -%}
      </h1>

      <form
        class="search-form"
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        data-search-form
      >
        <div class="search-form__input-wrapper">
          <label for="Search" class="visually-hidden">{{ 'search.placeholder' | t }}</label>

          <input
            type="search"
            id="Search"
            class="search-form__input input"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'search.placeholder' | t }}"
            autocomplete="off"
            data-search-input
          >

          <input type="hidden" name="options[prefix]" value="last" data-search-options>

          <button type="submit" class="search-form__submit" aria-label="{{ 'search.search' | t }}">
            {% render 'icon', icon: 'search' %}
          </button>
        </div>
      </form>
    </div>
  </header>

  <div
    class="
      section
      search
      search--pagination-{{ section.settings.pagination }}
      {% if filter_bar_enabled %}search--has-filter-bar{% endif %}
      {% if settings.enable_section_animations and section.settings.enable_animation -%}
        animation
        animation--search
      {%- endif %}
    "
    data-enable-sticky-filter-sidebar="{{ section.settings.enable_sticky_filter_sidebar }}"
    style="
      --search-columns-desktop: {{ section.settings.columns_desktop }};
      --search-columns-mobile: {{ section.settings.columns_mobile }};
    "
  >
    {% if section.settings.divider_style == 'solid' and search.results_count > 0 or active_filter_count > 0 %}
      <div class="search__divider search__divider--full-width-{{ section.settings.enable_full_width_divider }}"></div>
    {%- endif -%}

    <div class="search__inner section-inner section-inner--width-{{ section.settings.section_width }}">
      {%- paginate search.results by per_page -%}
        <div class="search__container">
          <div class="search__content">
            {%- if search.results_count > 0 or active_filter_count > 0 -%}
              {%- render 'filter-bar',
                resource: search,
                show_item_count: section.settings.show_item_count,
                show_sort: section.settings.show_sort,
                show_filters: section.settings.show_filters,
                enable_sticky_filter_bar: section.settings.enable_sticky_filter_bar,
                collapse_filter_bar: section.settings.collapse_filter_bar,
                filter_location: section.settings.desktop_filter_location,
                active_filter_count: active_filter_count,
                show_swatch_filters: section.settings.show_swatch_filters,
                swatch_options: swatch_options,
                custom_color_key_map: custom_color_key_map,
                custom_color_value_map: custom_color_value_map,
                show_chip_filters: section.settings.show_chip_filters,
                chip_options: chip_options,
                chip_layout: section.settings.chip_layout
              -%}

              {%- render 'mobile-filters',
                resource: search,
                show_sort: section.settings.show_sort,
                show_filters: section.settings.show_filters,
                enable_sticky_filter_bar: section.settings.enable_sticky_filter_bar
              -%}
            {%- endif -%}

            <div class="search__main-area">
              {%- if section.settings.desktop_filter_location == 'sidebar' -%}
                {%- render 'filter-sidebar',
                  resource: search,
                  show_filters: section.settings.show_filters,
                  collapse_filter_bar: section.settings.collapse_filter_bar,
                  collapse_filter_groups: section.settings.collapse_filter_groups_desktop,
                  show_swatch_filters: section.settings.show_swatch_filters,
                  swatch_options: swatch_options,
                  custom_color_key_map: custom_color_key_map,
                  custom_color_value_map: custom_color_value_map,
                  show_chip_filters: section.settings.show_chip_filters,
                  chip_options: chip_options,
                  chip_layout: section.settings.chip_layout
                -%}
              {%- endif -%}

              <div class="search__window">
                <div class="search__loading" data-loading>
                  {%- render 'loader' -%}
                </div>

                <div
                  id="root"
                  class="animation--search-items"
                  data-partial
                  data-search-results-count="{{ search.results_count }}"
                >
                  <div
                    class="
                      search__results
                      search__infinite-container
                      {% if search.results_count == 0 -%}
                        search__results--no-products
                      {%- endif %}
                    "
                  >
                    {%- if search.performed -%}
                      {%- for item in search.results -%}
                        {%- case item.object_type -%}
                          {%- when 'product' -%}
                            {%- render 'product-item',
                              prod: item,
                              product_columns_desktop: section.settings.columns_desktop,
                              product_columns_mobile: section.settings.columns_mobile,
                              aspect_ratio: settings.product_listing_aspect_ratio,
                              has_grid_reveal: true,
                              custom_color_key_map: custom_color_key_map,
                              custom_color_value_map: custom_color_value_map
                            -%}
                          {%- else -%}
                            {%- render 'search-item',
                              item: item,
                              columns_desktop: section.settings.columns_desktop,
                              columns_mobile: section.settings.columns_mobile,
                              forloop: forloop,
                              has_grid_reveal: true
                            -%}
                        {%- endcase -%}
                      {%- else -%}
                        <div class="search__empty">
                          {%- if active_filter_count > 0 -%}
                            <div>{{ 'collections.general.no_products' | t }}</div>

                            <button type="button" class="btn btn--text-link" data-clear-all-filters>
                              {{- 'filters.clear_filters' | t -}}
                            </button>
                          {%- else -%}
                            <div>{{ 'search.no_results' | t }}</div>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>

                  {%- if search.performed -%}
                    {%- if search.results_count > 0 -%}
                      {%- unless paginated -%}
                        <div>
                          {%- render 'pagination',
                            paginate: paginate,
                            type: 'general.pagination.results',
                            display_paginate_item_count_only: true
                          -%}

                          <div class="search__infinite-trigger">
                            {%- if paginate.next -%}
                              <a href="{{ paginate.next.url }}" class="btn btn--secondary no-transition">
                                {{- 'general.pagination.load_more' | t -}}
                              </a>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- endunless -%}

                      {%- if paginated -%}
                        <div>
                          {%- if paginate.pages > 1 -%}
                            {%- render 'pagination',
                              paginate: paginate,
                              type: 'general.pagination.results',
                              show_item_count: true
                            -%}
                          {%- else -%}
                            {%- render 'pagination',
                              paginate: paginate,
                              type: 'general.pagination.results',
                              display_paginate_item_count_only: true
                            -%}
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endpaginate -%}

      {%- render 'filter-drawer',
        resource: search,
        show_sort: section.settings.show_sort,
        show_filters: section.settings.show_filters,
        collapse_filter_groups: section.settings.collapse_filter_groups_mobile,
        active_filter_count: active_filter_count,
        show_swatch_filters: section.settings.show_swatch_filters,
        swatch_options: swatch_options,
        custom_color_key_map: custom_color_key_map,
        custom_color_value_map: custom_color_value_map,
        show_chip_filters: section.settings.show_chip_filters,
        chip_options: chip_options,
        chip_layout: section.settings.chip_layout
      -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "search-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main_search.settings.search.header.content"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.shared.collection_search.settings.results.columns_desktop.label",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.shared.collection_search.settings.results.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "rows",
      "label": "t:sections.shared.collection_search.settings.results.rows.label",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "7",
          "label": "7"
        },
        {
          "value": "8",
          "label": "8"
        },
        {
          "value": "9",
          "label": "9"
        },
        {
          "value": "10",
          "label": "10"
        }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_item_count",
      "label": "t:sections.shared.collection_search.settings.results.show_item_count.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.collection_search.settings.filtering.header.content"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:sections.shared.collection_search.settings.filtering.show_sort.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:sections.shared.collection_search.settings.filtering.show_filters.label",
      "info": "t:sections.shared.collection_search.settings.filtering.show_filters.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_filter_bar",
      "label": "t:sections.shared.collection_search.settings.filtering.enable_sticky_filter_bar.label",
      "default": true,
      "info": "t:sections.shared.collection_search.settings.filtering.enable_sticky_filter_bar.info"
    },
    {
      "type": "select",
      "id": "desktop_filter_location",
      "label": "t:sections.shared.collection_search.settings.filtering.desktop_filter_location.label",
      "options": [
        {
          "value": "filter_bar",
          "label": "t:sections.shared.collection_search.settings.filtering.desktop_filter_location.options.filter_bar"
        },
        {
          "value": "sidebar",
          "label": "t:sections.shared.collection_search.settings.filtering.desktop_filter_location.options.sidebar"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "collapse_filter_bar",
      "label": "t:sections.shared.collection_search.settings.filtering.collapse_filter_bar.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_filter_sidebar",
      "label": "t:sections.shared.collection_search.settings.filtering.enable_sticky_filter_sidebar.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "collapse_filter_groups_desktop",
      "label": "t:sections.shared.collection_search.settings.filtering.collapse_filter_groups_desktop.label",
      "default": true,
      "info": "t:sections.shared.collection_search.settings.filtering.collapse_filter_groups_desktop.info"
    },
    {
      "type": "checkbox",
      "id": "collapse_filter_groups_mobile",
      "label": "t:sections.shared.collection_search.settings.filtering.collapse_filter_groups_mobile.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatch_filters",
      "label": "t:sections.shared.collection_search.settings.filtering.show_swatch_filters.label",
      "default": true,
      "info": "t:sections.shared.collection_search.settings.filtering.show_swatch_filters.info"
    },
    {
      "type": "checkbox",
      "id": "show_chip_filters",
      "label": "t:sections.shared.collection_search.settings.filtering.show_chip_filters.label",
      "default": true,
      "info": "t:sections.shared.collection_search.settings.filtering.show_chip_filters.info"
    },
    {
      "type": "select",
      "id": "chip_layout",
      "label": "t:shared.settings.chip_layout.label",
      "options": [
        {
          "value": "3col",
          "label": "t:shared.settings.chip_layout.options.3col"
        },
        {
          "value": "2col",
          "label": "t:shared.settings.chip_layout.options.2col"
        },
        {
          "value": "natural",
          "label": "t:shared.settings.chip_layout.options.natural"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.shared.collection_search.settings.pagination.header.content"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.shared.collection_search.settings.pagination.pagination.label",
      "options": [
        {
          "value": "infinite",
          "label": "t:sections.shared.collection_search.settings.pagination.pagination.options.infinite"
        },
        {
          "value": "click",
          "label": "t:sections.shared.collection_search.settings.pagination.pagination.options.click"
        },
        {
          "value": "paginated",
          "label": "t:sections.shared.collection_search.settings.pagination.pagination.options.paginated"
        }
      ],
      "default": "paginated",
      "info": "t:sections.shared.collection_search.settings.pagination.pagination.info"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:shared.settings.section_style.section_width.label",
      "options": [
        {
          "value": "page-width",
          "label": "t:shared.settings.section_style.section_width.options.page_width"
        },
        {
          "value": "full-width-padded",
          "label": "t:shared.settings.section_style.section_width.options.full_width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:shared.settings.section_style.section_padding.top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:shared.settings.section_style.section_padding.bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.settings.section_style.divider_style.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.settings.section_style.divider_style.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_divider",
      "label": "t:shared.settings.section_style.enable_full_width_divider.label",
      "visible_if": "{{ section.settings.divider_style == 'solid' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "default": true,
      "info": "t:shared.settings.section_style.enable_animation.info"
    }
  ]
}
{% endschema %}
