<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    testimonials-slider
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--testimonials-slider
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="testimonials-slider"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
>
  <div class="testimonials-slider__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    <div
      class="
        testimonials-slider__section-header
        {% if settings.slider_navigation_placement == 'header' -%}
          carousel__navigation-wrapper
          carousel__navigation-wrapper--alignment-{{ section.settings.header_alignment }}
        {%- endif %}
      "
    >
      {%- liquid
        capture section_header
          render 'section-header', local_settings: section.settings, custom_class_prefix: 'testimonials-slider'
        endcapture

        assign carousel_navigation_class = 'testimonials-slider__navigation-buttons animation--controls'

        capture navigation_buttons
          if settings.slider_navigation_placement == 'header'
            render 'carousel-navigation', wrapper_class: carousel_navigation_class
          endif
        endcapture

        if settings.slider_navigation_placement == 'header'
          case section.settings.header_alignment
            when 'left'
              echo section_header
              echo navigation_buttons
            when 'center'
              render 'carousel-navigation-button', type: 'previous'
              echo section_header
              render 'carousel-navigation-button', type: 'next'
            when 'right'
              echo navigation_buttons
              echo section_header
          endcase
        else
          echo section_header
        endif
      -%}
    </div>

    {% liquid
      assign columns_small_desktop = section.settings.layout_columns | at_most: 3
      assign columns_tablet = section.settings.layout_columns | at_most: 2

      assign background = section.settings.color_scheme.settings.background
      assign background_gradient = section.settings.color_scheme.settings.background_gradient
      assign testimonials_background = section.settings.testimonials_color_scheme.settings.background
      assign testimonials_background_gradient = section.settings.testimonials_color_scheme.settings.background_gradient

      # If the testimonials background doesn't match the section background, we need padding on the testimonials
      if testimonials_background_gradient == background_gradient and testimonials_background_gradient != '' or testimonials_background == background
        assign testimonials_contain_in_card = false
      else
        assign testimonials_contain_in_card = true

        capture testimonials_color_vars
          render 'color-scheme-to-vars', prefix: 'testimonials', color_scheme: section.settings.testimonials_color_scheme
        endcapture
      endif

      if section.settings.section_width == 'page-width'
        assign max_view_width = '1400px'
      else
        assign max_view_width = '93.4vw'
      endif

      case section.settings.layout_columns
        when '5'
          assign sizes = '(min-width: 1400px) calc(([[mvw]] - (25px * 4)) / 5), (min-width: 1200px) calc((93.4vw - (25px * 4)) / 5), (min-width: 960px) calc((93.4vw - (17px * 2)) / 3), (min-width: 720px) calc((93.4vw - (17px * 1)) / 2), 93.4vw' | replace: '[[mvw]]', max_view_width
        when '4'
          assign sizes = '(min-width: 1400px) calc(([[mvw]] - (25px * 3)) / 4), (min-width: 1200px) calc((93.4vw - (25px * 3)) / 4), (min-width: 960px) calc((93.4vw - (17px * 2)) / 3), (min-width: 720px) calc((93.4vw - (17px * 1)) / 2), 93.4vw' | replace: '[[mvw]]', max_view_width
        when '3'
          assign sizes = '(min-width: 1400px) calc(([[mvw]] - (25px * 2)) / 3), (min-width: 1200px) calc((93.4vw - (25px * 2)) / 3), (min-width: 960px) calc((93.4vw - (17px * 2)) / 3), (min-width: 720px) calc((93.4vw - (17px * 1)) / 2), 93.4vw' | replace: '[[mvw]]', max_view_width
        when '2'
          assign sizes = '(min-width: 1400px) calc(([[mvw]] - (25px * 1)) / 2), (min-width: 1200px) calc((93.4vw - (25px * 1)) / 2), (min-width: 960px) calc((93.4vw - (17px * 1)) / 2), (min-width: 720px) calc((93.4vw - (17px * 1)) / 2), 93.4vw' | replace: '[[mvw]]', max_view_width
      endcase
    %}
    <div
      class="testimonials-slider__testimonials-wrapper carousel swiper"
      data-columns-desktop="{{ section.settings.layout_columns }}"
      data-columns-small-desktop="{{ columns_small_desktop }}"
      data-columns-tablet="{{ columns_tablet }}"
      data-column-alignment-desktop="{{ section.settings.column_alignment }}"
      data-column-alignment-mobile="{{ section.settings.column_alignment_mobile }}"
      data-slides-count="{{ section.blocks | size }}"
      data-testimonials-rating-star-size="{{ section.settings.testimonials_rating_star_size }}"
      data-testimonials-contain-in-card="{{ testimonials_contain_in_card }}"
      data-testimonials-card-padding="{{ section.settings.testimonials_card_padding }}"
      js-swiper
      style="
        --columns-desktop: {{ section.settings.layout_columns }};
        --columns-small-desktop: {{ columns_small_desktop }};
        --columns-tablet: {{ columns_tablet }};
        --testimonials-rating-text-size: var({{ section.settings.testimonials_rating_text_size }});
        --testimonials-rating-text-offset: {{ section.settings.testimonials_rating_text_offset }}px;
        --testimonials-heading-size: var({{ section.settings.testimonials_heading_size }});
        --testimonials-quote-size: var({{ section.settings.testimonials_quote_size }});
        --testimonials-author-size: var({{ section.settings.testimonials_author_size }});
        {{ testimonials_color_vars | strip }}
      "
    >
      <div class="testimonials-slider__testimonials carousel__wrapper swiper-wrapper">
        {%- for block in section.blocks -%}
          <div
            class="testimonials-slider__testimonial carousel__slide swiper-slide"
            data-block-index="{{ forloop.index0 }}"
            data-has-video="{% if block.settings.media_type == 'video' and block.settings.background_video != blank -%} true {%- else -%} false {%- endif %}"
            js-swiper-slide
            {{ block.shopify_attributes }}
          >
            {%- assign block_media = blank -%}

            {%- # whitespace: normal -%}
            {%- capture block_media -%}
              {% case block.settings.media_type %}
                {% when 'image' %}
                  {% render 'image',
                    wrapper_class: 'testimonials-slider-testimonial__image',
                    image: block.settings.image,
                    aspect_ratio: section.settings.testimonials_aspect_ratio,
                    focal_point: block.settings.focal_point,
                    sizes: sizes,
                    src_set_type: 'grid',
                    animate: true,
                    include_placeholder: true
                  %}

                {% when 'video' %}
                  {% render 'background-video',
                    class: 'testimonials-slider-testimonial__video',
                    video: block.settings.background_video,
                    aspect_ratio: section.settings.testimonials_aspect_ratio,
                    focal_point: block.settings.video_focal_point,
                    sizes: sizes,
                    enable_pause_button: false,
                    animate: true
                  %}
              {% endcase %}
            {%- endcapture -%}

            {% if block_media != blank %}
              <div class="testimonials-slider-testimonial__media-container">
                {%- if block.settings.media_link != blank -%}
                  <a href="{{ block.settings.media_link }}" aria-label="{{ block.settings.media_link }}">
                    {{- block_media -}}
                  </a>
                {%- else -%}
                  {{ block_media }}
                {%- endif -%}
              </div>
            {% endif %}

            <div class="testimonials-slider-testimonial__content">
              <div class="testimonials-slider-testimonial-content__upper-group">
                {% if block.settings.content_show_rating or block.settings.content_rating_text != blank %}
                  <div class="testimonials-slider-testimonial-content__rating">
                    {% if block.settings.content_show_rating %}
                      <div class="testimonials-slider-testimonial-content-rating__stars">
                        {% render 'star-rating', rating: block.settings.content_rating %}
                      </div>
                    {% endif %}
                    {% if block.settings.content_rating_text != blank %}
                      <div class="testimonials-slider-testimonial-content-rating__text">
                        {{ block.settings.content_rating_text }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.content_heading != blank or block.settings.content_quote != blank %}
                  <div class="testimonials-slider-testimonial-content__main">
                    {% if block.settings.content_heading != blank %}
                      <h4 class="testimonials-slider-testimonial-content-main__heading ff-heading">
                        {{ block.settings.content_heading }}
                      </h4>
                    {% endif %}
                    {% if block.settings.content_quote != blank %}
                      <div class="testimonials-slider-testimonial-content-main__quote {{ section.settings.testimonials_quote_font }} rte">
                        {{ block.settings.content_quote }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              {% if block.settings.content_author != blank %}
                <div class="testimonials-slider-testimonial-content__author">
                  {{ block.settings.content_author }}
                </div>
              {% endif %}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- liquid
        if settings.slider_navigation_placement == 'slider'
          render 'carousel-navigation', placement: 'slider'
        endif
      -%}
    </div>
  </div>
</div>

