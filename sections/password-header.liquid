{%- # This is done here AND in the JS so it's responsive in the theme editor before the JS is loaded -%}
{%- if section.settings.enable_transparent -%}
  <script>
    document.body.classList.add('header-transparent');
  </script>
{%- endif -%}

{%- liquid
  # Logo
  assign logo = section.settings.logo
  assign logo_width = section.settings.logo_width
  assign mobile_logo_width = section.settings.mobile_logo_width

  capture logo_sizes
    echo '(max-width: 960px) [[mlw]]px, [[lw]]px' | replace: '[[mlw]]', mobile_logo_width | replace: '[[lw]]', logo_width
  endcapture

  # Layout
  assign layout = section.settings.layout

  if layout contains 'logo-left'
    assign logo_position = 'left'
  else
    assign logo_position = 'center'
  endif

  # Transparent header
  assign header_transparent = section.settings.enable_transparent
  assign color_text_transparent = section.settings.color_text_transparent
-%}

{%- comment -%} theme-check-disable UnusedAssign {%- endcomment -%}
{%- assign font_logo = settings.font_logo -%}
{%- assign uppercase_logo = settings.uppercase_logo -%}
{%- assign logo_text_transform = settings.logo_text_transform -%}
{%- comment -%} theme-check-enable UnusedAssign {%- endcomment -%}

{%- capture header_logo -%}
  <h1 class="header__logo">
    <a
      href="{{ routes.root_url }}"
      class="header__logo-link"
      {% if logo != blank -%}
        aria-label="{{ shop.name }}"
      {%- endif %}
    >
      {%- liquid
        if logo != blank
          render 'image', image: logo, wrapper_class: 'regular-logo', sizes: logo_sizes, prioritize_loading: true
        endif

        if logo == blank
          echo '<span class="header__logo-text">[[sn]]</span>' | replace: '[[sn]]', shop.name
        endif
      -%}
    </a>
  </h1>
{%- endcapture -%}

<header
  class="
    section
    header
    header--password
    header--layout-{{ layout | replace: "_", "-" }}
    {% if logo != blank -%}
      header--has-logo
    {%- endif %}
    {% if header_transparent -%}
      header--transparent
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    --logo-width: {{ logo_width }}px;
    --mobile-logo-width: {{ mobile_logo_width }}px;
    --color-text-transparent: {{ color_text_transparent }};
  "
  data-section-id="{{ section.id }}"
  data-section-type="password-header"
  data-logo-position="{{ logo_position }}"
  {% if header_transparent -%}
    data-transparent-header="true"
  {%- endif -%}
>
  <div class="header__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    <div class="header__row header__row-desktop lower {% if logo_position == 'center' %}three-segment{% endif %}">
      <div class="header__row-segment header__row-segment-desktop left">
        {%- if logo_position == 'left' -%}
          {{- header_logo -}}
        {%- endif -%}
      </div>

      {%- if logo_position == 'center' -%}
        {{- header_logo -}}
      {%- endif -%}

      <div class="header__row-segment header__row-segment-desktop right">
        {%- render 'password-unlock', is_desktop: true -%}
      </div>
    </div>

    <div class="header__row header__row-mobile {% if logo_position == 'center' %}three-segment{% endif %}">
      <div class="header__row-segment left">
        {%- unless logo_position == 'center' -%}
          {{- header_logo -}}
        {%- endunless -%}
      </div>

      {%- if logo_position == 'center' -%}
        {{- header_logo -}}
      {%- endif -%}

      <div class="header__row-segment right">
        {%- render 'password-unlock' -%}
      </div>
    </div>

    {%- if section.settings.divider_style != 'none' -%}
      <span
        class="
          header__divider
          header__divider--style-{{ section.settings.divider_style }}
          header__divider--full-width-{{ section.settings.enable_full_width_divider }}
        "
      ></span>
    {%- endif -%}
  </div>
</header>

<script>
  // Set heading height at component level
  const header = document.querySelector('#shopify-section-password-header');
  document.documentElement.style.setProperty('--height-header', header.offsetHeight + 'px');
</script>

{% schema %}
{
  "name": "t:sections.password_header.name",
  "class": "header__outer-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.password_header.settings.layout.label",
      "options": [
        {
          "value": "logo-center",
          "label": "t:sections.password_header.settings.layout.options.center"
        },
        {
          "value": "logo-left",
          "label": "t:sections.password_header.settings.layout.options.left"
        }
      ]
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:sections.shared.header.settings.divider_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.shared.header.settings.divider_style.options.none"
        },
        {
          "value": "thin",
          "label": "t:sections.shared.header.settings.divider_style.options.thin"
        },
        {
          "value": "thick",
          "label": "t:sections.shared.header.settings.divider_style.options.thick"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_divider",
      "label": "t:sections.shared.header.settings.enable_full_width_divider.label",
      "default": true,
      "visible_if": "{{ section.settings.divider_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:sections.shared.header.settings.logo.header.content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.shared.header.settings.logo.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.shared.header.settings.logo.logo_width.label",
      "min": 50,
      "max": 350,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "t:sections.shared.header.settings.logo.mobile_logo_width.label",
      "min": 50,
      "max": 250,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "t:sections.password_header.settings.transparent_header.header.content"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent",
      "label": "t:sections.password_header.settings.transparent_header.enable_transparent.label",
      "default": true,
      "info": "t:sections.password_header.settings.transparent_header.enable_transparent.info"
    },
    {
      "type": "color",
      "id": "color_text_transparent",
      "label": "t:sections.password_header.settings.transparent_header.color_text_transparent.label",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:shared.settings.section_style.section_width.label",
      "options": [
        {
          "value": "page-width",
          "label": "t:shared.settings.section_style.section_width.options.page_width"
        },
        {
          "value": "full-width-padded",
          "label": "t:shared.settings.section_style.section_width.options.full_width"
        }
      ],
      "default": "page-width"
    }
  ]
}
{% endschema %}
