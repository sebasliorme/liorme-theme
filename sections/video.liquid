{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0

  # Alignment
  assign text_position = section.settings.text_position | split: '_'
  assign horizontal_position = text_position | first
  assign vertical_position = text_position | last
  assign text_position_modifier = 'center'

  if horizontal_position == 'flex-start'
    assign text_position_modifier = 'left'
  elsif horizontal_position == 'flex-end'
    assign text_position_modifier = 'right'
  endif

  # Aspect ratio and focal point
  assign media_aspect_ratio = section.settings.media_aspect_ratio
  assign video_focal_alignment = section.settings.focal_point | replace: '_', ' '

  # Video type
  assign is_shopify_video = false
  assign is_external_video = false

  if section.settings.video_source == 'shopify' and section.settings.video != blank
    assign is_video = true
    assign is_shopify_video = true
  elsif section.settings.video_source == 'external' and section.settings.video_url != blank
    assign is_video = true
    assign is_external_video = true
  else
    assign is_video = false
  endif

  # Play button
  assign play_button_blocks = section.blocks | where: 'type', 'play-button'

  if play_button_blocks.size > 0
    assign has_play_button = true
  else
    assign has_play_button = false
  endif

  # Placeholder
  if is_video
    assign include_placeholder = false
  else
    assign include_placeholder = true
  endif
-%}

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    section--enable-mobile-padding-{{ section.settings.enable_padding_on_mobile }}
    video
    video--{{ media_aspect_ratio }}
    video--text-{{ text_position_modifier }}
    video--text-mobile-{{ section.settings.text_position_mobile }}
    {% if is_video -%}
      video--has-video
    {%- endif %}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--video
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="video"
  style="
    {%- render 'color-scheme-to-vars',
      color_scheme: section.settings.color_scheme,
      css_vars:'background,background-gradient,text,links,links-alpha-60,lines-and-borders'
    -%}
    {%- render 'section-padding-vars' -%}
    --text-horizontal-position: {{ horizontal_position }};
    --text-vertical-position: {{ vertical_position }};
    --text-horizontal-position-mobile: {{ section.settings.text_position_mobile }};
    --overlay-opacity: {{ overlay_opacity }};
    --focal-alignment: {{ video_focal_alignment }};
  "
>
  <div class="video__text-intro section-introduction animation--section-introduction">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- render 'section-block-heading',
            heading_tag: block.settings.heading_tag,
            heading: block.settings.title,
            heading_font_class: block.settings.heading_font_class,
            is_section_introduction: true,
            custom_class: 'video__heading'
          -%}

        {%- when 'subheading' -%}
          {%- render 'section-block-subheading',
            subheading_tag: block.settings.subheading_tag,
            subheading: block.settings.subheading,
            subheading_font_class: block.settings.subheading_font_class,
            is_section_introduction: true,
            custom_class: 'video__subheading'
          -%}

        {%- when 'text' -%}
          {%- render 'section-block-text',
            text: block.settings.text,
            text_font_class: block.settings.text_font_class,
            is_section_introduction: true,
            custom_class: 'video__text'
          -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div
    class="
      video__inner
      section-inner
      section-inner--width-{{ section.settings.section_width }}
      section-inner--mobile-full-width-{{ section.settings.enable_full_width_on_mobile }}
    "
    style="
      {%- render 'color-scheme-to-vars',
       color_scheme: section.settings.overlay_color_scheme,
       output_placeholder_colors: false
      -%}
    "
  >
    <div class="video__media-container">
      <div class="video__video-wrapper video-wrapper aspect-ratio--{{ media_aspect_ratio }}">
        {%- if is_shopify_video -%}
          {{
            section.settings.video
            | video_tag: loop: section.settings.loop, controls: false, image_size: '1400x'
            | replace: '<video', '<video class="video__video video"'
          }}
        {%- elsif is_external_video -%}
          <div
            class="video__iframe"
            data-video-external-target
            data-video-provider="{{ section.settings.video_url.type }}"
            data-video-id="{{ section.settings.video_url.id | escape }}"
            data-loop="{{ section.settings.loop }}"
          ></div>
        {%- else -%}
          {% comment %}
            This is the state when there is not a correct source set, we need
            something rendered to size the section correctly
          {% endcomment %}
          <div class="video__undefined_spacer"></div>
        {%- endif -%}
      </div>

      {%- render 'image',
        wrapper_class: 'video__image overlay visible',
        image: section.settings.image,
        sizes: '(min-width: 960px) calc(100vw - calc(2 * 3.3vw)), calc(100vw - calc(2 * clamp(18px, 3.3vw, 3.3vw)))',
        aspect_ratio: media_aspect_ratio,
        focal_point: section.settings.focal_point,
        include_placeholder: include_placeholder,
        placeholder_name: 'lifestyle-2',
        animate: true
      -%}
    </div>

    <div class="video__overlay visible"></div>

    <div class="video__text-container-wrapper visible {%- unless has_play_button %} enable-pointer{%- endunless -%}">
      <div class="video__text-container section-blocks animation--section-blocks">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- render 'section-block-heading',
                heading_tag: block.settings.heading_tag,
                heading: block.settings.title,
                heading_font_class: block.settings.heading_font_class,
                class_prefix: 'video__text-container'
              -%}
            {%- when 'subheading' -%}
              {%- render 'section-block-subheading',
                subheading_tag: block.settings.subheading_tag,
                subheading: block.settings.subheading,
                subheading_font_class: block.settings.subheading_font_class,
                class_prefix: 'video__text-container'
              -%}

            {%- when 'text' -%}
              {%- render 'section-block-text',
                text: block.settings.text,
                text_font_class: block.settings.text_font_class,
                class_prefix: 'video__text-container'
              -%}

            {%- when 'play-button' -%}
              {%- render 'play-button',
                is_remote: true,
                label: block.settings.text,
                icon_style: block.settings.icon_style,
                enable_custom_button_color: block.settings.enable_custom_button_color,
                custom_button_color: block.settings.custom_button_color,
                button_layout: block.settings.button_layout,
                button_alignment: text_position_modifier,
                wrapper_class: 'video__text-container-text-play-button section-blocks__video-button',
                has_video: false,
                shopify_attributes: block.shopify_attributes
              -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

