<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    gallery-carousel
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--gallery-carousel
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="gallery-carousel"
  data-loop-carousel="{{ section.settings.loop_carousel }}"
  data-products-per-view="{{ section.settings.columns }}"
  data-mobile-products-per-view="{{ section.settings.mobile_columns }}"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
>
  <div class="gallery-carousel__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    <div
      class="
        gallery-carousel__meta
        {% if settings.slider_navigation_placement == 'header' -%}
          carousel__navigation-wrapper
          carousel__navigation-wrapper--alignment-{{ section.settings.header_alignment }}
        {%- endif -%}
      "
    >
      {%- liquid
        capture section_header
          render 'section-header', local_settings: section.settings, custom_class_prefix: 'gallery-carousel'
        endcapture

        if settings.slider_navigation_placement == 'header'
          case section.settings.header_alignment
            when 'left'
              echo section_header
              render 'carousel-navigation', wrapper_class: 'animation--controls'
            when 'center'
              render 'carousel-navigation-button', type: 'previous'
              echo section_header
              render 'carousel-navigation-button', type: 'next'
            when 'right'
              render 'carousel-navigation', wrapper_class: 'animation--controls'
              echo section_header
          endcase
        else
          echo section_header
        endif
      -%}
    </div>

    <div
      class="
        gallery-carousel__content
        carousel
        carousel--per-view-{{ section.settings.columns }}
        carousel--mobile-per-view-{{ section.settings.mobile_columns }}
        swiper
      "
    >
      <div class="gallery-carousel__items carousel__wrapper swiper-wrapper">
        {%- liquid
          capture image_sizes
            echo '(min-width: 720px) calc(calc(100vw - calc(2 * clamp(18px, 3.3vw, 3.3vw))) / [[ssc]]),' | replace: '[[ssc]]', section.settings.columns
            echo 'calc(calc(100vw - calc(2 * clamp(18px, 3.3vw, 3.3vw))) / [[ssmc]])' | replace: '[[ssmc]]', section.settings.mobile_columns
          endcapture
        -%}

        {%- for block in section.blocks -%}
          <div class="gallery-carousel__item carousel__slide swiper-slide">
            {%- render 'gallery-item',
              block: block,
              aspect_ratio: section.settings.aspect_ratio,
              label_style: section.settings.image_caption_style,
              label_size: section.settings.image_caption_size,
              overlay_text_background_style: section.settings.overlay_text_background_style,
              overlay_color_scheme: section.settings.overlay_color_scheme,
              image_sizes: image_sizes
            -%}
          </div>
        {%- endfor -%}
      </div>

      {%- liquid
        if settings.slider_navigation_placement == 'slider'
          render 'carousel-navigation', placement: 'slider'
        endif
      -%}
    </div>
  </div>
</div>

