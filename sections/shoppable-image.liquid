{{ 'component-shoppable.css' | asset_url | stylesheet_tag }}

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    section--enable-mobile-padding-{{ section.settings.enable_padding_on_mobile }}
    shoppable-image
    shoppable-image--{{ section.settings.aspect_ratio }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--shoppable-image
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="shoppable"
  data-show-hotspot-cards="true"
>
  <div
    class="
      section-inner
      section-inner--width-{{ section.settings.section_width }}
      section-inner--mobile-full-width-{{ section.settings.enable_full_width_on_mobile }}
    "
  >
    <div
      class="
        shoppable-image__text-intro
        section-introduction
        section-introduction--alignment-{{ section.settings.header_alignment }}
        animation--section-introduction
      "
    >
      {%- render 'section-block-heading',
        heading_tag: section.settings.heading_tag,
        heading: section.settings.heading,
        heading_font_class: section.settings.heading_font_class,
        is_section_introduction: true
      -%}

      {%- render 'section-block-text',
        text: section.settings.text,
        text_font_class: section.settings.text_font_class,
        is_section_introduction: true
      -%}

      {%- render 'button-block',
        link: section.settings.link,
        label: section.settings.link_text,
        button_style: section.settings.button_style,
        button_alignment: 'center',
        wrapper_class: 'section-introduction__button'
      -%}
    </div>

    <div class="shoppable-image__image-container shoppable__image-container">
      <div class="shoppable-image__image-container-inner">
        <div class="shoppable-image__image-wrapper">
          {%- render 'image',
            image: section.settings.image,
            wrapper_class: 'shoppable-image__image',
            focal_point: 'image_presentation',
            aspect_ratio: section.settings.aspect_ratio,
            placeholder_name: 'collection-4',
            include_placeholder: true,
            placeholder_natural_fallback_ratio: 'landscape',
            sizes: '(min-width: 960px) calc(100vw - calc(2 * 3.3vw)), calc(100vw - calc(2 * clamp(18px, 3.3vw, 3.3vw)))',
            animate: true
          -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- render 'shoppable-item',
          block: block,
          index: forloop.index0,
          product_item: block.settings.product_item,
          horizontal_position: block.settings.horizontal_position,
          vertical_position: block.settings.vertical_position,
          aspect_ratio: section.settings.aspect_ratio,
          hotspot_color_scheme: section.settings.hotspot_color_scheme
        -%}
      {%- endfor -%}
    </div>
  </div>

  {%- liquid
    capture swiper_content
      render 'shoppable-item-swiper-content', blocks: section.blocks, image_size: section.settings.image_size
    endcapture

    assign mobile_drawer_class = 'shoppable-feature-mobile-drawer animation--shoppable-feature-mobile-drawer'

    render 'mobile-drawer', content: swiper_content, class: mobile_drawer_class
  -%}
</div>

{% schema %}
{
