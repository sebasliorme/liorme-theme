      "default": "center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shoppable_image.settings.section_header.heading.label",
      "default": "t:sections.shoppable_image.settings.section_header.heading.default"
    },
    {
      "type": "select",
