{%- render 'collection-list-grid-slider', type: 'grid', section: section -%}

{% schema %}
{
  "name": "t:sections.collection_list_grid.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:shared.section_header.header.content"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:shared.settings.alignment_horizontal.header.label",
      "options": [
        {
          "value": "left",
          "label": "t:shared.options.alignment.horizontal.left"
        },
        {
          "value": "center",
          "label": "t:shared.options.alignment.horizontal.center"
        },
        {
          "value": "right",
          "label": "t:shared.options.alignment.horizontal.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shared.collections.settings.title.label",
      "default": "t:sections.collection_list_grid.settings.title.default"
    },
    {
      "type": "select",
      "id": "heading_font_class",
      "label": "t:shared.settings.heading_font_class.label",
      "options": [
        {
          "value": "fs-heading-6-base",
          "label": "t:shared.settings.heading_font_class.options.xx_small"
        },
        {
          "value": "fs-heading-5-base",
          "label": "t:shared.settings.heading_font_class.options.x_small"
        },
        {
          "value": "fs-heading-4-base",
          "label": "t:shared.settings.heading_font_class.options.small"
        },
        {
          "value": "fs-heading-3-base",
          "label": "t:shared.settings.heading_font_class.options.medium"
        },
        {
          "value": "fs-heading-2-base",
          "label": "t:shared.settings.heading_font_class.options.large"
        },
        {
          "value": "fs-heading-1-base",
          "label": "t:shared.settings.heading_font_class.options.x_large"
        },
        {
          "value": "fs-heading-display-3",
          "label": "t:shared.settings.heading_font_class.options.display_regular"
        },
        {
          "value": "fs-heading-display-2",
          "label": "t:shared.settings.heading_font_class.options.display_large"
        },
        {
          "value": "fs-heading-display-1",
          "label": "t:shared.settings.heading_font_class.options.display_x_large"
        }
      ],
      "default": "fs-heading-3-base"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:shared.settings.heading_tag.heading.label",
      "options": [
        {
          "value": "h2",
          "label": "t:shared.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:shared.settings.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:shared.settings.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:shared.settings.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:shared.settings.heading_tag.options.h6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "paragraph",
      "content": "t:shared.settings.heading_tag.heading.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.shared.collections.settings.text.label"
    },
    {
      "type": "select",
      "id": "text_font_class",
      "label": "t:shared.settings.text_font_class.label",
      "options": [
        {
          "value": "fs-body-25",
          "label": "t:shared.settings.text_font_class.options.xx_small"
        },
        {
          "value": "fs-body-50",
          "label": "t:shared.settings.text_font_class.options.x_small"
        },
        {
          "value": "fs-body-75",
          "label": "t:shared.settings.text_font_class.options.small"
        },
        {
          "value": "fs-body-100",
          "label": "t:shared.settings.text_font_class.options.regular"
        },
        {
          "value": "fs-body-150",
          "label": "t:shared.settings.text_font_class.options.large"
        },
        {
          "value": "fs-body-200",
          "label": "t:shared.settings.text_font_class.options.x_large"
        },
        {
          "value": "fs-body-250",
          "label": "t:shared.settings.text_font_class.options.2x_large"
        },
        {
          "value": "fs-body-300",
          "label": "t:shared.settings.text_font_class.options.3x_large"
        },
        {
          "value": "fs-body-350",
          "label": "t:shared.settings.text_font_class.options.4x_large"
        },
        {
          "value": "fs-body-400",
          "label": "t:shared.settings.text_font_class.options.5x_large"
        }
      ],
      "default": "fs-body-100"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:shared.settings.button_link.label",
      "default": "/collections"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:shared.settings.button_link_text.label",
      "default": "t:sections.collection_list_grid.settings.link_text.default"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:shared.settings.button_style.label",
      "options": [
        {
          "value": "btn--primary",
          "label": "t:shared.settings.button_style.options.solid"
        },
        {
          "value": "btn--secondary",
          "label": "t:shared.settings.button_style.options.outline"
        },
        {
          "value": "btn--callout",
          "label": "t:shared.settings.button_style.options.text"
        }
      ],
      "default": "btn--callout"
    },
    {
      "type": "header",
      "content": "t:sections.shared.collections.settings.collection_list.header.content"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:shared.settings.column_count.desktop.label",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:shared.settings.column_count.mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:sections.shared.collections.settings.collection_list.collection_list.label"
    },
    {
      "type": "header",
      "content": "t:sections.shared.collections.settings.collection_listing.header.content"
    },
    {
      "type": "select",
      "id": "collection_listing_aspect_ratio",
      "label": "t:sections.shared.collections.settings.collection_listing.aspect_ratio.label",
      "options": [
        {
          "value": "natural",
          "label": "t:shared.options.aspect_ratio.natural"
        },
        {
          "value": "square",
          "label": "t:shared.options.aspect_ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:shared.options.aspect_ratio.portrait"
        },
        {
          "value": "landscape",
          "label": "t:shared.options.aspect_ratio.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "label_font",
      "label": "t:sections.shared.collections.settings.collection_listing.label_font.label",
      "options": [
        {
          "value": "ff-heading",
          "label": "t:shared.settings.font_choice.options.heading"
        },
        {
          "value": "ff-body",
          "label": "t:shared.settings.font_choice.options.body"
        }
      ]
    },
    {
      "type": "select",
      "id": "label_size",
      "label": "t:sections.shared.collections.settings.collection_listing.label_size.label",
      "options": [
        {
          "value": "fs-body-25",
          "label": "t:shared.settings.text_font_class.options.xx_small"
        },
        {
          "value": "fs-body-50",
          "label": "t:shared.settings.text_font_class.options.x_small"
        },
        {
          "value": "fs-body-75",
          "label": "t:shared.settings.text_font_class.options.small"
        },
        {
          "value": "fs-body-100",
          "label": "t:shared.settings.text_font_class.options.regular"
        },
        {
          "value": "fs-body-150",
          "label": "t:shared.settings.text_font_class.options.large"
        },
        {
          "value": "fs-body-200",
          "label": "t:shared.settings.text_font_class.options.x_large"
        },
        {
          "value": "fs-body-250",
          "label": "t:shared.settings.text_font_class.options.2x_large"
        },
        {
          "value": "fs-body-300",
          "label": "t:shared.settings.text_font_class.options.3x_large"
        },
        {
          "value": "fs-body-350",
          "label": "t:shared.settings.text_font_class.options.4x_large"
        },
        {
          "value": "fs-body-400",
          "label": "t:shared.settings.text_font_class.options.5x_large"
        }
      ],
      "default": "fs-body-100"
    },
    {
      "type": "select",
      "id": "label_style",
      "label": "t:sections.shared.collections.settings.collection_listing.label_style.label",
      "options": [
        {
          "value": "overlay",
          "label": "t:shared.settings.overlay_text.placement.options.overlay"
        },
        {
          "value": "beneath",
          "label": "t:shared.settings.overlay_text.placement.options.beneath"
        }
      ],
      "default": "overlay"
    },
    {
      "type": "select",
      "id": "overlay_title_background_style",
      "label": "t:shared.settings.overlay_text.overlay_background_style.label_title",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.settings.overlay_text.overlay_background_style.options.solid"
        },
        {
          "value": "gradient",
          "label": "t:shared.settings.overlay_text.overlay_background_style.options.gradient"
        }
      ],
      "default": "gradient",
      "visible_if": "{{ section.settings.label_style == 'overlay' }}"
    },
    {
      "type": "color_scheme",
      "id": "overlay_color_scheme",
      "label": "t:shared.settings.overlay_text.overlay_color_scheme.label",
      "default": "scheme_4",
      "visible_if": "{{ section.settings.label_style == 'overlay' }}"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:shared.settings.section_style.section_width.label",
      "options": [
        {
          "value": "page-width",
          "label": "t:shared.settings.section_style.section_width.options.page_width"
        },
        {
          "value": "full-width-padded",
          "label": "t:shared.settings.section_style.section_width.options.full_width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:shared.settings.section_style.section_padding.top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:shared.settings.section_style.section_padding.bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.settings.section_style.divider_style.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.settings.section_style.divider_style.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_divider",
      "label": "t:shared.settings.section_style.enable_full_width_divider.label",
      "visible_if": "{{ section.settings.divider_style == 'solid' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "default": true,
      "info": "t:shared.settings.section_style.enable_animation.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list_grid.presets.name"
    }
  ]
}
{% endschema %}
