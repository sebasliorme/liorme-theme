{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile

  capture image_sizes
    echo '(min-width: 960px) calc(100vw / [[cols]]), calc(100vw / [[mcols]])' | replace: '[[cols]]', columns_desktop | replace: '[[mcols]]', columns_mobile
  endcapture

  assign heading_custom_class = 'instagram-section__heading instagram-section__heading--' | append: section.settings.header_alignment
-%}

{% style %}
  .instagram-section__grid {
    display: grid;
    grid-template-columns: repeat({{ columns_mobile }}, 1fr);
    gap: 5px;
    margin: 0;
  }

  @media (min-width: 960px) {
    .instagram-section__grid {
      grid-template-columns: repeat({{ columns_desktop }}, 1fr);
    }
  }

  .instagram-section__item {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .instagram-section__item .image,
  .instagram-section__item .background-video,
  .instagram-section__item .background-video__placeholder {
    height: 100%;
  }

  .instagram-section__media {
    aspect-ratio: 4 / 5 !important;
  }

  .instagram-section__media img,
  .instagram-section__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .instagram-section__hover {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .instagram-section__item:hover .instagram-section__hover {
    opacity: 1;
  }

  .instagram-section__hover .icon {
    width: 32px;
    height: 32px;
    color: #ffffff;
  }

  .instagram-section__heading {
    font-size: 1.7rem;
    padding-bottom: 2.5%;
    text-transform: none;
  }

  .instagram-section__heading--left {
    text-align: left;
  }

  .instagram-section__heading--center {
    text-align: center;
  }

  .instagram-section__heading--right {
    text-align: right;
  }
{% endstyle %}

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    instagram-section
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--instagram-section
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="instagram"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
>
  <div class="instagram-section__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    {%- if section.settings.heading != blank -%}
      {%- render 'section-block-heading',
        heading_tag: section.settings.heading_tag,
        heading: section.settings.heading,
        heading_font_class: section.settings.heading_font_class,
        custom_class: heading_custom_class
      -%}
    {%- endif -%}

    <div class="instagram-section__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_link = false
          if block.settings.link != blank
            assign has_link = true
          endif

          assign tile_tag = 'div'
          if has_link
            assign tile_tag = 'a'
          endif
        -%}

        <{{ tile_tag }}
          class="instagram-section__item"
          {% if has_link -%}
            href="{{ block.settings.link }}"
            target="_blank"
            rel="noopener"
            aria-label="View on Instagram"
          {%- endif %}
          {{ block.shopify_attributes }}
        >
          {%- case block.settings.media_type -%}
            {%- when 'video' -%}
              {%- render 'background-video',
                video: block.settings.video,
                aspect_ratio: 'square',
                focal_point: 'center',
                enable_pause_button: false,
                class: 'instagram-section__media',
                placeholder_name: 'lifestyle-1'
              -%}
            {%- else -%}
              {%- render 'image',
                wrapper_class: 'instagram-section__media',
                image: block.settings.image,
                aspect_ratio: 'square',
                focal_point: 'image_presentation',
                sizes: image_sizes,
                src_set_type: 'grid',
                include_placeholder: true,
                placeholder_name: 'lifestyle-1'
              -%}
          {%- endcase -%}

          <div class="instagram-section__hover">
            {%- render 'icon', icon: 'instagram' -%}
          </div>
        </{{ tile_tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Instagram",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow us on Instagram"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_font_class",
      "label": "Heading size",
      "options": [
        { "value": "fs-heading-6-base", "label": "XX small" },
        { "value": "fs-heading-5-base", "label": "X small" },
        { "value": "fs-heading-4-base", "label": "Small" },
        { "value": "fs-heading-3-base", "label": "Medium" },
        { "value": "fs-heading-2-base", "label": "Large" },
        { "value": "fs-heading-1-base", "label": "X large" }
      ],
      "default": "fs-heading-3-base"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width-padded", "label": "Full width, padded" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_divider",
      "label": "Make divider full width",
      "visible_if": "{{ section.settings.divider_style == 'solid' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable scroll animation",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram post",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Content type",
          "options": [
            { "value": "image", "label": "Photo" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Opens in a new tab. Leave blank to disable the link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
