{%- liquid
  assign horizontal_position = 'center'
  assign vertical_position = 'center'
  assign text_position_modifier = 'center'
-%}

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    section--enable-mobile-padding-{{ section.settings.enable_padding_on_mobile }}
    password
    password--image-aspect-{{ section.settings.image_aspect }}
    password--text-{{ text_position_modifier }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--password
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
    --custom-height: {{ section.settings.desktop_height }}vh;
    --custom-height-mobile: {{ section.settings.mobile_height }}vh;
    --text-horizontal-position: {{ horizontal_position }};
    --text-vertical-position: {{ vertical_position }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
  data-section-id="{{ section.id }}"
  data-section-type="password"
  data-section-height-type="{{ section.settings.image_aspect }}"
>
  <div
    class="
      password__inner
      section-inner
      section-inner--width-{{ section.settings.section_width }}
      section-inner--mobile-full-width-{{ section.settings.enable_full_width_on_mobile }}
    "
    {% if section.settings.background_type == 'image' -%}
      style="
        {%- render 'color-scheme-to-vars',
          color_scheme: section.settings.overlay_color_scheme,
          output_placeholder_colors: false
        -%}
      "
    {%- endif -%}
  >
    {%- if section.settings.background_type == 'image' -%}
      <div class="password__image-container">
        {%- if section.settings.image_mobile != blank -%}
          {%- render 'image',
            wrapper_class: 'password__image password__image--mobile',
            image: section.settings.image_mobile,
            sizes: '100vw',
            focal_point: section.settings.mobile_focal_point,
            animate: true
          -%}
        {%- endif -%}

        {%- render 'image',
          wrapper_class: 'password__image',
          image: section.settings.image,
          sizes: '100vw',
          focal_point: section.settings.focal_point,
          animate: true,
          include_placeholder: true
        -%}
      </div>

      <div class="password__overlay"></div>
    {%- endif -%}

    <div class="password__text-container-wrapper">
      <div class="password__text-container">
        <div class="password__text-container-inner section-blocks animation--section-blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'accent' -%}
                {%- render 'section-block-accent',
                  accent: block.settings.accent,
                  class_prefix: 'password__text-container'
                -%}
              {%- when 'heading' -%}
                {%- render 'section-block-heading',
                  heading_tag: block.settings.heading_tag,
                  heading: block.settings.title,
                  heading_font_class: block.settings.heading_font_class,
                  class_prefix: 'password__text-container'
                -%}
              {%- when 'text' -%}
                {%- render 'section-block-text',
                  text: block.settings.text,
                  text_font_class: block.settings.text_font_class,
                  class_prefix: 'password__text-container'
                -%}
              {%- when 'newsletter_signup' -%}
                {%- assign success_msg = 'general.password_page.signup_form_success' | t -%}

                <div
                  class="password__form-wrapper section-blocks__form"
                  data-collect-customer-name="{{ block.settings.enable_collect_customer_name }}"
                >
                  {%- assign custom_button_label = 'general.password_page.signup_form_button_label' | t -%}

                  {%- render 'newsletter-form',
                    form_id: 'password-signup',
                    base_class: 'password__notify',
                    success_msg: success_msg,
                    additional_form_classes: 'password__signup-form',
                    custom_button: true,
                    custom_button_id: 'Subscribe-password',
                    custom_button_class: 'password__signup-button',
                    custom_button_label: custom_button_label,
                    enable_collect_customer_name: block.settings.enable_collect_customer_name,
                    form_tags: 'prospect, password page'
                  -%}
                </div>
              {%- when 'share_icons' -%}
                <div class="password__share-icons section-blocks__text">
                  {%- render 'share-icons', url: shop.url, title: shop.name -%}
                </div>
              {%- when 'social_icons' -%}
                {%- render 'social-icons-block' -%}
              {%- when 'spacer' -%}
                {%- render 'spacer-block', space: block.settings.space -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "shopify-section--full-width",
  "settings": [
    {
      "type": "radio",
      "id": "image_aspect",
      "label": "t:sections.main_password.settings.image_aspect.label",
      "options": [
        {
          "value": "original",
          "label": "t:shared.settings.image_height.image_aspect.options.original"
        },
        {
          "value": "custom",
          "label": "t:shared.settings.image_height.image_aspect.options.custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "t:shared.settings.image_height.desktop_height.label",
      "min": 25,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.image_aspect == 'custom' }}"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "t:shared.settings.image_height.mobile_height.label",
      "min": 25,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.image_aspect == 'custom' }}"
    },
    {
      "type": "paragraph",
      "content": "t:shared.settings.image_height.paragraph.content_original",
      "visible_if": "{{ section.settings.image_aspect == 'original' }}"
    },
    {
      "type": "paragraph",
      "content": "t:shared.settings.image_height.paragraph.content_custom",
      "visible_if": "{{ section.settings.image_aspect == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:shared.settings.banner_bar_background.header.content"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:shared.settings.banner_bar_background.background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:shared.settings.banner_bar_background.background_type.options.color"
        },
        {
          "value": "image",
          "label": "t:shared.settings.banner_bar_background.background_type.options.image"
        }
      ],
      "default": "image"
    },
    {
      "type": "color_scheme",
      "id": "background_color_scheme",
      "label": "t:shared.settings.color_scheme.label",
      "default": "scheme_1",
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:shared.settings.background_image.image.label",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:shared.settings.background_image.mobile_image.label",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "t:shared.settings.focal_point.image.default.label",
      "options": [
        {
          "value": "image_presentation",
          "label": "t:shared.options.focal_point.image_presentation"
        },
        {
          "value": "center",
          "label": "t:shared.options.focal_point.center"
        },
        {
          "value": "top",
          "label": "t:shared.options.focal_point.top"
        },
        {
          "value": "bottom",
          "label": "t:shared.options.focal_point.bottom"
        },
        {
          "value": "left",
          "label": "t:shared.options.focal_point.left"
        },
        {
          "value": "right",
          "label": "t:shared.options.focal_point.right"
        }
      ],
      "default": "image_presentation",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "mobile_focal_point",
      "label": "t:shared.settings.focal_point.image.mobile.label",
      "options": [
        {
          "value": "image_presentation",
          "label": "t:shared.options.focal_point.image_presentation"
        },
        {
          "value": "center",
          "label": "t:shared.options.focal_point.center"
        },
        {
          "value": "top",
          "label": "t:shared.options.focal_point.top"
        },
        {
          "value": "bottom",
          "label": "t:shared.options.focal_point.bottom"
        },
        {
          "value": "left",
          "label": "t:shared.options.focal_point.left"
        },
        {
          "value": "right",
          "label": "t:shared.options.focal_point.right"
        }
      ],
      "default": "image_presentation",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:shared.settings.overlay.background_image_overlay.header.content",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "color_scheme",
      "id": "overlay_color_scheme",
      "label": "t:shared.settings.color_scheme.label",
      "default": "scheme_4",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:shared.settings.overlay.overlay_opacity.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30,
      "info": "t:shared.settings.overlay.overlay_opacity.info",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:shared.settings.section_style.section_width.label",
      "options": [
        {
          "value": "page-width",
          "label": "t:shared.settings.section_style.section_width.options.page_width"
        },
        {
          "value": "full-width",
          "label": "t:shared.settings.section_style.section_width.options.full_width"
        },
        {
          "value": "full-width-padded",
          "label": "t:shared.settings.section_style.section_width.options.full_width_padded"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_on_mobile",
      "label": "t:shared.settings.section_style.enable_full_width_on_mobile.label",
      "visible_if": "{{ section.settings.section_width != 'full-width' and section.settings.section_width != 'full-width-background-only' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_padding_on_mobile",
      "label": "t:shared.settings.section_style.enable_padding_on_mobile.label",
      "default": false,
      "visible_if": "{{ section.settings.enable_full_width_on_mobile and section.settings.section_width != 'full-width' and section.settings.section_width != 'full-width-background-only' }}"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:shared.settings.section_style.section_padding.top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:shared.settings.section_style.section_padding.bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.settings.section_style.divider_style.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.settings.section_style.divider_style.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_divider",
      "label": "t:shared.settings.section_style.enable_full_width_divider.label",
      "visible_if": "{{ section.settings.divider_style == 'solid' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "default": true,
      "info": "t:shared.settings.section_style.enable_animation.info"
    }
  ],
  "blocks": [
    {
      "type": "accent",
      "name": "t:shared.section_blocks.accent.name",
      "settings": [
        {
          "type": "text",
          "id": "accent",
          "label": "t:shared.section_blocks.accent.settings.accent.label",
          "default": "t:shared.section_blocks.accent.settings.accent.default"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:shared.section_blocks.heading.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:shared.section_blocks.heading.settings.title.label",
          "default": "t:sections.main_password.blocks.heading.settings.title.default"
        },
        {
          "type": "select",
          "id": "heading_font_class",
          "label": "t:shared.settings.heading_font_class.label",
          "options": [
            {
              "value": "fs-heading-6-base",
              "label": "t:shared.settings.heading_font_class.options.xx_small"
            },
            {
              "value": "fs-heading-5-base",
              "label": "t:shared.settings.heading_font_class.options.x_small"
            },
            {
              "value": "fs-heading-4-base",
              "label": "t:shared.settings.heading_font_class.options.small"
            },
            {
              "value": "fs-heading-3-base",
              "label": "t:shared.settings.heading_font_class.options.medium"
            },
            {
              "value": "fs-heading-2-base",
              "label": "t:shared.settings.heading_font_class.options.large"
            },
            {
              "value": "fs-heading-1-base",
              "label": "t:shared.settings.heading_font_class.options.x_large"
            },
            {
              "value": "fs-heading-display-3",
              "label": "t:shared.settings.heading_font_class.options.display_regular"
            },
            {
              "value": "fs-heading-display-2",
              "label": "t:shared.settings.heading_font_class.options.display_large"
            },
            {
              "value": "fs-heading-display-1",
              "label": "t:shared.settings.heading_font_class.options.display_x_large"
            }
          ],
          "default": "fs-heading-display-3"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:shared.settings.heading_tag.heading.label",
          "options": [
            {
              "value": "h2",
              "label": "t:shared.settings.heading_tag.options.h2"
            },
            {
              "value": "h3",
              "label": "t:shared.settings.heading_tag.options.h3"
            },
            {
              "value": "h4",
              "label": "t:shared.settings.heading_tag.options.h4"
            },
            {
              "value": "h5",
              "label": "t:shared.settings.heading_tag.options.h5"
            },
            {
              "value": "h6",
              "label": "t:shared.settings.heading_tag.options.h6"
            }
          ],
          "default": "h2"
        },
        {
          "type": "paragraph",
          "content": "t:shared.settings.heading_tag.heading.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:shared.section_blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:shared.section_blocks.text.settings.text.label",
          "default": "t:sections.main_password.blocks.text.settings.text.default"
        },
        {
          "type": "select",
          "id": "text_font_class",
          "label": "t:shared.settings.text_font_class.label",
          "options": [
            {
              "value": "fs-body-25",
              "label": "t:shared.settings.text_font_class.options.xx_small"
            },
            {
              "value": "fs-body-50",
              "label": "t:shared.settings.text_font_class.options.x_small"
            },
            {
              "value": "fs-body-75",
              "label": "t:shared.settings.text_font_class.options.small"
            },
            {
              "value": "fs-body-100",
              "label": "t:shared.settings.text_font_class.options.regular"
            },
            {
              "value": "fs-body-150",
              "label": "t:shared.settings.text_font_class.options.large"
            },
            {
              "value": "fs-body-200",
              "label": "t:shared.settings.text_font_class.options.x_large"
            },
            {
              "value": "fs-body-250",
              "label": "t:shared.settings.text_font_class.options.2x_large"
            },
            {
              "value": "fs-body-300",
              "label": "t:shared.settings.text_font_class.options.3x_large"
            },
            {
              "value": "fs-body-350",
              "label": "t:shared.settings.text_font_class.options.4x_large"
            },
            {
              "value": "fs-body-400",
              "label": "t:shared.settings.text_font_class.options.5x_large"
            }
          ],
          "default": "fs-body-100"
        }
      ]
    },
    {
      "type": "newsletter_signup",
      "name": "t:sections.main_password.blocks.newsletter_signup.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_collect_customer_name",
          "label": "t:shared.options.enable_collect_customer_name.label",
          "info": "t:shared.options.enable_collect_customer_name.info",
          "default": false
        }
      ]
    },
    {
      "type": "spacer",
      "name": "t:shared.section_blocks.spacer.name",
      "settings": [
        {
          "type": "range",
          "id": "space",
          "label": "t:shared.section_blocks.spacer.settings.space.label",
          "min": 4,
          "max": 64,
          "step": 4,
          "unit": "px",
          "default": 12
        }
      ]
    },
    {
      "type": "share_icons",
      "name": "t:sections.main_password.blocks.share_icons.name",
      "limit": 1
    },
    {
      "type": "social_icons",
      "name": "t:shared.section_blocks.social_icons.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:shared.section_blocks.social_icons.settings.paragraph.content"
        }
      ]
    }
  ]
}
{% endschema %}
