{% # whitespace: normal %}
{%- capture additional_content -%}
  <div class="sales-banner__bar-discount-code sales-banner__button" data-display="{{ section.settings.display }}">
    {% liquid
      if section.settings.display == 'code-with-copy-button'
        assign code_button_style = 'btn--dashed'
      else
        assign code_button_style = section.settings.code_style
      endif

      capture code_button_attributes
        echo 'style="--max-width: [[mw]]px;"' | replace: '[[mw]]', section.settings.code_max_width
        if section.settings.display == 'code-with-copy-button'
          echo 'tabindex="-1"'
        else
          echo 'js-clipboard-copy-button data-copy-success="false"'
        endif
      endcapture

      capture copy_button_attributes
        if section.settings.display == 'code-with-copy-button'
          echo 'style="--max-width: [[mw]]px;"' | replace: '[[mw]]', section.settings.copy_max_width
          echo 'js-clipboard-copy-button data-copy-success="false"'
        endif
      endcapture
    %}

    {% # whitespace: normal %}
    {% capture code_button_label %}
      <span class="sales-banner-bar-item-code-button__content">
        {%- liquid
          if section.settings.custom_icon_image != blank
            assign enable_corner_rounding = section.settings.enable_corner_rounding
          else
            assign enable_corner_rounding = false
          endif
        -%}

        {%- if section.settings.code_button_icon != 'none' or section.settings.custom_icon_image != blank -%}
          <span
            class="sales-banner-bar-item-code-button-content__icon"
            data-enable-icon-corner-rounding="{{ enable_corner_rounding }}"
          >
            {%- if section.settings.custom_icon_image == blank -%}
              {% render 'icon-editorial', icon: section.settings.code_button_icon %}
            {%- else -%}
              {%- render 'image',
                image: section.settings.custom_icon_image,
                sizes: '20px',
                aspect_ratio: 'square',
                object_fit: 'contain'
              -%}
            {%- endif -%}
          </span>
        {%- endif -%}

        <span
          class="sales-banner-bar-item-code-button-content__text"
          js-clipboard-copy-text
        >
          {{ section.settings.code | strip_html }}
        </span>
      </span>

      {% if section.settings.display == 'code-button' %}
        <span class="sales-banner-bar-item-code-button__content--success-message">
          {{ 'sections.discount_code_bar.clipboard.success_message' | t }}
        </span>
      {% endif %}
    {% endcapture %}

    {% # whitespace: normal %}
    {% capture copy_button_label %}
      {% if section.settings.display == 'code-with-copy-button' %}
        <span class="sales-banner-bar-item-copy-button__content">
          <span class="sales-banner-bar-item-copy-button-content__text">
            {{ section.settings.copy_label }}
          </span>
        </span>

        <span class="sales-banner-bar-item-copy-button__content--success-message">
          {{ 'sections.discount_code_bar.clipboard.success_message' | t }}
        </span>
      {% endif %}
    {% endcapture %}

    {% render 'button-block',
      wrapper_class: 'sales-banner-bar-item__code-button',
      label: code_button_label,
      button_style: code_button_style,
      button_attributes: code_button_attributes,
      is_small: true,
      allow_linkless: true
    %}

    {% if section.settings.display == 'code-with-copy-button' %}
      {% render 'button-block',
        wrapper_class: 'sales-banner-bar-item__copy-button',
        label: copy_button_label,
        button_style: 'btn--primary',
        button_attributes: copy_button_attributes,
        is_small: true,
        allow_linkless: true
      %}
    {% endif %}
  </div>
{%- endcapture -%}

{%- render 'banners-bar',
  section: section,
  section_type: 'discount-code-bar',
  additional_content: additional_content
-%}

