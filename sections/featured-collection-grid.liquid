{%- liquid
  assign max_products = section.settings.maximum_products

  capture custom_swatch_color_maps
    render 'get-custom-swatch-color-maps'
  endcapture

  assign custom_color_key_map = custom_swatch_color_maps | split: ' | ' | first | split: ','
  assign custom_color_value_map = custom_swatch_color_maps | split: ' | ' | last | split: ','
-%}

{%- for block in section.blocks -%}
  {%- liquid
    assign index_attribute = 'data-navigation="[[fi]]"' | replace: '[[fi]]', forloop.index0

    if block.type == 'product_list'
      assign featured_collection_products = block.settings.product_list
    else
      assign featured_collection_products = block.settings.collection.products
    endif

    if block.settings.collection.products.size > max_products and block.type == 'collection'
      assign collection_has_more_products = true
    else
      assign collection_has_more_products = false
    endif
  -%}

  {%- # whitespace: normal -%}
  {%- capture navigation_list_items -%}
    {{- navigation_list_items -}}

    <li>
      <button
        type="button"
        class="featured-collection-grid__navigation-list-item{% if forloop.first %} selected{% endif %}"
        data-navigation-item="{{ forloop.index0 }}"
        js-navigation-list-item
      >
        <span class="ff-heading fs-body-150">{{ block.settings.collection_name }}</span>
        <span class="indicator"></span>
      </button>
    </li>
  {%- endcapture -%}

  {%- # whitespace: normal -%}
  {%- capture content -%}
    {{- content -}}
    <div
      class="
        featured-collection-grid__content
        carousel
        carousel--mobile-per-view-{{ section.settings.mobile_columns }}
        carousel--per-view-{{ section.settings.columns }}
        swiper
        {% if forloop.first -%}
          visible
        {%- endif %}
      "
      data-collection="{{ forloop.index0 }}"
      js-slider-container
      {{ block.shopify_attributes }}
    >
      <div class="featured-collection-grid__products carousel__wrapper swiper-wrapper">
        {%- for product in featured_collection_products limit: max_products -%}
          <div class="featured-collection-grid__product carousel_slide swiper-slide">
            {%- render 'product-item',
              prod: product,
              collection: block.settings.collection,
              aspect_ratio: settings.product_listing_aspect_ratio,
              product_columns: section.settings.columns,
              custom_color_key_map: custom_color_key_map,
              custom_color_value_map: custom_color_value_map
            -%}
          </div>
        {%- else -%}
          {%- for i in (1..max_products) -%}
            <div class="featured-collection-grid__product carousel_slide swiper-slide">
              {%- render 'product-item',
                aspect_ratio: settings.product_listing_aspect_ratio,
                product_columns: section.settings.columns,
                placeholder: true,
                custom_color_key_map: custom_color_key_map,
                custom_color_value_map: custom_color_value_map
              -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endcapture -%}
{%- endfor -%}

<div
  class="
    section
    section--includes-product-items
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    featured-collection-grid
    featured-collection-grid--rows-{{ section.settings.rows }}
    featured-collection-grid--per-view-{{ section.settings.columns }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--featured-collection-grid
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="featured-collection-grid"
  data-layout-type="grid"
  data-enable-mobile-slider="{{ section.settings.product_list_enable_slider_on_mobile }}"
  data-products-per-view="{{ section.settings.columns }}"
  data-mobile-products-per-view="{{ section.settings.mobile_columns }}"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
>
  <div class="featured-collection-grid__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    <div
      class="featured-collection-grid__meta"
      js-slider-meta
    >
      {%- render 'section-header', local_settings: section.settings, custom_class_prefix: 'featured-collection-grid' -%}

      {%- if section.blocks.size > 1 -%}
        <div class="featured-collection-grid__meta-controls featured-collection-grid__meta-controls--alignment-{{ section.settings.header_alignment }}">
          <ul
            class="
              featured-collection-grid__navigation-list
              featured-collection-grid__navigation-list--mobile-display-{{ section.settings.collection_tabs_mobile_display }}
              animation--controls
            "
          >
            {{- navigation_list_items -}}
          </ul>
        </div>
      {%- endif -%}
    </div>
    {{- content -}}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection_grid.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:shared.section_header.header.content"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:shared.settings.alignment_horizontal.header.label",
      "options": [
        {
          "value": "left",
          "label": "t:shared.options.alignment.horizontal.left"
        },
        {
          "value": "center",
          "label": "t:shared.options.alignment.horizontal.center"
        },
        {
          "value": "right",
          "label": "t:shared.options.alignment.horizontal.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shared.collections.settings.title.label",
      "default": "t:sections.featured_collection_grid.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_font_class",
      "label": "t:shared.settings.heading_font_class.label",
      "options": [
        {
          "value": "fs-heading-6-base",
          "label": "t:shared.settings.heading_font_class.options.xx_small"
        },
        {
          "value": "fs-heading-5-base",
          "label": "t:shared.settings.heading_font_class.options.x_small"
        },
        {
          "value": "fs-heading-4-base",
          "label": "t:shared.settings.heading_font_class.options.small"
        },
        {
          "value": "fs-heading-3-base",
          "label": "t:shared.settings.heading_font_class.options.medium"
        },
        {
          "value": "fs-heading-2-base",
          "label": "t:shared.settings.heading_font_class.options.large"
        },
        {
          "value": "fs-heading-1-base",
          "label": "t:shared.settings.heading_font_class.options.x_large"
        },
        {
          "value": "fs-heading-display-3",
          "label": "t:shared.settings.heading_font_class.options.display_regular"
        },
        {
          "value": "fs-heading-display-2",
          "label": "t:shared.settings.heading_font_class.options.display_large"
        },
        {
          "value": "fs-heading-display-1",
          "label": "t:shared.settings.heading_font_class.options.display_x_large"
        }
      ],
      "default": "fs-heading-3-base"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:shared.settings.heading_tag.heading.label",
      "options": [
        {
          "value": "h2",
          "label": "t:shared.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:shared.settings.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:shared.settings.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:shared.settings.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:shared.settings.heading_tag.options.h6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "paragraph",
      "content": "t:shared.settings.heading_tag.heading.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.shared.collections.settings.text.label"
    },
    {
      "type": "select",
      "id": "text_font_class",
      "label": "t:shared.settings.text_font_class.label",
      "options": [
        {
          "value": "fs-body-25",
          "label": "t:shared.settings.text_font_class.options.xx_small"
        },
        {
          "value": "fs-body-50",
          "label": "t:shared.settings.text_font_class.options.x_small"
        },
        {
          "value": "fs-body-75",
          "label": "t:shared.settings.text_font_class.options.small"
        },
        {
          "value": "fs-body-100",
          "label": "t:shared.settings.text_font_class.options.regular"
        },
        {
          "value": "fs-body-150",
          "label": "t:shared.settings.text_font_class.options.large"
        },
        {
          "value": "fs-body-200",
          "label": "t:shared.settings.text_font_class.options.x_large"
        },
        {
          "value": "fs-body-250",
