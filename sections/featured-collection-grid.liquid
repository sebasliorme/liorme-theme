        }
      ]
    },
    {
      "type": "product_list",
      "name": "t:sections.featured_collection_grid.blocks.product_list.name",
      "settings": [
        {
          "type": "product_list",
          "id": "product_list",
          "label": "t:sections.shared.collections.settings.product_list.label"
        },
        {
          "type": "text",
          "id": "collection_name",
          "label": "t:sections.shared.collections.settings.collection_name.label",
          "default": "t:sections.shared.collections.settings.collection_name.default"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.featured_collection_grid.presets.name",
