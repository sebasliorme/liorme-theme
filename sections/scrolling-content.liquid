{% # whitespace: normal %}
{%- capture content -%}
  {%- for block in section.blocks -%}
    {% assign aria_label = blank %}

    {% # whitespace: normal %}
    {%- capture block_content -%}
      {%- case block.type -%}
        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div
              class="
                scrolling-content__text
                {{ section.settings.font_choice }}
                {{ section.settings.text_font_class }}
              "
              {{ block.shopify_attributes }}
            >
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- when 'image' -%}
          {% assign aria_label = block.settings.image.alt %}

          {%- render 'image-block',
            image: block.settings.image,
            width: block.settings.image_size,
            mobile_width: block.settings.image_size_mobile,
            break_to_mobile_at: '720',
            enable_corner_rounding: block.settings.enable_corner_rounding,
            shopify_attributes: block.shopify_attributes
          -%}

        {%- when 'icon' -%}
          {% liquid
            if block.settings.custom_icon_image != blank
              assign aria_label = block.settings.custom_icon_image.alt
            else
              assign aria_label = block.settings.icon
            endif
          %}

          {%- render 'icon-block',
            icon: block.settings.icon,
            custom_icon: block.settings.custom_icon_image,
            width: block.settings.icon_width,
            mobile_width: block.settings.icon_width_mobile,
            enable_corner_rounding: block.settings.enable_corner_rounding,
            shopify_attributes: block.shopify_attributes
          -%}
      {%- endcase -%}
    {%- endcapture -%}

    {%- render 'scrolling-content-item-wrapper',
      block_content: block_content,
      link: block.settings.link,
      aria_label: aria_label
    -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    scrolling-content
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--scrolling-content
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="scrolling-content"
>
  <div
    class="
      scrolling-content__inner
      section-inner
      section-inner--width-{{ section.settings.section_width }}
      section-inner--mobile-full-width-{{ section.settings.enable_full_width_on_mobile }}
      section-blocks
    "
    data-borders="{{ section.settings.borders }}"
    data-enable-corner-rounding="{{ section.settings.enable_corner_rounding }}"
  >
    {%- render 'scrolling-content',
      block_content: content,
      color_scheme: section.settings.scrolling_content_color_scheme,
      scroll_duration: section.settings.duration,
      scroll_direction: section.settings.direction,
      gap: section.settings.gap,
      padding_top: section.settings.padding_top,
      padding_bottom: section.settings.padding_bottom,
      animate_section_blocks: true
    -%}
  </div>
</div>

