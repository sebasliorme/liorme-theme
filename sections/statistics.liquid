{%- liquid
  assign background = section.settings.color_scheme.settings.background
  assign background_gradient = section.settings.color_scheme.settings.background_gradient
  assign item_background = section.settings.columns_item_color_scheme.settings.background
  assign item_background_gradient = section.settings.columns_item_color_scheme.settings.background_gradient

  # If the item color scheme matches the section color scheme, and a background gradient is used, we
  # want the item background to be transparent
  if item_background_gradient != '' and item_background_gradient == background_gradient
    assign transparent_item_background = true
  else
    assign transparent_item_background = false
  endif

  # If the item background doesn't match the section background, we need padding on the items
  if item_background_gradient == background_gradient and item_background_gradient != '' or item_background == background
    assign items_need_padding = false
  else
    assign items_need_padding = true
  endif

  if section.settings.statistic_font_class == 'ff-heading'
    assign statistic_font = settings.font_heading | font_modify: 'weight', section.settings.statistic_font_weight | default: settings.font_heading
  else
    assign statistic_font = settings.font_body | font_modify: 'weight', section.settings.statistic_font_weight | default: settings.font_body
  endif

  assign has_number_statistic_blocks = false

  capture rendered_blocks
    for block in section.blocks
      if block.settings.statistic_type == 'number'
        assign has_number_statistic_blocks = true
      endif

      render 'statistics-item', section: section, block: block
    endfor
  endcapture

  capture animation_attrs
    if has_number_statistic_blocks
      echo 'data-number-statistic-thousands-separator-type="[[snts]]"' | replace: '[[snts]]', section.settings.statistic_thousands_separator
      echo 'data-number-statistic-decimal-separator-type="[[snts]]"' | replace: '[[snts]]', section.settings.statistic_decimal_separator

      if section.settings.statistic_animation_enable_counting_animation
        echo ' data-animation-stagger-direction="[[asd]]"' | replace: '[[asd]]', section.settings.statistic_animation_stagger_direction
        echo ' data-animation-duration="[[ad]]"' | replace: '[[ad]]', section.settings.statistic_animation_duration
        echo ' data-animation-speed="[[as]]"' | replace: '[[as]]', section.settings.statistic_animation_speed
        echo ' data-animation-linearity="[[al]]"' | replace: '[[al]]', section.settings.statistic_animation_linearity

        unless section.settings.statistic_animation_stagger_direction == 'none'
          echo ' data-animation-stagger-delay="[[asd]]"' | replace: '[[asd]]', section.settings.statistic_animation_stagger_delay
        endunless
      endif
    endif
  endcapture
-%}

<style>
  {{ statistic_font | font_face: font_display: 'swap'  }}
</style>

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    statistics
    {% if transparent_item_background -%}
      statistics--transparent-item-background
    {%- endif %}
    {% if items_need_padding -%}
      statistics--items-need-padding
    {%- endif %}
    statistics--column-content-alignment-desktop-{{ section.settings.column_alignment }}
    statistics--column-content-alignment-mobile-{{ section.settings.column_alignment_mobile }}
    statistics--column-content-vertical-alignment-{{ section.settings.columns_vertical_alignment }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--statistics
    {%- endif -%}
  "
  style="
    {%- render 'color-scheme-to-vars',
      color_scheme: section.settings.color_scheme,
      css_vars: 'background,background-gradient,text,links,links-alpha-60,lines-and-borders'
    -%}
    {%- render 'section-padding-vars' -%}
    {% if section.settings.content_width == 'custom' -%}
      --custom-content-width: {{ section.settings.custom_content_width }}px;
    {%- endif %}
    --columns-background-padding-desktop: {{ section.settings.columns_background_padding_desktop }}px;
    --columns-background-padding-mobile: {{ section.settings.columns_background_padding_mobile }}px;
    --grid-columns-desktop: {{ section.settings.columns }};
    --grid-columns-mobile: {{ section.settings.columns_mobile }};
    --grid-gap-column-desktop: {{ section.settings.column_spacing }}px;
    --grid-gap-column-mobile: {{ section.settings.column_spacing_mobile }}px;
    --grid-gap-row-desktop: {{ section.settings.row_spacing }}px;
    --grid-gap-row-mobile: {{ section.settings.row_spacing_mobile }}px;
    --icon-max-width-desktop: {{ section.settings.icon_width }}px;
    --icon-max-width-mobile: {{ section.settings.icon_width_mobile }}px;
    --statistic-text-size-desktop: {{ section.settings.statistic_text_size_desktop }}px;
    --statistic-text-size-mobile: {{ section.settings.statistic_text_size_mobile }}px;
    --statistic-font: {{ statistic_font.family | escape }}, {{ statistic_font.fallback_families | escape }};
    --statistic-font-weight: {{ statistic_font.weight }};
    --statistic-font-style: {{ statistic_font.style }};
  "
  data-section-id="{{ section.id }}"
  data-section-type="statistics"
  data-slider-on-mobile="{{ section.settings.enable_slider_on_mobile }}"
  data-mobile-columns-per-view="{{ section.settings.columns_mobile }}"
  data-counting-animation-enabled="{{ section.settings.statistic_animation_enable_counting_animation }}"
  {{ animation_attrs -}}
>
  <div
    class="statistics__inner section-inner section-inner--width-{{ section.settings.section_width }}"
    style="{%- render 'color-scheme-to-vars', color_scheme: section.settings.columns_item_color_scheme -%}"
  >
    {%- render 'section-header',
      local_settings: section.settings,
      heading_id: 'title',
      custom_class_prefix: 'statistics',
      has_button: false
    -%}

    <div
      class="statistics__grid-wrapper carousel swiper"
      js-swiper
    >
      <div class="statistics__grid carousel__wrapper swiper-wrapper">
        {{ rendered_blocks }}
      </div>
    </div>
  </div>
</div>

