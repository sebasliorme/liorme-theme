    {
      "type": "select",
      "id": "gallery_style_mobile",
      "label": "t:sections.main_product_default.settings.media.gallery_style_mobile.label",
      "options": [
        {
          "value": "carousel",
          "label": "t:sections.main_product_default.settings.media.gallery_style_mobile.options.carousel"
