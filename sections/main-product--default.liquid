        { "type": "text", "id": "button_label", "label": "Button text", "default": "Find your size" },
        { "type": "text", "id": "size_option_names", "label": "Size option names", "info": "Comma separated. The first option whose name contains one of these words is used (part of a word is enough: \"tama\" matches \"Tamaño\").", "default": "Size, Talla, Tama" },
