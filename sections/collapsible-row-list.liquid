<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    collapsible-row-list
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--collapsible-row-list
    {%- endif %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="collapsible-row-list"
  data-auto-collapse="{{ section.settings.auto_collapse_rows }}"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
    --heading-alignment: {{ section.settings.heading_alignment }};
    {% if section.settings.content_width == 'custom' -%}
      --custom-content-width: {{ section.settings.custom_content_width }}px;
    {%- endif -%}
  "
>
  <div class="section-inner section-inner--width-{{ section.settings.section_width }}">
    <div class="collapsible-row-list__inner">
      {%- render 'section-header',
        local_settings: section.settings,
        heading_id: 'title',
        custom_class_prefix: 'collapsible-row-list',
        has_button: false
      -%}

      {%- for block in section.blocks -%}
        {% if block.settings.text != blank or request.design_mode %}
          {%- render 'collapsible-row-list-item',
            block: block,
            item_heading_font: section.settings.item_heading_font_choice,
            item_heading_size: section.settings.item_heading_font_class,
            forloop: forloop
          -%}
        {% endif %}
      {%- endfor -%}
    </div>
  </div>
</div>

