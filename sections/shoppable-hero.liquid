{%- liquid
  if section.settings.image_aspect == 'original'
    assign placeholder_aspect_ratio = 'square'
  else
    assign placeholder_aspect_ratio = 'no-ratio'
  endif

  if section.index == 1
    assign prioritize_loading = true
  else
    assign prioritize_loading = false
  endif
-%}

<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    section--enable-mobile-padding-{{ section.settings.enable_padding_on_mobile }}
    shoppable-hero
    shoppable-hero--media-aspect-{{ section.settings.image_aspect }}
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--shoppable-hero
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="shoppable-hero"
  style="
    {%- render 'color-scheme-to-vars',
      color_scheme: section.settings.color_scheme,
      css_vars: 'background,background-gradient,lines-and-borders'
    -%}
    {%- render 'section-padding-vars' -%}
    --custom-height: {{ section.settings.desktop_height }}vh;
    --custom-height-mobile: {{ section.settings.mobile_height }}vh;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div
    class="
      shoppable-hero__inner
      section-inner
      section-inner--width-{{ section.settings.section_width }}
      section-inner--mobile-full-width-{{ section.settings.enable_full_width_on_mobile }}
    "
    style="{%- render 'color-scheme-to-vars', color_scheme: section.settings.overlay_color_scheme, output_placeholder_colors: false -%}"
  >
    <div class="shoppable-hero__media-container">
      {%- case section.settings.media_type -%}
        {% when 'image' %}
          {%- if section.settings.mobile_image != blank -%}
            {%- render 'image',
              wrapper_class: 'shoppable-hero__image shoppable-hero__image--mobile',
              image: section.settings.mobile_image,
              sizes: '100vw',
              focal_point: section.settings.mobile_focal_point,
              placeholder_name: 'lifestyle-2',
              animate: true,
              src_set_type: 'full-width',
              prioritize_loading: prioritize_loading
            -%}
          {%- endif -%}

          {%- render 'image',
            wrapper_class: 'shoppable-hero__image shoppable-hero__image--desktop',
            image: section.settings.image,
            sizes: '100vw',
            focal_point: section.settings.focal_point,
            include_placeholder: true,
            placeholder_natural_fallback_ratio: placeholder_aspect_ratio,
            placeholder_name: 'lifestyle-2',
            animate: true,
            src_set_type: 'full-width',
            prioritize_loading: prioritize_loading
          -%}

        {%- when 'video' -%}
          {%- render 'background-video',
            video: section.settings.background_video,
            enable_mobile_video: true,
            mobile_video: section.settings.mobile_background_video,
            focal_point: section.settings.video_focal_point,
            focal_point_mobile: section.settings.mobile_video_focal_point,
            class: 'shoppable-hero__video',
            placeholder_name: 'lifestyle-1',
            animate: true
          -%}
      {%- endcase -%}
    </div>

    <div class="shoppable-hero__overlay"></div>

    <div class="shoppable-hero__content-wrapper">
      {%- unless section.settings.background_link == blank -%}
        <a
          href="{{ section.settings.background_link }}"
          class="shoppable-hero__media-link"
          aria-label="{{ section.settings.background_link }}"
        ></a>
      {%- endunless -%}

      {% content_for 'block', type: '_content', id: 'static-content' %}

      {% content_for 'block', type: '_products-slider', id: 'static-products-slider' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.shoppable_hero.name",
  "tag": "section",
  "class": "shopify-section--full-width",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "radio",
      "id": "image_aspect",
      "label": "t:sections.shoppable_hero.settings.general.media_height.label",
      "options": [
        {
          "value": "original",
          "label": "t:shared.settings.image_height.image_aspect.options.original"
        },
        {
          "value": "custom",
          "label": "t:shared.settings.image_height.image_aspect.options.custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "t:shared.settings.image_height.desktop_height.label",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75,
      "visible_if": "{{ section.settings.image_aspect == 'custom' }}"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "t:shared.settings.image_height.mobile_height.label",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75,
      "visible_if": "{{ section.settings.image_aspect == 'custom' }}"
    },
    {
      "type": "paragraph",
      "content": "t:sections.shoppable_hero.settings.general.original_paragraph.content",
      "visible_if": "{{ section.settings.image_aspect == 'original' }}"
    },
    {
      "type": "paragraph",
      "content": "t:shared.settings.image_height.paragraph.content_custom",
      "visible_if": "{{ section.settings.image_aspect == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:shared.settings.media_type.header.content"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:shared.settings.media_type.media_type.label",
      "options": [
        {
          "value": "image",
          "label": "t:shared.settings.media_type.media_type.options.image"
        },
        {
          "value": "video",
          "label": "t:shared.settings.media_type.media_type.options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "color_scheme",
      "id": "media_color_scheme",
      "label": "t:shared.settings.color_scheme.label",
      "default": "scheme_4",
      "visible_if": "{{ section.settings.media_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:shared.settings.background_image.image.label",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:shared.settings.background_image.mobile_image.label",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "t:shared.settings.focal_point.image.default.label",
      "options": [
        {
          "value": "image_presentation",
          "label": "t:shared.options.focal_point.image_presentation"
        },
        {
          "value": "center",
          "label": "t:shared.options.focal_point.center"
        },
        {
          "value": "top",
          "label": "t:shared.options.focal_point.top"
        },
        {
          "value": "bottom",
          "label": "t:shared.options.focal_point.bottom"
        },
        {
          "value": "left",
          "label": "t:shared.options.focal_point.left"
        },
        {
          "value": "right",
          "label": "t:shared.options.focal_point.right"
        }
      ],
      "default": "image_presentation",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "mobile_focal_point",
      "label": "t:shared.settings.focal_point.image.mobile.label",
      "options": [
        {
          "value": "image_presentation",
          "label": "t:shared.options.focal_point.image_presentation"
        },
        {
          "value": "center",
          "label": "t:shared.options.focal_point.center"
        },
        {
          "value": "top",
          "label": "t:shared.options.focal_point.top"
        },
        {
          "value": "bottom",
          "label": "t:shared.options.focal_point.bottom"
        },
        {
          "value": "left",
          "label": "t:shared.options.focal_point.left"
        },
        {
          "value": "right",
          "label": "t:shared.options.focal_point.right"
        }
      ],
      "default": "image_presentation",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:shared.settings.background_video.video.label",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "mobile_background_video",
      "label": "t:shared.settings.background_video.video_mobile.label",
      "visible_if": "{{ section.settings.media_type == 'video' }}",
      "info": "t:shared.settings.background_video.video_mobile.info"
    },
    {
      "type": "select",
      "id": "video_focal_point",
      "label": "t:shared.settings.focal_point.video.default.label",
      "options": [
        {
          "value": "center",
          "label": "t:shared.options.focal_point.center"
        },
        {
          "value": "top",
          "label": "t:shared.options.focal_point.top"
        },
        {
          "value": "bottom",
          "label": "t:shared.options.focal_point.bottom"
        },
        {
          "value": "left",
          "label": "t:shared.options.focal_point.left"
        },
        {
          "value": "right",
          "label": "t:shared.options.focal_point.right"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "mobile_video_focal_point",
      "label": "t:shared.settings.focal_point.video.mobile.label",
      "options": [
        {
          "value": "center",
          "label": "t:shared.options.focal_point.center"
        },
        {
          "value": "top",
          "label": "t:shared.options.focal_point.top"
        },
        {
          "value": "bottom",
          "label": "t:shared.options.focal_point.bottom"
        },
        {
          "value": "left",
          "label": "t:shared.options.focal_point.left"
        },
        {
          "value": "right",
          "label": "t:shared.options.focal_point.right"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "url",
      "id": "background_link",
      "label": "t:sections.shoppable_hero.settings.background.background_link.label"
    },
    {
      "type": "header",
      "content": "t:shared.settings.overlay.background_image_overlay.header.content"
    },
    {
      "type": "color_scheme",
      "id": "overlay_color_scheme",
      "label": "t:shared.settings.color_scheme.label",
      "default": "scheme_4"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:shared.settings.overlay.overlay_opacity.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30,
      "info": "t:shared.settings.overlay.overlay_opacity.info"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:shared.settings.section_style.section_width.label",
      "options": [
        {
          "value": "page-width",
          "label": "t:shared.settings.section_style.section_width.options.page_width"
        },
        {
          "value": "full-width",
          "label": "t:shared.settings.section_style.section_width.options.full_width"
        },
        {
          "value": "full-width-padded",
          "label": "t:shared.settings.section_style.section_width.options.full_width_padded"
        },
        {
          "value": "full-width-background-only",
          "label": "t:shared.settings.section_style.section_width.options.full_width_background_only"
        }
      ],
      "default": "full-width-background-only"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_on_mobile",
      "label": "t:shared.settings.section_style.enable_full_width_on_mobile.label",
      "visible_if": "{{ section.settings.section_width != 'full-width' and section.settings.section_width != 'full-width-background-only' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_padding_on_mobile",
      "label": "t:shared.settings.section_style.enable_padding_on_mobile.label",
      "default": false,
      "visible_if": "{{ section.settings.enable_full_width_on_mobile and section.settings.section_width != 'full-width' and section.settings.section_width != 'full-width-background-only' }}"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:shared.settings.section_style.section_padding.top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:shared.settings.section_style.section_padding.bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.settings.section_style.divider_style.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.settings.section_style.divider_style.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_divider",
      "label": "t:shared.settings.section_style.enable_full_width_divider.label",
      "visible_if": "{{ section.settings.divider_style == 'solid' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "default": true,
      "info": "t:shared.settings.section_style.enable_animation.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.shoppable_hero.presets.name",
      "blocks": [
        {
          "type": "_content",
          "static": true,
          "id": "static-content",
          "blocks": [
            {
              "type": "_content-heading",
              "settings": {
                "heading": "t:sections.shoppable_hero.presets.name"
              }
            },
            {
              "type": "_content-text",
              "settings": {
                "text": "t:sections.shoppable_hero.presets.blocks._content_text.settings.text.default"
              }
            },
            {
              "type": "_content-button",
              "settings": {
                "link_text": "t:sections.shoppable_hero.presets.blocks._content_button.settings.link_text.default"
              }
            }
          ]
        },
        {
          "type": "_products-slider",
          "static": true,
          "id": "static-products-slider",
          "blocks": [
            {
              "type": "_products-slider-product"
            },
            {
              "type": "_products-slider-product"
            },
            {
              "type": "_products-slider-product"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
