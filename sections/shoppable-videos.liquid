<div
  class="
    section
    section--divider-{{ section.settings.divider_style }}
    section--divider-full-width-{{ section.settings.enable_full_width_divider }}
    shoppable-videos
    {% if settings.enable_section_animations and section.settings.enable_animation -%}
      animation
      animation--shoppable-videos
    {%- endif -%}
  "
  data-section-id="{{ section.id }}"
  data-section-type="shoppable-videos"
  style="
    {%- render 'color-scheme-to-vars', color_scheme: section.settings.color_scheme -%}
    {%- render 'section-padding-vars' -%}
  "
>
  <div class="shoppable-videos__inner section-inner section-inner--width-{{ section.settings.section_width }}">
    <div
      class="
        shoppable-videos__section-header
        {% if settings.slider_navigation_placement == 'header' -%}
          carousel__navigation-wrapper
          carousel__navigation-wrapper--alignment-{{ section.settings.header_alignment }}
        {%- endif %}
      "
    >
      {%- liquid
        capture section_header
          render 'section-header', local_settings: section.settings, custom_class_prefix: 'shoppable-videos'
        endcapture

        assign carousel_navigation_class = 'shoppable-videos__navigation-buttons animation--controls'

        capture navigation_buttons
          if settings.slider_navigation_placement == 'header'
            render 'carousel-navigation', wrapper_class: carousel_navigation_class
          endif
        endcapture

        if settings.slider_navigation_placement == 'header'
          case section.settings.header_alignment
            when 'left'
              echo section_header
              echo navigation_buttons
            when 'center'
              render 'carousel-navigation-button', type: 'previous'
              echo section_header
              render 'carousel-navigation-button', type: 'next'
            when 'right'
              echo navigation_buttons
              echo section_header
          endcase
        else
          echo section_header
        endif
      -%}
    </div>

    {% liquid
      assign columns_small_desktop = section.settings.layout_columns | at_most: 3
      assign columns_tablet = section.settings.layout_columns | at_most: 2

      assign background = section.settings.color_scheme.settings.background
      assign background_gradient = section.settings.color_scheme.settings.background_gradient
      assign product_card_background = section.settings.product_card_color_scheme.settings.background
      assign product_card_background_gradient = section.settings.product_card_color_scheme.settings.background_gradient

      # If the item color scheme matches the section color scheme, and a background gradient is used, we
      # want the item background to be transparent
      if product_card_background_gradient != '' and product_card_background_gradient == background_gradient
        assign transparent_item_background = true
      else
        assign transparent_item_background = false
      endif

      # If the product_card background doesn't match the section background, we need padding on the product_card
      if product_card_background_gradient == background_gradient and product_card_background_gradient != '' or product_card_background == background
        assign product_card_contain_in_card = false
      else
        assign product_card_contain_in_card = true
      endif

      capture product_card_color_vars
        render 'color-scheme-to-vars', prefix: 'product-card', color_scheme: section.settings.product_card_color_scheme
      endcapture

      if section.settings.section_width == 'page-width'
        assign max_view_width = '1400px'
      else
        assign max_view_width = '93.4vw'
      endif

      case section.settings.layout_columns
        when '5'
          assign sizes = '(min-width: 1400px) calc(([[mvw]] - (25px * 4)) / 5), (min-width: 1200px) calc((93.4vw - (25px * 4)) / 5), (min-width: 960px) calc((93.4vw - (17px * 2)) / 3), (min-width: 720px) calc((93.4vw - (17px * 1)) / 2), 93.4vw' | replace: '[[mvw]]', max_view_width
        when '4'
          assign sizes = '(min-width: 1400px) calc(([[mvw]] - (25px * 3)) / 4), (min-width: 1200px) calc((93.4vw - (25px * 3)) / 4), (min-width: 960px) calc((93.4vw - (17px * 2)) / 3), (min-width: 720px) calc((93.4vw - (17px * 1)) / 2), 93.4vw' | replace: '[[mvw]]', max_view_width
        when '3'
          assign sizes = '(min-width: 1400px) calc(([[mvw]] - (25px * 2)) / 3), (min-width: 1200px) calc((93.4vw - (25px * 2)) / 3), (min-width: 960px) calc((93.4vw - (17px * 2)) / 3), (min-width: 720px) calc((93.4vw - (17px * 1)) / 2), 93.4vw' | replace: '[[mvw]]', max_view_width
        when '2'
          assign sizes = '(min-width: 1400px) calc(([[mvw]] - (25px * 1)) / 2), (min-width: 1200px) calc((93.4vw - (25px * 1)) / 2), (min-width: 960px) calc((93.4vw - (17px * 1)) / 2), (min-width: 720px) calc((93.4vw - (17px * 1)) / 2), 93.4vw' | replace: '[[mvw]]', max_view_width
      endcase
    %}
    <div
      class="shoppable-videos__carousel carousel swiper products-slider"
      data-columns-desktop="{{ section.settings.layout_columns }}"
      data-columns-small-desktop="{{ columns_small_desktop }}"
      data-columns-tablet="{{ columns_tablet }}"
      data-slides-count="{{ section.blocks | size }}"
      data-product-card-transparent-background="{{ transparent_item_background }}"
      data-product-card-contain-in-card="{{ product_card_contain_in_card }}"
      data-product-card-style="horizontal"
      data-product-card-horizontal-image-position="{{ section.settings.product_card_image_position }}"
      data-product-card-mobile-image-position="{{ section.settings.product_card_image_position_mobile }}"
      data-product-details-product-title-font="{{ section.settings.product_details_product_title_font }}"
      data-product-details-show-vendor="{{ section.settings.product_details_show_vendor }}"
      data-product-details-show-button="{{ section.settings.product_details_show_button }}"
      data-product-details-button-style="{{ section.settings.product_details_button_style }}"
      data-product-details-alignment="{{ section.settings.product_details_alignment }}"
      data-play-interaction="{{ section.settings.videos_play_interaction }}"
      js-swiper
      style="
        --columns-desktop: {{ section.settings.layout_columns }};
        --columns-small-desktop: {{ columns_small_desktop }};
        --columns-tablet: {{ columns_tablet }};
        --product-card-horizontal-image-width: {{ section.settings.product_card_image_width_desktop }}px;
        --product-card-mobile-image-width: {{ section.settings.product_card_image_width_mobile }}px;
        --product-details-product-title-size: var({{ section.settings.product_details_product_title_size }});
        {{ product_card_color_vars | strip }}
      "
    >
      <div class="shoppable-videos__carousel-inner carousel__wrapper swiper-wrapper">
        {%- for block in section.blocks -%}
          {% liquid
            if block.settings.background_video != blank
              assign block_has_video = true
              assign show_placeholder = false
            else
              assign block_has_video = false
              assign show_placeholder = true
            endif
          %}
          <div
            class="shoppable-videos__slide carousel__slide swiper-slide animation--item"
            data-block-index="{{ forloop.index0 }}"
            js-swiper-slide
            {{ block.shopify_attributes }}
          >
            <div
              class="shoppable-videos-slide__media-container"
              js-media-container
              data-has-video="{{ block_has_video }}"
              data-is-playing="false"
              data-is-muted="true"
              data-play-button-style="{{ section.settings.videos_play_button_style }}"
              style="--focal-alignment: {{ block.settings.video_focal_point }};"
            >
              {% if block.settings.background_video != blank %}
                <div
                  class="shoppable-videos-slide__video video-wrapper aspect-ratio--{{ section.settings.videos_aspect_ratio }}"
                  js-video-wrapper
                  style="--background-video-preview-image: url({{ block.settings.background_video.preview_image | image_url }});"
                >
                  {{
                    block.settings.background_video
                    | video_tag:
                      js-video: '',
                      class: 'video',
                      image_size: '1280x',
                      autoplay: false,
                      loop: true,
                      muted: true,
                      controls: false,
                      tabindex: -1
                  }}
                </div>
              {% endif %}

              {% render 'image',
                wrapper_class: 'shoppable-videos-slide__image',
                image: block.settings.cover_image,
                aspect_ratio: section.settings.videos_aspect_ratio,
                focal_point: block.settings.cover_image_focal_point,
                sizes: sizes,
                src_set_type: 'grid',
                animate: true,
                include_placeholder: show_placeholder
              %}

              {% if block.settings.background_video != blank %}
                {% render 'play-button',
                  wrapper_class: 'shoppable-videos-slide__play-button',
                  button_layout: 'minimal',
                  icon_style: section.settings.videos_play_button_color,
                  button_alignment: 'center',
                  has_video: false
                %}

                {% if section.settings.videos_show_mute_controls %}
                  <div class="shoppable-videos-slide__mute-button-wrapper">
                    <button
                      class="shoppable-videos-slide__mute-button"
                      type="button"
                      js-mute-button
                      aria-label="{{ 'general.accessibility.mute_video' | t }}"
                    >
                      {%- render 'icon', icon: 'speaker-muted' -%}
                      {%- render 'icon', icon: 'speaker-unmuted' -%}
                    </button>
                  </div>
                {% endif %}
              {% endif %}
            </div>
            <div class="shoppable-videos-slide__product-card-container">
              {% render 'products-slider-product', local_settings: block.settings, is_slide: false, animate: true %}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- liquid
        if settings.slider_navigation_placement == 'slider'
          render 'carousel-navigation', placement: 'slider'
        endif
      -%}
    </div>
  </div>
</div>

