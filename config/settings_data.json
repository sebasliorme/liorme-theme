      "body:has(.collection-sticky-bar) .header {border-bottom-color: rgba(17, 17, 17, 0.18) !important;}",
      "@media (max-width: 959px) {header.header {--mobile-header-bg: #ffffff; --mobile-header-ink: #111111; --mobile-header-count: #ffffff; --mobile-logo: block; --mobile-logo-white: none; } body:not([mobile-menu-open=\"true\"]):not([quick-search-open=\"true\"]) header.header--transparent.header--force-transparent:not(.is-sticky) {--mobile-header-bg: transparent; --mobile-header-ink: #fff; --mobile-header-count: #111; --mobile-logo: none; --mobile-logo-white: block; } :root body .header__outer-wrapper header.header.header--transparent {background: var(--mobile-header-bg) !important; transition: transform 0.3s !important; } header.header .header__inner, header.header .header__inner a {color: var(--mobile-header-ink) !important; } header.header .regular-logo {display: var(--mobile-logo) !important; } header.header .transparent-logo {display: var(--mobile-logo-white) !important; } header.header [data-js-cart-count] {background: var(--mobile-header-ink) !important; color: var(--mobile-header-count) !important; box-shadow: none !important; }}"
