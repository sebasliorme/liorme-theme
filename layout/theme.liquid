<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  style="
    --announcement-height: 1px;
    --mobile-sticky-header-height: 0px;
    --mobile-sticky-announcement-height: 0px;
  "
>
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {% render 'meta-description' %}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
      Keep thin pages out of the search index: internal search results, collections with no products and
      default-template pages with no content. They stay reachable and crawlable (follow), they just are not listed.
    {%- endcomment -%}
    {%- liquid
      assign hide_from_search = false
      if request.page_type == 'search'
        assign hide_from_search = true
      elsif request.page_type == 'collection' and collection.products_count == 0
        assign hide_from_search = true
      elsif request.page_type == 'page' and page.content == blank and template.suffix == blank
        assign hide_from_search = true
      endif
    -%}
    {%- if hide_from_search -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 16, height: 16 }}" type="image/png">
      <link rel="icon" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
      <link rel="icon" sizes="48x48" href="{{ settings.favicon | image_url: width: 48, height: 48 }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}" type="image/png">
      <link
        rel="apple-touch-icon"
        sizes="152x152"
        href="{{ settings.favicon | image_url: width: 152, height: 152 }}"
        type="image/png"
      >
      <link
        rel="apple-touch-icon"
        sizes="167x167"
        href="{{ settings.favicon | image_url: width: 167, height: 167 }}"
        type="image/png"
      >
      <link
        rel="apple-touch-icon"
        sizes="180x180"
        href="{{ settings.favicon | image_url: width: 180, height: 180 }}"
        type="image/png"
      >
    {%- endif -%}

    {%- capture seo_title -%}
      {%- if request.page_type == 'search' and search.performed == true -%}
        {{ 'search.heading' | t: count: search.results_count }}:
        {{ 'search.results_with_count' | t: terms: search.terms, count: search.results_count }}
      {%- else -%}
        {{ page_title }}
      {%- endif -%}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' -%}
        &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%}
      {%- if current_page != 1 -%}
        &ndash; {{ 'general.meta.page' | t: page: current_page }}
      {%- endif -%}
      {%- assign escaped_page_title = page_title | escape -%}
      {%- unless escaped_page_title contains shop.name -%}
        &ndash; {{ shop.name }}
      {%- endunless -%}
    {%- endcapture -%}
    <title>{{ seo_title | strip }}</title>

    {% render 'social-meta-tags' %}
    {% render 'structured-data' %}

    {% render 'theme-setup' %}
    {% render 'theme-setting-vars' %}
    {%- render 'theme-globals' -%}
    {%- render 'liorme-typography' -%}

    {{ content_for_header }}

    {%- if template.name == 'index' -%}
      <style>
        /* "Page turn" cover effect used to be built with position:sticky,
           which turned out to have a confirmed Chrome bug (reproduced in
           total isolation, unrelated to this page): once you scroll past a
           sticky element, Chrome can keep reporting it as "stuck" forever
           instead of releasing it, so every previously-passed section ends
           up sitting at the same on-screen spot as the current one, hidden
           only by z-index. Going backward, the destination section was
           therefore already sitting fully in place from frame one — the
           z-index swap made it appear instantly instead of sliding in.
           Replaced with a plain, non-sticky stacking context (z-index still
           needs *some* position other than static to take effect) — the
           actual "cover" motion is now driven directly by the snap script
           itself (see animateScrollTo's freeze transform below), not by any
           CSS positioning trick, so it can't get stuck either way. */
        body.template-index #main > .shopify-section {
          position: relative;
        }

        /* Slightly slower than the theme default (500ms/67ms) so the
           heading/text fade-up reads as part of the same unhurried "page
           turn" pace as the section-cover transition, instead of finishing
           well before it. Scoped to the home page only — other pages keep
           the theme's normal animation timing. */
        body.template-index {
          --duration-normal: 700ms;
          --delay-normal: 90ms;
        }

        /* Hides the visible scrollbar track/thumb on the home page only —
           matches the reference's app-like slideshow feel. Scroll itself
           still works exactly as before (wheel, touch, keyboard, and the
           snap script's own scrollTo calls); this only removes the
           rendered UI chrome, which also means dragging the scrollbar
           thumb specifically is no longer possible, same as the reference. */
        html:has(body.template-index) {
          scrollbar-width: none;
          -ms-overflow-style: none;
        }
        html:has(body.template-index)::-webkit-scrollbar {
          display: none;
        }

        /* While a section turn is being dragged with the mouse: no text selection, closed-hand cursor. The
           class is on <html> only during the drag. Images and links are not draggable on the home, so the
           browser's own drag ghost never takes the gesture over. */
        html.home-dragging,
        html.home-dragging * {
          -webkit-user-select: none !important;
          user-select: none !important;
          cursor: grabbing !important;
        }
        body.template-index img,
        body.template-index a {
          -webkit-user-drag: none;
        }

        /* Section indicator (created by the home script): number, a tick and a hairline at the bottom edge.
           Its colour follows the section under it (white over photos). Above the sections, below the header. */
        .home-indicator {
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 499;
          display: flex;
          flex-direction: column;
          align-items: center;
          padding-bottom: env(safe-area-inset-bottom, 0px);
          color: #111111;
          pointer-events: none;
          transition: opacity 0.3s ease, color 0.3s ease;
        }
        .home-indicator--light {
          color: #ffffff;
        }
        .home-indicator.is-hidden,
        body[data-fluorescent-overlay-open="true"] .home-indicator {
          opacity: 0;
        }
        .home-indicator__count {
          display: block;
          font-family: var(--font-body);
          font-size: 11px;
          font-weight: 400;
          line-height: 1;
          letter-spacing: 0.06em;
          font-variant-numeric: tabular-nums;
        }
        .home-indicator__tick {
          display: block;
          width: 1px;
          height: 14px;
          margin-top: 7px;
          background: currentColor;
        }
        .home-indicator::after {
          content: "";
          display: block;
          width: 100%;
          height: 1px;
          background: currentColor;
        }

        /* Scroll-UP page turn only (animateReverseCover adds/removes
           .snap-reverse on <html>). The header's upper row eases its
           margin-bottom over 0.2s (theme.css) to smooth the sticky flip
           while scrolling normally, where the sticky top offset changes a
           pixel at a time. A reverse page turn moves the real scroll to the
           top in ONE frame instead, so that offset (-12px -> 0) flips
           instantly while the margin still glides: the icons dropped 12px
           and eased back up over ~150ms. With the transition off for the
           duration of the turn both change in the same frame and cancel
           out. */
        html.snap-reverse header[data-navigation-position="left"][data-logo-position="center"] .header__row.header__row-desktop.upper {
          transition: none !important;
        }
      </style>
      <script>
        /* Home page section snap — hand-rolled instead of native CSS
           scroll-snap. Native "mandatory" reliably locked the page unable
           to scroll past the first section (confirmed even after simplifying
           to two plain, non-sticky 100vh sections, so it isn't just the old
           sticky/curtain setup at fault); "proximity" didn't lock but felt
           weak/inconsistent.

           This intercepts wheel/touch input directly (preventDefault, so native
           scrolling never runs at all) instead of letting the browser scroll
           freely and correcting afterwards — a strong flick under the old
           "correct after the fact" approach could carry native scroll across
           more than one section before the correction even ran. Intercepting
           the gesture up front guarantees exactly one section per gesture,
           every time, regardless of how hard or fast it was.

           Runs on every input type (wheel, trackpad, touch) and on every
           viewport width — an earlier version gated touch behind a desktop
           media query, which meant phones got plain free scroll with no
           snap at all. prefers-reduced-motion no longer disables the feature
           outright either: sections still land exactly on-screen, just via
           an instant jump instead of the animated glide, since a "half
           landed" section is a worse experience than a shorter animation. */
        (function () {
          function init() {
            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            var sections = Array.prototype.slice.call(document.querySelectorAll('#main > .shopify-section'));

            var DURATION_MS = 580; // full, deliberate section-to-section travel time — slow enough to read the incoming section sliding up and covering the previous one as an intentional "page turn," not so slow it drags. Raised twice on request for a smoother, less rushed feel (420 -> 500 -> 580); revisit if this starts reading as sluggish the way 560 once did at a slightly shorter length.
            // A trackpad flick keeps emitting decaying "momentum" wheel events
            // for a while after the fingers actually lift — well past when the
            // animation itself finishes. If the input lock released the
            // moment the animation ended, a strong flick's leftover momentum
            // ticks would arrive as a "new" gesture and fire a second,
            // unintended jump. COOLDOWN_MS is measured from the START of the
            // gesture (not the animation's end) and is deliberately longer
            // than the animation so a comfortable quiet buffer always follows
            // landing before new input is accepted again.
            var COOLDOWN_MS = 730;
            // Keyboard gets its own, much shorter cooldown: a keydown is one
            // discrete event with no trailing "momentum" to guard against
            // (unlike a wheel/trackpad gesture), so gating it behind the same
            // long buffer meant for that just made repeated ArrowDown presses
            // feel unresponsive — a press landing inside that window was
            // silently dropped, needing 2-3 presses to actually move. This
            // only needs to outlast the animation itself, plus a small buffer
            // so a fast key-repeat can't fire a second jump mid-animation.
            var KEYBOARD_COOLDOWN_MS = DURATION_MS + 90;
            var TOUCH_THRESHOLD = 40; // px of vertical drag before a touchmove counts as "swipe to the next section"

            var locked = false;
            var lockTimeout = null;
            var raf = null;
            var currentIndex = 0;
            // A keydown that arrives while locked (an animation is still
            // playing) used to just be silently dropped — the exact "I
            // pressed ArrowDown and nothing happened, had to press it again"
            // complaint this exists to fix. Wheel/touch still drop input
            // outright while locked (that lock is there specifically to
            // absorb decaying trackpad momentum, which must NOT queue up
            // and fire again), but a keydown is a single deliberate action
            // with nothing to protect against — remembering just the LATEST
            // one (not a growing queue, so mashing the key repeatedly can't
            // queue up a runaway string of jumps) and firing it the instant
            // the lock clears means even a press that lands mid-animation
            // still takes effect on its own, with no re-press needed.
            var pendingKeyDir = null;

            // Every full-screen drawer/modal in this theme (the sandwich
            // menu, quick-search, cart, filters, quick-view, etc.) sets this
            // attribute while open, regardless of which one it is — these
            // wheel/touch/keydown listeners live on window, not scoped to
            // any particular element, so without this check, scrolling or
            // swiping while one of those is open still drove THIS page's own
            // section-to-section snap underneath it: the transform-based
            // cover effect (see animateScrollTo/animateReverseCover) doesn't
            // care whether the visible drawer is dimming or covering it, so
            // whatever section got scrolled to would flash through.
            function isOverlayOpen() {
              return document.body.getAttribute('data-fluorescent-overlay-open') === 'true';
            }

            // A horizontally-scrollable component nested inside one of
            // these full-height sections (e.g. the collections slider on
            // mobile) needs native touch-scroll for its own left/right
            // swipe. TOUCH_THRESHOLD (below) already ignores small vertical
            // wobble during a swipe, but a real finger dragging mostly
            // sideways still often drifts past it — without this check
            // that wobble got read as "swipe to next/prev section" and
            // hijacked the gesture (e.preventDefault(), goTo()) right out
            // from under the component's own horizontal scroll, killing it
            // mid-drag. Elements opt in via [data-horizontal-scroll] rather
            // than this file naming any component's class directly.
            function isInsideHorizontalScroll(target) {
              return !!(target && target.closest && target.closest('[data-horizontal-scroll]'));
            }

            // The section being scrolled TO always needs the highest
            // z-index so it covers whatever was on screen before it, in
            // EITHER scroll direction. A one-time z-index assigned by
            // document order only covers the forward direction correctly —
            // scrolling back to an earlier section left it with a LOWER
            // z-index than the one ahead of it, so it could never re-cover
            // that later section. zCounter always holds the highest z-index
            // handed out so far; every navigation bumps it and gives it to
            // the section being entered, regardless of direction.
            var zCounter = sections.length;
            sections.forEach(function (el, i) {
              el.style.zIndex = i + 1;
            });

            // Shopify's theme editor re-renders sections over AJAX when the
            // merchant adds/removes/reorders one on this page, which wouldn't
            // touch this already-captured list — refresh it on that event so a
            // section edited live doesn't leave the snap targeting stale tops.
            document.addEventListener('shopify:section:load', refreshSections);
            document.addEventListener('shopify:section:unload', refreshSections);
            function refreshSections() {
              sections = Array.prototype.slice.call(document.querySelectorAll('#main > .shopify-section'));
              zCounter = sections.length;
              sections.forEach(function (el, i) {
                el.style.zIndex = i + 1;
              });
              refreshStopsCache();
              syncCurrentIndex();
            }

            // Returns one stop per screen-worth of content, not one per
            // section — a section that renders taller than one viewport
            // (e.g. image-hero-split stacks its two images full-height on
            // mobile, so the section itself is ~2 screens tall there) is
            // split into that many evenly-spaced stops, so a swipe lands on
            // each stacked image in turn instead of jumping straight over
            // the second one to whatever comes after the section. Each stop
            // also carries the section element it belongs to, so a jump can
            // bump that section's z-index (see zCounter above) regardless of
            // which of its stops was the actual target.
            //
            // computeStopsFresh() does the real offsetTop/offsetHeight
            // reads; stops() itself just returns a cache of that, refreshed
            // by refreshStopsCache() below. This used to read live on every
            // call ("no reason not to stay self-correcting against a late-
            // loading image" — true, but that only needs checking once
            // things settle, not on every call) — except every call
            // included onWheel and onTouchMove firing on every single
            // native wheel/touchmove event during an ordinary scroll
            // gesture, each one forcing a fresh synchronous layout read of
            // EVERY section, with no throttling at all. On this page's
            // handful of full-bleed image sections that was enough
            // continuous main-thread work during a fast scroll to visibly
            // tear/glitch the screen. The one place that still legitimately
            // wants a guaranteed-fresh read (the "did a late-loading image
            // shift the layout while that animation was mid-flight"
            // correction once a snap-jump lands) calls
            // refreshStopsCache() right before reading instead of trusting
            // a value that might be a frame stale.
            // For an overtall section split into multiple stops (see count
            // below), a plain stop-to-stop move used to fall back to a bare
            // scroll with no cover/freeze effect at all — goTo()'s
            // crossesSection check compares outgoingEl !== enteringEl, and
            // every stop of the SAME section shared that section as its
            // el, so consecutive stops there could never "cross" anything.
            // Reported directly: image-hero-split's two stacked mobile
            // images (a real case of this) read as "passing straight
            // through" with none of the page-turn feel every other jump
            // on this page has. Finds whichever descendant occupies that
            // ONE stop's own vertical slice — geometrically, not by name,
            // so this isn't tied to image-hero-split's own class names and
            // keeps working for any future section built the same way.
            //
            // Each stop below carries BOTH this descendant (el) AND its
            // top-level .shopify-section (sectionEl), because they answer
            // two different questions and using the wrong one for either
            // is a real, confirmed bug, not just a style choice:
            //   - Moving between two stops of the SAME section (this one
            //     was built for): el is the right thing to bump/freeze —
            //     both stops' descendants already share one stacking
            //     context (siblings inside the section), so their z-index
            //     is directly comparable to each other.
            //   - Moving between a stop here and a stop in a DIFFERENT
            //     section (an ordinary cross-section jump that happens to
            //     land on stop 0 of an overtall section, or leave from its
            //     last stop): the section itself has to be what's bumped/
            //     frozen. Bumping just the descendant's z-index doesn't
            //     escape its own section's stacking context — the section
            //     element itself was untouched, so it stayed sitting
            //     behind whatever the outgoing section's own z-index
            //     already was, and the "entering" descendant's higher
            //     z-index only won against ITS OWN siblings, not the
            //     actual section it needed to cover. Confirmed live: the
            //     slider section stayed visible on top through the entire
            //     transition into this one.
            function findStopElement(sectionEl, index, vh, sectionTop) {
              var targetTop = sectionTop + index * vh;
              var candidates = sectionEl.querySelectorAll("*");
              for (var i = 0; i < candidates.length; i++) {
                var node = candidates[i];
                var rect = node.getBoundingClientRect();
                if (Math.abs(rect.height - vh) <= 2 && Math.abs(rect.top + window.scrollY - targetTop) <= 2) {
                  return node;
                }
              }
              return null;
            }
            function computeStopsFresh() {
              var vh = window.innerHeight;
              var out = [];
              sections.forEach(function (el) {
                // Read each section's own transparent-header opt-in(s)
                // here — once per cache refresh — instead of querying for
                // it from inside the scroll handler on every frame.
                var flagEl = el.querySelector('[data-transparent-header]');
                var transparent = !!(flagEl && flagEl.getAttribute('data-transparent-header') === 'true');
                var dark = !!(flagEl && flagEl.getAttribute('data-transparent-header-dark') === 'true');
                var count = Math.max(1, Math.round(el.offsetHeight / vh));
                var sectionTop = el.offsetTop;
                for (var i = 0; i < count; i++) {
                  var stopEl = el;
                  if (count > 1) {
                    var found = findStopElement(el, i, vh, sectionTop);
                    if (found) stopEl = found;
                  }
                  out.push({ top: sectionTop + i * vh, el: stopEl, sectionEl: el, transparent: transparent, dark: dark });
                }
              });

              // One more stop for the footer's own full reveal (position:
              // sticky; top: 100vh in its CSS) — without this, crossing
              // from the last real section on into the footer had no snap
              // target at all, so it just got handed off to raw, unassisted
              // native scroll: no eased motion, none of the "page turn"
              // feel every other transition on this page has.
              //
              // el is the sticky <footer>.footer__parent wrapper itself
              // (a real sibling of #main, not one of the .shopify-section
              // children walked above) — NOT null. It used to be null on
              // the theory that the footer's own sticky positioning
              // already provides the "cover" visual for free, so goTo()
              // wouldn't need to freeze/z-index-bump anything for it. That
              // was wrong in practice: without a z-index bump, the footer
              // sits at a lower stacking order than #main (see #main's own
              // z-index in theme.css) and — worse — freezing the OUTGOING
              // section while entering it (which every other crossing
              // does) makes that frozen section paint as if it still fills
              // the whole viewport for the entire animation, since a
              // transform doesn't change what a transform doesn't move
              // out of the way. With nothing else stacked above it, the
              // footer stayed completely hidden behind that frozen section
              // until the animation's very last frame, when it popped into
              // place all at once — the "instant/direct" jump this was
              // reported as, in both directions. Giving it a real el here
              // lets it go through the exact same forward (z-index bump,
              // no freeze — its own sticky position already slides it into
              // view over the frozen outgoing section once bumped above
              // it) and backward (reverse-cover, retreating the same way
              // every other backward crossing does) paths as any other
              // section, with no special-casing needed in goTo() at all.
              //
              // Only added when the footer actually needs its own
              // dedicated scroll room beyond the last section's stop — if
              // it doesn't (a very short footer), the last section's own
              // stop already sits at effectively the same position, and
              // skipping the duplicate stop keeps that boundary case
              // simple instead of adding a stop 1-2px away from the one
              // right before it. (One stop regardless of the footer's own
              // height, even if it's taller than one screen — the footer
              // isn't split into multiple stops the way an overtall
              // section is above.)
              // The footer has its own "Header transparente sobre esta
              // sección"/"Logo negro" opt-in too, same as every other
              // section here — but the flag lives on a DIV nested inside
              // this <footer> wrapper (footer-group's own section markup),
              // not on the wrapper itself, so it still needs its own
              // explicit lookup rather than reusing footerStickyEl below.
              var footerStickyEl = document.querySelector('.shopify-section.footer__parent');
              var footerFlagEl = document.querySelector('[data-section-type="footer"]');
              var footerTransparent = !!(footerFlagEl && footerFlagEl.getAttribute('data-transparent-header') === 'true');
              var footerDark = !!(footerFlagEl && footerFlagEl.getAttribute('data-transparent-header-dark') === 'true');
              var maxScrollY = document.documentElement.scrollHeight - vh;
              if (out.length === 0 || maxScrollY > out[out.length - 1].top + 2) {
                out.push({ top: maxScrollY, el: footerStickyEl, sectionEl: footerStickyEl, transparent: footerTransparent, dark: footerDark });
              }
              return out;
            }

            var cachedStops = [];
            function refreshStopsCache() {
              cachedStops = computeStopsFresh();
            }
            function stops() {
              return cachedStops;
            }

            function sectionTops() {
              return stops().map(function (s) { return s.top; });
            }

            function syncCurrentIndex() {
              var tops = sectionTops();
              var y = window.scrollY;
              var idx = 0;
              for (var i = 0; i < tops.length; i++) {
                if (tops[i] <= y + 1) idx = i;
              }
              currentIndex = idx;
            }
            refreshStopsCache();
            syncCurrentIndex();
            window.addEventListener('resize', function () {
              refreshStopsCache();
              syncCurrentIndex();
            });
            // Late-loading images (or fonts) can still change section
            // heights after this script first runs — one more refresh once
            // everything has actually finished loading covers that without
            // needing to keep re-measuring on every scroll/wheel event.
            window.addEventListener('load', refreshStopsCache);

            // Per-section transparent header: each section on this page
            // renders its own data-transparent-header="true"/"false"
            // attribute (from that section's own "Header transparente
            // sobre esta sección" setting). Whichever section currently
            // fills the top of the viewport decides the header's
            // transparency, so this reads scroll position directly instead
            // of piggybacking on currentIndex/goTo — it needs to stay
            // correct during raw native scroll (inside an overtall
            // section, or past the last stop) just as much as during an
            // animated snap jump, and a plain scroll listener covers both
            // without caring which one is currently happening. stops() is
            // the cached version (see above), so this reads it as often as
            // it likes without forcing layout.
            // Deliberately NOT touching body's own "header-transparent"
            // class from this feature — that one is set once, statically,
            // by header.liquid's inline script from the template-level
            // settings, and the hero-logo-scale feature (theme.js) reads
            // it exactly once at load to decide whether to activate at
            // all; the CSS for the big hero logo's collapse/expand is
            // ALSO scoped under body.header-transparent staying present
            // for the whole page. Toggling it off mid-scroll (an earlier
            // version of this code) silently broke that unrelated
            // feature's CSS scoping, leaving both the collapsed and
            // expanded logo visible at once — this only ever drives
