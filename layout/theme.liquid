            // one — the mouse's version of the swipe above. It uses the same pieces as the finger does: the same
            // 40px threshold, the same axis lock (a mostly-sideways drag is left to the sliders), the same target
            // and the same cooldown, and one turn per press. Only a real mouse (pointerType 'mouse'); fingers keep
            // using the touch handlers. Past the last section, dragging up scrolls on into the footer.
            var mouseStartX = null;
            var mouseStartY = null;
            var mouseAxis = null;
            var mouseDragging = false;
            var mouseGestureHandled = false;
            var suppressNextClick = false;

            function endMouseDrag() {
              if (mouseDragging) {
                // The click that follows the release belongs to the drag, not to whatever is under the pointer
                suppressNextClick = true;
                setTimeout(function () { suppressNextClick = false; }, 60);
              }
              mouseStartX = null;
              mouseStartY = null;
              mouseAxis = null;
              mouseDragging = false;
              mouseGestureHandled = false;
              document.documentElement.classList.remove('home-dragging');
            }

            function onPointerDown(e) {
              if (e.pointerType !== 'mouse' || e.button !== 0) return;
              if (stops().length < 2 || isOverlayOpen()) return;
              // Fields and widgets that use the drag themselves
              if (e.target && e.target.closest && e.target.closest('input, textarea, select, option, video[controls], [contenteditable="true"], .pswp')) return;

              mouseStartX = e.clientX;
              mouseStartY = e.clientY;
              mouseAxis = null;
              mouseDragging = false;
              mouseGestureHandled = false;
            }

            function onPointerMove(e) {
              if (mouseStartY === null || e.pointerType !== 'mouse') return;
              // Released outside the window: the button is no longer down
              if ((e.buttons & 1) === 0) { endMouseDrag(); return; }
              if (isOverlayOpen()) return;

              var dx = mouseStartX - e.clientX;
              var dy = mouseStartY - e.clientY;

              if (mouseAxis === null && (Math.abs(dx) >= AXIS_LOCK_PX || Math.abs(dy) >= AXIS_LOCK_PX)) {
                mouseAxis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
              }
              // Undecided, or sideways: not ours (a slider drags itself)
              if (mouseAxis !== 'y') return;

              if (!mouseDragging) {
                mouseDragging = true;
                document.documentElement.classList.add('home-dragging');
                // The press may have started selecting text before the axis was known
                var selection = window.getSelection && window.getSelection();
                if (selection && selection.removeAllRanges) selection.removeAllRanges();
              }

              if (Math.abs(dy) <= TOUCH_THRESHOLD) return;
              if (locked || mouseGestureHandled) return;

              syncCurrentIndex();
              var target = targetIndexForDirection(dy > 0 ? 1 : -1, sectionTops());
              mouseGestureHandled = true;

              if (target !== null) {
                goTo(target);
              } else if (dy > 0) {
                // Past the last section: on into the footer, as the wheel and the keys do natively
                window.scrollBy({ top: Math.round(window.innerHeight * 0.8), left: 0, behavior: 'smooth' });
              }
              mouseStartY = e.clientY;
            }

            window.addEventListener('pointerdown', onPointerDown, { passive: true });
            window.addEventListener('pointermove', onPointerMove, { passive: true });
            window.addEventListener('pointerup', endMouseDrag, { passive: true });
            window.addEventListener('pointercancel', endMouseDrag, { passive: true });
            window.addEventListener('blur', endMouseDrag);
            // A native image or link drag would take the gesture away from us
            window.addEventListener('dragstart', function (e) {
              if (mouseStartY !== null) e.preventDefault();
            });
            window.addEventListener('click', function (e) {
              if (!suppressNextClick) return;
              suppressNextClick = false;
              e.preventDefault();
              e.stopPropagation();
            }, true);

            // Section indicator: "2 / 5" at the bottom centre of the screen, a small tick under it and a hairline
            // along the bottom edge, telling which section of the home is on screen. The total counts the sections
            // (not the footer's own stop). White over the photo sections, black over the light ones; it fades out in
            // the footer and while a menu or drawer is open. It only reads what the script above already knows.
            var indicator = document.createElement('div');
            indicator.className = 'home-indicator is-hidden';
            indicator.setAttribute('aria-hidden', 'true');
            indicator.innerHTML = '<span class="home-indicator__count"></span><span class="home-indicator__tick"></span>';
            document.body.appendChild(indicator);
            var indicatorCount = indicator.firstChild;
            var indicatorFrame = 0;

            function updateIndicator() {
              indicatorFrame = 0;
              var list = stops();
              var footerStop = list.length > 1 && list[list.length - 1].el && list[list.length - 1].el === document.querySelector('.shopify-section.footer__parent');
              var total = footerStop ? list.length - 1 : list.length;
              if (total < 2) { indicator.classList.add('is-hidden'); return; }

              // The stop nearest to where the page really is (not the script's own currentIndex, which can be a step
              // behind while a turn is running on some devices)
              var tops = sectionTops();
              var y = window.scrollY;
              var index = 0;
              for (var i = 1; i < tops.length; i++) {
                if (Math.abs(tops[i] - y) < Math.abs(tops[index] - y)) index = i;
              }

              // Not shown over the first section (which still counts: the second one reads "2 / N"), nor in the footer
              if (index === 0 || index >= total) { indicator.classList.add('is-hidden'); return; }

              var text = (index + 1) + ' / ' + total;
              if (indicatorCount.textContent !== text) indicatorCount.textContent = text;

              var sectionEl = list[index] && (list[index].sectionEl || list[index].el);
              var light = !!(sectionEl && sectionEl.querySelector && sectionEl.querySelector('.image-hero, .image-hero-split, .video-hero, .slideshow, [data-indicator-tone="light"]'));
              indicator.classList.toggle('home-indicator--light', light);
              indicator.classList.remove('is-hidden');
            }

            function scheduleIndicator() {
              if (!indicatorFrame) indicatorFrame = window.requestAnimationFrame(updateIndicator);
            }

            var indicatorTimer = null;
            window.addEventListener('scroll', function () {
              scheduleIndicator();
              // And once more when the scrolling has stopped, so the last position is always shown
              clearTimeout(indicatorTimer);
              indicatorTimer = setTimeout(scheduleIndicator, 180);
            }, { passive: true });
            window.addEventListener('resize', scheduleIndicator);
            window.addEventListener('load', scheduleIndicator);
            document.addEventListener('shopify:section:load', function () { setTimeout(scheduleIndicator, 50); });
            document.addEventListener('shopify:section:unload', function () { setTimeout(scheduleIndicator, 50); });
            scheduleIndicator();
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
          } else {
            init();
          }
        })();
      </script>
    {%- endif -%}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <div class="page">
      {% if settings.enable_page_transitions %}
        {% render 'page-transition-overlay' %}
      {% endif %}

      <div class="theme-editor-scroll-offset"></div>

      <div class="header__space" data-header-space></div>

      {%- comment -%}
        The home page's sections use h2-h6 for their headings, so the page had no h1 at all. This one is
        invisible and gives search engines and screen readers the page's main title.
      {%- endcomment -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="visually-hidden">
          {{- shop.name }} &ndash;
          {%- if request.locale.iso_code == 'es' %} Joyería peruana en oro y plata{% else %} Peruvian jewelry in gold and silver{% endif -%}
        </h1>
      {%- endif -%}

      {% sections 'header-group' %}
      {% sections 'overlay-group' %}

      {%- if settings.enable_quick_search -%}
        {% capture quick_search_suggestions_html %}{% sections 'search-suggestions-group' %}{% endcapture %}
        {% render 'quick-search', suggestions_html: quick_search_suggestions_html %}
      {%- endif -%}

      <div class="header-overlay" data-header-overlay>
        <div class="header-overlay__inner"></div>
      </div>

      <main id="main" class="main">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}

      {% render 'store-availability-drawer' %}
      {% render 'quick-view-modal' %}
      {% render 'modal' %}
      {% render 'back-to-top' %}
    </div>

    {% # theme-check-disable ParserBlockingScript %}
    {{ '//www.youtube.com/iframe_api' | script_tag }}
    {% # theme-check-enable ParserBlockingScript %}
    {{ '//cdn.shopify.com/shopifycloud/shopify-plyr/v1.0/shopify-plyr.css' | stylesheet_tag }}

    {%- comment -%}
      Smooth wheel scrolling on desktop (mouse or trackpad on a wide window). Off on touch devices, with reduced
      motion, on the home page and in the theme editor. See the header of assets/smooth-scroll.js.
    {%- endcomment -%}
    <script src="{{ 'smooth-scroll.js' | asset_url }}" defer></script>
  </body>
  <link
    rel="preload"
    fetchpriority="low"
    href="{{ 'theme-deferred.css' | asset_url }}"
    as="style"
    onload="this.onload=null;this.rel='stylesheet'"
  >
  <noscript><link rel="stylesheet" href="{{ 'theme-deferred.css' | asset_url }}"></noscript>
</html>
