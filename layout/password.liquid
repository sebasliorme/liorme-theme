<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_button }}">
    {% render 'meta-description' %}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 16, height: 16 }}" type="image/png">
      <link rel="icon" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
      <link rel="icon" sizes="48x48" href="{{ settings.favicon | image_url: width: 48, height: 48 }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}" type="image/png">
      <link
        rel="apple-touch-icon"
        sizes="152x152"
        href="{{ settings.favicon | image_url: width: 152, height: 152 }}"
        type="image/png"
      >
      <link
        rel="apple-touch-icon"
        sizes="167x167"
        href="{{ settings.favicon | image_url: width: 167, height: 167 }}"
        type="image/png"
      >
      <link
        rel="apple-touch-icon"
        sizes="180x180"
        href="{{ settings.favicon | image_url: width: 180, height: 180 }}"
        type="image/png"
      >
    {%- endif -%}

    <title>
      {{ shop.name }}
      &ndash;
      {{ 'general.password_page.opening_soon' | t }}
    </title>

    {% render 'theme-setup' %}
    {% render 'theme-setting-vars' %}
    {%- render 'theme-globals' -%}

    {% render 'social-meta-tags' %}

    {{ content_for_header }}
    {{ 'template-password.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-password">
    {% if settings.enable_page_transitions %}
      {% render 'page-transition-overlay' %}
    {% endif %}

    <div class="theme-editor-scroll-offset"></div>

    <div class="page">
      {% section 'password-header' %}
      <main id="main" class="main">
        {{ content_for_layout }}
      </main>

      {% render 'modal' %}
      {% render 'store-availability-drawer' %}
      {% render 'flash-alert' %}
    </div>
  </body>
</html>
