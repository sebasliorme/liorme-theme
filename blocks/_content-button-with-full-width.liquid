{% render 'button-block',
  link: block.settings.link,
  label: block.settings.link_text,
  button_style: block.settings.button_style,
  button_size_class: block.settings.button_size,
  is_full: block.settings.enable_full_width,
  wrapper_class: 'section-blocks__button',
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:blocks.content._button.name",
  "tag": null,
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "t:shared.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:shared.settings.button_link_text.label",
      "default": "t:blocks.content._button.settings.link_text.default"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:shared.settings.button_style.label",
      "options": [
        {
          "value": "btn--primary",
          "label": "t:shared.settings.button_style.options.solid"
        },
        {
          "value": "btn--secondary",
          "label": "t:shared.settings.button_style.options.outline"
        },
        {
          "value": "btn--callout",
          "label": "t:shared.settings.button_style.options.text"
        }
      ],
      "default": "btn--primary"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:shared.settings.button_size.label",
      "options": [
        {
          "value": "btn--x-small",
          "label": "t:shared.settings.button_size.options.xs"
        },
        {
          "value": "btn--small",
          "label": "t:shared.settings.button_size.options.s"
        },
        {
          "value": "btn--medium",
          "label": "t:shared.settings.button_size.options.m"
        },
        {
          "value": "btn--large",
          "label": "t:shared.settings.button_size.options.l"
        }
      ],
      "default": "btn--small",
      "visible_if": "{{ block.settings.button_style != 'btn--callout' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width",
      "label": "t:blocks.content._button.settings.full_width.label",
      "default": false,
      "visible_if": "{{ block.settings.button_style != 'btn--callout' }}"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:blocks.content._button.presets.name",
      "blocks": []
    }
  ]
}
{% endschema %}
