{% # whitespace: normal %}
{%- capture block_content -%}
  {% render 'image-block',
    image: block.settings.image,
    width: block.settings.image_size_desktop,
    mobile_width: block.settings.image_size_mobile,
    break_to_mobile_at: '720',
    enable_corner_rounding: block.settings.enable_corner_rounding,
    wrapper_class: 'scrolling-content__image',
    shopify_attributes: block.shopify_attributes
  %}
{%- endcapture -%}

{% assign aria_label = block.settings.image.alt %}

{%- render 'scrolling-content-item-wrapper',
  block_content: block_content,
  link: block.settings.link,
  aria_label: aria_label
-%}

{% schema %}
{
  "name": "t:blocks.scrolling_content._image.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks.scrolling_content._image.settings.image.label"
    },
    {
      "type": "range",
      "id": "image_size_desktop",
      "label": "t:blocks.scrolling_content._image.settings.image_size.label",
      "min": 50,
      "max": 750,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "image_size_mobile",
      "label": "t:blocks.scrolling_content._image.settings.image_size_mobile.label",
      "min": 50,
      "max": 350,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "enable_corner_rounding",
      "label": "t:shared.settings.enable_corner_rounding.label",
      "default": true,
      "info": "t:shared.settings.enable_corner_rounding.info"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.scrolling_content._image.settings.image_link.label"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:blocks.scrolling_content._image.presets.name",
      "blocks": []
    }
  ]
}
{% endschema %}
