{% # whitespace: normal %}
{%- capture block_content -%}
  {%- render 'icon-block',
    icon: block.settings.icon,
    custom_icon: block.settings.custom_icon_image,
    width: block.settings.icon_width_desktop,
    mobile_width: block.settings.icon_width_mobile,
    enable_corner_rounding: block.settings.enable_corner_rounding,
    shopify_attributes: block.shopify_attributes
  -%}
{%- endcapture -%}

{% liquid
  if block.settings.custom_icon_image != blank
    assign aria_label = block.settings.custom_icon_image.alt
  else
    assign aria_label = block.settings.icon
  endif
%}

{%- render 'scrolling-content-item-wrapper',
  block_content: block_content,
  link: block.settings.link,
  aria_label: aria_label
-%}

