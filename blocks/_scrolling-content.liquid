{% # whitespace: normal %}
{%- capture block_content -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{%- render 'scrolling-content',
  block_content: block_content,
  scroll_duration: block.settings.scrolling_effect_duration,
  scroll_direction: block.settings.scrolling_effect_direction,
  gap: block.settings.layout_gap,
  padding_top: block.settings.layout_padding_top,
  padding_bottom: block.settings.layout_padding_bottom,
  text_font_choice: block.settings.text_font_choice,
  text_size_var_desktop: block.settings.text_size_desktop,
  text_size_var_mobile: block.settings.text_size_mobile,
  shopify_attributes: block.shopify_attributes
-%}

